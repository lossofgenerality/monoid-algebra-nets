                    RowBox[{"net", "[", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Input\>\"", " ", "->", " ", "in"}], ",", " ", 
                    RowBox[{"\"\<Target\>\"", " ", "->", " ", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"b", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "1"}], 
                    "]"}]}]}], "|>"}], "]"}], "[", "\"\<Probabilities\>\"", 
                    "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\n", "        ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"b", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "j"}], "]"}], ",",
                     " ", 
                    RowBox[{
                    RowBox[{"b", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"Log", "[", 
                    RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "12"}]}]}], "]"}]}]}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", 
                    RowBox[{"Ordering", "[", 
                    RowBox[{"p", ",", " ", 
                    RowBox[{"-", "k"}]}], "]"}]}], "}"}]}], "]"}]}]}], "]"}], 
               " ", "/@", " ", "beams"}], ",", " ", "1"}], "]"}]}], ";", "\n",
            "    ", 
           RowBox[{"cand", " ", "=", " ", 
            RowBox[{"Take", "[", 
             RowBox[{
              RowBox[{"SortBy", "[", 
               RowBox[{"cand", ",", " ", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}], ",",
               " ", 
              RowBox[{"UpTo", "[", "k", "]"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"done", " ", "=", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"done", ",", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"cand", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Last", "[", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "==", " ", 
                  "2"}], " ", "&"}]}], "]"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"beams", " ", "=", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"cand", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "!=", " ", "2"}]
                , " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"beams", " ", "===", " ", 
               RowBox[{"{", "}"}]}], " ", "||", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "done", "]"}], " ", ">=", " ", "k"}], 
                " ", "&&", " ", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"score", " ", "/@", " ", "done"}], "]"}], " ", ">=",
                  " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"score", " ", "/@", " ", "beams"}], "]"}]}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Length", "[", "in", "]"}], " ", "+", " ", "50"}], 
           "}"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"best", " ", "=", " ", 
            RowBox[{"First", "[", 
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{"done", ",", " ", "beams"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"score", "[", "#", "]"}]}], " ", "&"}]}], "]"}], 
             "]"}]}], "}"}], ",", " ", 
          RowBox[{"tfVocab", "[", 
           RowBox[{"[", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"Rest", "[", 
               RowBox[{"best", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", "2"}], "]"}],
             "]"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tfAccuracy", "[", 
      RowBox[{"net_", ",", " ", "pairs_List", ",", " ", "k_Integer"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"N", "@", 
      RowBox[{"Mean", "@", 
       RowBox[{"Boole", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"tfBeam", "[", 
             RowBox[{"net", ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", "k"}], "]"}], " ", "===",
             " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", "&"}], " ", "/@", 
         " ", "pairs"}], "]"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]", " ", "the", " ", "demo", " ", 
     "\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tfDemo", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"train", ",", " ", "test", ",", " ", "net"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "   ", 
        RowBox[{"tfLogCells", " ", "=", " ", 
         RowBox[{"{", "}"}]}], ";", "\n", "   ", 
        RowBox[{"tfLog", "[", 
         RowBox[{"\"\<Paper model, base (tfPaperConfig): parameters counted, \
not trained\>\"", ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Config\>\"", " ", "->", " ", "tfPaperConfig"}], ",", 
            " ", 
            RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
             RowBox[{"tfParameterCount", "[", "tfPaperConfig", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<PaperReports\>\"", " ", "->", " ", "\"\<65M\>\""}]}],
            "|>"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"tfLog", "[", 
         RowBox[{"\"\<Demo model (tfDemoConfig)\>\"", ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Config\>\"", " ", "->", " ", "tfDemoConfig"}], ",", 
            " ", 
            RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
             RowBox[{"tfParameterCount", "[", "tfDemoConfig", "]"}]}]}], 
           "|>"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"train", " ", "=", " ", 
         RowBox[{"tfData", "[", "20000", "]"}]}], ";", "\n", "   ", 
        RowBox[{"test", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"tfPair", "[", "]"}], ",", " ", "200"}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{"tfLog", "[", 
         RowBox[{"\"\<Task examples\>\"", ",", " ", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"StringRiffle", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\< \>\""}], 
                 "]"}], ",", " ", "\"\<  \[RightArrow]  \>\"", ",", " ", 
                RowBox[{"StringRiffle", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\< \>\""}], 
                 "]"}]}], "}"}], "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"test", ",", " ", "5"}], "]"}]}], "]"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"net", " ", "=", " ", 
         RowBox[{"tfTrain", "[", 
          
          RowBox[{"\"\<Transformer (demo)\>\"", ",", " ", "tfDemoConfig", ",",
            " ", "train", ",", " ", "20"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"tfLog", "[", 
         RowBox[{"\"\<Exact-match accuracy on 200 fresh examples\>\"", ",", 
          " ", 
          RowBox[{"Dataset", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Greedy\>\"", " ", "->", " ", 
              RowBox[{"tfAccuracy", "[", 
               RowBox[{"net", ",", " ", "test", ",", " ", "1"}], "]"}]}], ",",
              " ", 
             RowBox[{"\"\<Beam 4, alpha 0.6\>\"", " ", "->", " ", 
              RowBox[{"tfAccuracy", "[", 
               RowBox[{"net", ",", " ", "test", ",", " ", "4"}], "]"}]}]}], 
            "|>"}], "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"tfLog", "[", 
         RowBox[{"\"\<Sample translations (beam 4)\>\"", ",", " ", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"StringRiffle", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\< \>\""}], 
                 "]"}], ",", " ", "\"\<  \[RightArrow]  \>\"", ",", " ", 
                RowBox[{"StringRiffle", "[", 
                 RowBox[{
                  RowBox[{"tfBeam", "[", 
                   RowBox[{"net", ",", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "4"}], "]"}], ",",
                   " ", "\"\< \>\""}], "]"}], ",", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"tfBeam", "[", 
                    RowBox[{"net", ",", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "4"}], "]"}], 
                   " ", "===", " ", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                  " ", "\"\<   \[Checkmark]\>\"", ",", " ", 
                  RowBox[{"\"\<   \[Times] expected \>\"", " ", "<>", " ", 
                   RowBox[{"StringRiffle", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\< \>\""}], 
                    "]"}]}]}], "]"}]}], "}"}], "]"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"Take", "[", 
             RowBox[{"test", ",", " ", "10"}], "]"}]}], "]"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"tfNet", " ", "=", " ", "net"}], ";", "\n", "   ", 
        RowBox[{"tfLogSave", "[", "]"}], ";", "\n", "   ", "Null"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"tfDemo", "[", "]"}], ";"}], "\n", "\n"}]}]], "Input",ExpressionUU\
