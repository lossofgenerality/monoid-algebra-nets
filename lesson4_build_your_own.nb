          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<heads\>\"", "]"}], "]"}], " ", "<>", 
          " ", "\"\< heads, d = \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<d\>\"", "]"}], "]"}], " ", "<>", 
          " ", "\"\<, dff = \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<dff\>\"", "]"}], "]"}], " ", "<>", 
          " ", "\"\<. Source and target share one vocabulary of \>\"", " ", "<>",
           " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "owVocab", "]"}], "]"}], " ", "<>", 
          " ", "\"\< tokens, so one array serves both embeddings and the \
output projection. The decoder reads the target without its last token \
(teacher forcing) and is trained to predict it without its first, against \
label-smoothed targets (\[Epsilon] = \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<smoothing\>\"", "]"}], "]"}], " ", "<>", 
          " ", "\"\<), with Adam (\[Beta]\:2082 = 0.98) and the warm-up \
schedule (\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<warmup\>\"", "]"}], "]"}], " ", "<>", 
          " ", "\"\< steps).\>\""}], "]"}], ";", "\n", "   ", 
        RowBox[{"model", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"owModel", "[", "s", "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"owShow", "[", 
         RowBox[{"Information", "[", 
          RowBox[{"model", ",", " ", "\"\<SummaryGraphic\>\""}], "]"}], "]"}],
         ";", "\n", "   ", 
        RowBox[{"owCheck", "[", 
         RowBox[{
          RowBox[{"\"\<the model has \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"Information", "[", 
             RowBox[{"model", ",", " ", "\"\<ArraysTotalElementCount\>\""}], 
             "]"}], "]"}], " ", "<>", 
           " ", "\"\< parameters, and one shared array of \>\"", " ", "<>", 
           " ", 
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"Length", "[", "owVocab", "]"}], " ", 
             RowBox[{"s", "[", "\"\<d\>\"", "]"}]}], "]"}], " ", "<>", 
           " ", "\"\< for the three embeddings\>\""}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"model", ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<embS\>\"", ",", " ", "\"\<Weights\>\""}], "}"}]}],
              "]"}]}], " ", "==", " ", 
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"model", ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<embT\>\"", ",", " ", "\"\<Weights\>\""}], "}"}]}],
              "]"}]}], " ", "==", " ", 
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"model", ",", " ", 
              RowBox[{"{", 
               
               RowBox[{"\"\<out\>\"", ",", " ", "\"\<Net\>\"", ",", 
                " ", "\"\<Weights\>\""}], "}"}]}], "]"}]}]}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"test", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"owPair", "[", "]"}], ",", " ", 
           RowBox[{"s", "[", "\"\<test\>\"", "]"}]}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"testKeys", " ", "=", " ", 
         RowBox[{"Union", "[", 
          RowBox[{
           RowBox[{"#Source", " ", "&"}], " ", "/@", " ", "test"}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"train", " ", "=", " ", 
         RowBox[{"{", "}"}]}], ";", "\n", "   ", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "train", "]"}], " ", "<", " ", 
           RowBox[{"s", "[", "\"\<train\>\"", "]"}]}], ",", " ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p", " ", "=", " ", 
              RowBox[{"owPair", "[", "]"}]}], "}"}], ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", " ", 
               RowBox[{"MemberQ", "[", 
                RowBox[{"testKeys", ",", " ", 
                 RowBox[{"p", "[", "\"\<Source\>\"", "]"}]}], "]"}]}], ",", 
              " ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"train", ",", " ", "p"}], "]"}]}], "]"}]}], "]"}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"owText", "[", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "train", "]"}], "]"}], " ", "<>", 
          " ", "\"\< training pairs and \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "test", "]"}], "]"}], " ", "<>", 
          " ", "\"\< test pairs; no test source appears in the training \
set.\>\""}], "]"}], ";", "\n", "   ", 
        RowBox[{"res", " ", "=", " ", 
         RowBox[{"owTrain", "[", 
          RowBox[{"s", ",", " ", "train"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"net", " ", "=", " ", 
         RowBox[{"res", "[", "\"\<TrainedNet\>\"", "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"losses", " ", "=", " ", 
         RowBox[{"res", "[", "\"\<RoundLossList\>\"", "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"owShow", "[", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{"losses", ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<round\>\"", ",", " ", "\"\<training loss\>\""}], 
             "}"}]}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"owText", "[", 
         RowBox[{"\"\<Training took \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Round", "@", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"t", " ", "=", " ", 
                RowBox[{"res", "[", "\"\<TotalTrainingTime\>\"", "]"}]}], 
               "}"}], ",", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"QuantityQ", "[", "t", "]"}], ",", " ", 
                RowBox[{"QuantityMagnitude", "[", 
                 RowBox[{"UnitConvert", "[", 
                  RowBox[{"t", ",", " ", "\"\<Seconds\>\""}], "]"}], "]"}], ",",
                 " ", "t"}], "]"}]}], "]"}]}], "]"}], " ", "<>", 
          " ", "\"\< s for \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "losses", "]"}], "]"}], " ", "<>", 
          " ", "\"\< rounds. The loss cannot reach 0: with label smoothing \
its floor is the entropy of the smoothed target.\>\""}], "]"}], ";", "\n", 
        "   ", 
        RowBox[{"owCheck", "[", 
         RowBox[{
          RowBox[{"\"\<the training loss fell by more than half (from \>\"", 
           " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"First", "[", "losses", "]"}], ",", " ", "3"}], "]"}], 
            "]"}], " ", "<>", " ", "\"\< to \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"Last", "[", "losses", "]"}], ",", " ", "3"}], "]"}], 
            "]"}], " ", "<>", " ", "\"\<)\>\""}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Last", "[", "losses", "]"}], " ", "<", " ", 
           RowBox[{
            RowBox[{"First", "[", "losses", "]"}], "/", "2"}]}]}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"owCheck", "[", 
         RowBox[{"\"\<after training, the three embeddings are still one \
shared array\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"net", ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<embS\>\"", ",", " ", "\"\<Weights\>\""}], "}"}]}],
              "]"}]}], " ", "==", " ", 
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"net", ",", " ", 
              RowBox[{"{", 
               
               RowBox[{"\"\<out\>\"", ",", " ", "\"\<Net\>\"", ",", 
                " ", "\"\<Weights\>\""}], "}"}]}], "]"}]}]}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"owSaveNets", "[", "net", "]"}], ";", "\n", "   ", 
        RowBox[{"owNet", " ", "=", " ", "net"}], ";", "\n", "   ", 
        RowBox[{"owTest", " ", "=", " ", "test"}], ";", "\n", "   ", 
        "net"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"owPart4", "[", 
      RowBox[{"net_", ",", " ", "test_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s", " ", "=", " ", "owSettings"}], ",", " ", "greedy", ",", 
         " ", "free", ",", " ", "beam", ",", " ", "row", ",", " ", "valid", ",",
          " ", "exact", ",", " ", "top1", ",", " ", "any", ",", " ", 
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Length", "[", "test", "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"owSection", "[", "\"\<4. Decoding and checking\>\"", "]"}], ";",
         "\n", "   ", 
        RowBox[{"owText", "[", 
         RowBox[{"\"\<Each test source is decoded three ways: greedy (a beam \
of width 1) with no constraint; a beam of width \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<beam\>\"", "]"}], "]"}], " ", "<>", 
          " ", "\"\< with the length penalty \[Alpha] = \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<alpha\>\"", "]"}], "]"}], " ", "<>", 
          " ", "\"\< and no constraint; and the same beam constrained by the \
prefix grammar, which allows </s> only when the tree is complete and nothing \
else then. Every answer is checked by the oracle. As in Lample and Charton, \
'any in beam' counts a source as solved if any hypothesis in the beam passes \
the check.\>\""}], "]"}], ";", "\n", "   ", 
        RowBox[{"greedy", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"owBeam", "[", 
            RowBox[{
            "net", ",", " ", "#Source", ",", " ", "1", ",", " ", "False", ",",
              " ", 
             RowBox[{"s", "[", "\"\<alpha\>\"", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "test"}]}], ";", "\n", "   ", 
        RowBox[{"free", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"owBeam", "[", 
            RowBox[{"net", ",", " ", "#Source", ",", " ", 
             RowBox[{"s", "[", "\"\<beam\>\"", "]"}], ",", " ", "False", ",", 
             " ", 
             RowBox[{"s", "[", "\"\<alpha\>\"", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "test"}]}], ";", "\n", "   ", 
        RowBox[{"beam", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"owBeam", "[", 
            RowBox[{"net", ",", " ", "#Source", ",", " ", 
             RowBox[{"s", "[", "\"\<beam\>\"", "]"}], ",", " ", "True", ",", 
             " ", 
             RowBox[{"s", "[", "\"\<alpha\>\"", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "test"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"valid", "[", "r_", "]"}], " ", ":=", " ", 
         RowBox[{"N", "@", 
          RowBox[{"Mean", "@", 
           RowBox[{"Boole", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"owParse", "[", 
                RowBox[{"First", "@", 
                 RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "=!=", " ", 
               "$Failed"}], " ", "&"}], " ", "/@", " ", "r"}], "]"}]}]}]}], ";",
         "\n", "   ", 
        RowBox[{
         RowBox[{"exact", "[", "r_", "]"}], " ", ":=", " ", 
         RowBox[{"N", "@", 
          RowBox[{"Mean", "@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Boole", "[", 
               RowBox[{
                RowBox[{"First", "@", 
                 RowBox[{"First", "[", "#1", "]"}]}], " ", "===", " ", 
                RowBox[{"#2", "[", "\"\<Target\>\"", "]"}]}], "]"}], " ", 
              "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "test"}], "}"}]}], "]"}]}]}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"top1", "[", "r_", "]"}], " ", ":=", " ", 
         RowBox[{"N", "@", 
          RowBox[{"Mean", "@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Boole", "[", 
               RowBox[{"owEquivalentQ", "[", 
                RowBox[{
                 RowBox[{"#2", "[", "\"\<Tree\>\"", "]"}], ",", " ", 
                 RowBox[{"First", "@", 
                  RowBox[{"First", "[", "#1", "]"}]}]}], "]"}], "]"}], " ", 
              "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "test"}], "}"}]}], "]"}]}]}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"any", "[", "r_", "]"}], " ", ":=", " ", 
         RowBox[{"N", "@", 
          RowBox[{"Mean", "@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Boole", "[", 
               RowBox[{"AnyTrue", "[", 
                RowBox[{
                 RowBox[{"First", " ", "/@", " ", "#1"}], ",", " ", 
                 RowBox[{"Function", "[", 
                  RowBox[{"h", ",", " ", 
                   RowBox[{"owEquivalentQ", "[", 
                    RowBox[{
                    RowBox[{"#2", "[", "\"\<Tree\>\"", "]"}], ",", " ", "h"}],
                     "]"}]}], "]"}]}], "]"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "test"}], "}"}]}], "]"}]}]}]}], ";", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"row", "[", 
          RowBox[{"name_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
         RowBox[{"{", 
          RowBox[{"name", ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"valid", "[", "r", "]"}], "]"}], ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"exact", "[", "r", "]"}], "]"}], ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"top1", "[", "r", "]"}], "]"}], ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"any", "[", "r", "]"}], "]"}]}], "}"}]}], ";", "\n", 
        "   ", 
        RowBox[{"owShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\"\<decoding (\>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "n", "]"}], " ", "<>", 
                " ", "\"\< test sources)\>\""}], ",", 
               " ", "\"\<valid prefix\>\"", ",", 
               " ", "\"\<same tokens as the oracle\>\"", ",", 
               " ", "\"\<top answer verified\>\"", ",", 
               " ", "\"\<any in beam verified\>\""}], "}"}], ",", "\n", 
             "      ", 
             RowBox[{"row", "[", 
              RowBox[{"\"\<greedy\>\"", ",", " ", "greedy"}], "]"}], ",", " ", 
             RowBox[{"row", "[", 
              RowBox[{
               RowBox[{"\"\<beam \>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", 
                 RowBox[{"s", "[", "\"\<beam\>\"", "]"}], "]"}]}], ",", " ", 
               "free"}], "]"}], ",", " ", 
             RowBox[{"row", "[", 
              RowBox[{
               RowBox[{"\"\<beam \>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", 
                 RowBox[{"s", "[", "\"\<beam\>\"", "]"}], "]"}], " ", "<>", 
                " ", "\"\< + grammar\>\""}], ",", " ", "beam"}], "]"}]}], 
            "}"}], ",", "\n", "     ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"owShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Row", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"test", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Source\>\"", 
                    "]"}], ",", " ", "\"\< \>\""}], "]"}], ",", " ", 
                 RowBox[{"Row", "[", 
                  RowBox[{
                   RowBox[{"First", "@", 
                    RowBox[{"First", "[", 
                    RowBox[{"beam", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
                   " ", "\"\< \>\""}], "]"}], ",", " ", 
                 RowBox[{"owEquivalentQ", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"test", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Tree\>\"", 
                    "]"}], ",", " ", 
                   RowBox[{"First", "@", 
                    RowBox[{"First", "[", 
                    RowBox[{"beam", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "]"}]}], "}"}],
                ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", 
                 RowBox[{"Min", "[", 
                  RowBox[{"8", ",", " ", "n"}], "]"}]}], "}"}]}], "]"}], ",", 
             "\n", "      ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<source\>\"", ",", 
               " ", "\"\<top answer (beam + grammar)\>\"", ",", 
               " ", "\"\<verified\>\""}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"owCheck", "[", 
         RowBox[{"\"\<with the grammar as a constraint every answer is a \
valid prefix tree\>\"", ",", " ", 
          RowBox[{
           RowBox[{"valid", "[", "beam", "]"}], " ", "==", " ", "1."}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"owCheck", "[", 
         RowBox[{"\"\<'any in beam' is never below 'top answer' (it counts \
the top answer too)\>\"", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"any", "[", "beam", "]"}], " ", ">=", " ", 
            RowBox[{"top1", "[", "beam", "]"}]}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"any", "[", "free", "]"}], " ", ">=", " ", 
            RowBox[{"top1", "[", "free", "]"}]}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"owResultsTable", " ", "=", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<greedy\>\"", " ", "->", " ", 
            RowBox[{"top1", "[", "greedy", "]"}]}], ",", " ", 
           RowBox[{"\"\<beam\>\"", " ", "->", " ", 
            RowBox[{"top1", "[", "free", "]"}]}], ",", " ", 
           RowBox[{"\"\<beam+grammar\>\"", " ", "->", " ", 
            RowBox[{"top1", "[", "beam", "]"}]}], ",", " ", 
           RowBox[{"\"\<beam+grammar any\>\"", " ", "->", " ", 
            RowBox[{"any", "[", "beam", "]"}]}]}], "|>"}]}], ";", "\n", "   ", 
        RowBox[{
        "owText", 
         "[", "\"\<What to try next: more training pairs or rounds \
(owSettings), a larger d, or a curriculum from short to long expressions. A \
single wrong token spoils a whole expansion, so longer targets are harder; \
the oracle shows exactly which answers are wrong.\>\"", "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "Running"}]}]}]}]}], " ", "the", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lesson", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"owRun", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Quiet", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2026", "]"}], ";", " ", 
       RowBox[{"owReset", "[", "]"}], ";", "\n", "   ", 
       RowBox[{
       "owText", 
        "[", "\"\<This lesson assembles Lessons 1\[Dash]3 on our own problem. \
Lesson 1: encoder\[Dash]decoder and beam search. Lesson 2: uniform tree \
sampling, prefix notation and verification by an exact oracle. Lesson 3: the \
transformer parts, shared embeddings, label smoothing and the warm-up \
schedule.\>\"", "]"}], ";", "\n", "   ", 
       RowBox[{"owPart1", "[", "]"}], ";", " ", 
       RowBox[{"owPart2", "[", "]"}], ";", "\n", "   ", 
       RowBox[{"owPart4", "[", 
        RowBox[{
         RowBox[{"owPart3", "[", "]"}], ",", " ", "owTest"}], "]"}], ";", 
       "\n", "   ", 
       RowBox[{
       "owSection", "[", "\"\<Where this goes in TensorNets\>\"", "]"}], ";", 
       "\n", "   ", 
       RowBox[{
       "owText", 
        "[", "\"\<tnParserNet in ff_tensornets_new.nb is this same kind of \
encoder\[Dash]decoder, mapping tokens to the prefix tree; tnPolicyNet and \
tnValueNet reuse the encoder. The difference in the release is that \
simplification is done by the policy net choosing rewrite rules, which the \
exact engine applies, so every step is sound, rather than by writing the \
whole answer at once as here.\>\"", "]"}], ";", "\n", "   ", 
       RowBox[{"owSaveLog", "[", "]"}], ";", "\n", "   ", 
       RowBox[{"owAllPassQ", " ", "=", " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Values", "[", "owResults", "]"}], ",", " ", "TrueQ"}], 
         "]"}]}], ";"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", " ", 
       RowBox[{"TrueQ", "[", "owSkipRun", "]"}]}], ",", " ", 
      RowBox[{"owRun", "[", "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",Expressi\
onUUID->"eb95e9ad-efb4-450f-81ba-988736c9693d"]
},
