matters)\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"owEquivalentQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<\:2a02\>\"", ",", " ", 
