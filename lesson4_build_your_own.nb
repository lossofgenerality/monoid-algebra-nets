        RowBox[{"owSection", "[", "\"\<2. The oracle\>\"", "]"}], ";", "\n", 
        "   ", 
        RowBox[{
        "owText", 
         "[", "\"\<An expression is a list of words, each word an ordered \
\:2a02-product of atoms. \:2a01 joins two lists; \:2a02 multiplies every word \
of the left by every word of the right, keeping their order (\:2a02 is not \
commutative). Two expressions are equal when their lists of words agree up to \
order (\:2a01 is commutative up to isomorphism). This is the check \
tnEquivalentQ makes in TensorNets.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "owFormula", 
         "[", "\"\<words(x) = {x}     words(A \:2a01 B) = words(A) \[Union] \
words(B)     words(A \:2a02 B) = { u v : u \[Element] words(A), v \[Element] \
words(B) }\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"owCheck", "[", 
         RowBox[{"\"\<(a\:2a01b)\:2a02c expands to a\:2a02c \:2a01 b\:2a02c, \
