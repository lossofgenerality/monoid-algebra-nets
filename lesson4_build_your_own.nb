         "]"}], ";", "\n", "   ", 
        RowBox[{"owText", "[", 
         RowBox[{"\"\<The encoder\[Dash]decoder of Lesson 3: shared \
embeddings multiplied by \[Sqrt]d, sinusoidal positions, \>\"", " ", "<>", 
          " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"s", "[", "\"\<layers\>\"", "]"}], "]"}], " ", "<>", 
