       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {
     TagBox[
      FormBox["4",
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {
     TagBox[
      FormBox[
       FractionBox[
        RowBox[{
         RowBox[{"2", " ", "\[FormalX]"}], "-", 
         RowBox[{"cos", "(", "\[FormalX]", ")"}]}], "\[FormalX]"],
       TraditionalForm],
      TraditionalForm,
      Editable->True]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"092e5104-eb4a-4861-beb4-478517a61cce"],

Cell["4. Making integration data: FWD, BWD and IBP", "Section",ExpressionUUID->"290eb9e4-380f-4ec9-bc57-c4a23768b76d"],

Cell["\<\
Forward (FWD): draw a function and ask a computer algebra system for its \
integral. It is slow, and it only contains integrals that system can find. \
Backward (BWD): draw a function F and differentiate it; the pair (F', F) is \
always available and fast. Integration by parts (IBP): if the integral of F'G \
is already known, the integral of FG' is FG minus it, with no computer \
algebra system (Section 3).\
\>", "Text",ExpressionUUID->"1a08180e-c362-4bda-a065-0887c318efcf"],

Cell["\[Integral] F G' dx = F G \[Minus] \[Integral] F' G dx", "Program",ExpressionUUID->"282fcaf8-05d8-4f5a-b60a-2578027bee17"],

