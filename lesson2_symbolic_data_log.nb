Cell["5. Checking a hypothesis instead of trusting it", "Section",ExpressionUUID->"8f801539-3ec9-409d-87aa-2687112d5b16"],

Cell["\<\
Nothing stops the decoder from writing an invalid prefix sequence; such \
hypotheses are simply discarded. And an integral can be checked by \
differentiating it. So the paper verifies every hypothesis in the beam, not \
only the most likely one: 'beam size 10' means at least one of the 10 was \
correct (Section 4.4). A constant of integration does not matter.\
\>", "Text",ExpressionUUID->"c80333ba-02ac-4472-909c-45d26de60700"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"hypothesis\"\>", "\<\"expression\"\>", "\<\"verified\"\>"},
    {
     TemplateBox[{
      "\[ThinSpace]", "\" \"", "\"add\"", "\"mul\"", "\"x\"", "\"sin\"", 
       "\"x\"", "\"cos\"", "\"x\""},
      "RowWithSeparators"], 
     TagBox[
      FormBox[
       RowBox[{
        RowBox[{"\[FormalX]", " ", 
         RowBox[{"sin", "(", "\[FormalX]", ")"}]}], "+", 
        RowBox[{"cos", "(", "\[FormalX]", ")"}]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True], "True"},
    {
     TemplateBox[{
      "\[ThinSpace]", "\" \"", "\"add\"", "\"mul\"", "\"x\"", "\"sin\"", 
       "\"x\"", "\"add\"", "\"cos\"", "\"x\"", "\"INT+\"", "\"3\""},
      "RowWithSeparators"], 
     TagBox[
      FormBox[
       RowBox[{
        RowBox[{"\[FormalX]", " ", 
         RowBox[{"sin", "(", "\[FormalX]", ")"}]}], "+", 
        RowBox[{"cos", "(", "\[FormalX]", ")"}], "+", "3"}],
       TraditionalForm],
      TraditionalForm,
      Editable->True], "True"},
    {
     TemplateBox[{
      "\[ThinSpace]", "\" \"", "\"mul\"", "\"x\"", "\"sin\"", "\"x\""},
      "RowWithSeparators"], 
     TagBox[
      FormBox[
       RowBox[{"\[FormalX]", " ", 
        RowBox[{"sin", "(", "\[FormalX]", ")"}]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True], "False"},
    {
     TemplateBox[{
      "\[ThinSpace]", "\" \"", "\"add\"", "\"mul\"", "\"x\"", "\"sin\""},
      "RowWithSeparators"], "\<\"invalid prefix\"\>", "False"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"921b8a5c-b7f0-45e6-873e-0b8c6e841f97"],

Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "for \[Integral] x cos x dx: x sin x + cos x and x sin x + cos x + 3 are \
accepted; x sin x and an invalid sequence are rejected"
}], "Text",ExpressionUUID->"6d4f7516-71b3-4a23-80a3-61c003866265"],

Cell["Where this is used in TensorNets", "Section",ExpressionUUID->"b2879998-50ad-4a59-8dae-85f67e1cf2fb"],

Cell["\<\
TensorNets writes trees in the same prefix notation (tnS, tnP, tnE, atoms), \
samples \:2a02/\:2a01 trees with the binary Algorithm 1 (Lesson 4), and \
checks every answer against an exact oracle (tnEquivalentQ), exactly as this \
paper checks integrals by differentiation.\
\>", "Text",ExpressionUUID->"a753fa8f-e88c-40fd-bd05-edc7e30ba97e"],

Cell["\[Copyright] Computational Classnotes \[CenterDot] CC BY-NC-SA 4.0", \
"Text",ExpressionUUID->"f1f9b1c3-688f-4575-97c0-aff853187bf3"]
},
