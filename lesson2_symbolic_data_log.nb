Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "with those settings there are about 5.4 \[Times] 10\.b3\.b3 expressions \
with 15 internal nodes"
}], "Text",ExpressionUUID->"9a468213-9ff1-4ffe-b72a-a939715c0ade"],

Cell["3. Sampling trees uniformly", "Section",ExpressionUUID->"33d5a501-017f-4e1e-88e5-1920fe068bf9"],

Cell["\<\
A naive recursive generator (choose binary or unary with fixed probabilities, \
then split the remaining nodes at random) favours some shapes. The paper \
samples every tree with n internal nodes equally often, using D(e, n) \
(Appendix C, Algorithm 2):\
\>", "Text",ExpressionUUID->"5e8d2bd5-e210-4411-853d-ebe1b1d0309a"],

Cell["\<\
P(next node at position k, unary)  = D(e\[Minus]k, n\[Minus]1) / D(e, n)
P(next node at position k, binary) = D(e\[Minus]k+1, n\[Minus]1) / D(e, n),   \
  k = 0 \[Ellipsis] e\[Minus]1
the k slots before it become leaves;  e \[LeftArrow] e\[Minus]k (unary)  or  \
e\[Minus]k+1 (binary);  n \[LeftArrow] n\[Minus]1\
\>", "Program",ExpressionUUID->"9789a8fc-06e7-413f-b8aa-2448b59af539"],

