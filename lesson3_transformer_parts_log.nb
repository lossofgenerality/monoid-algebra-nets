Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "the net built from primitive layers equals multi-head attention coded from \
arrays (d = 16, h = 4)"
}], "Text",ExpressionUUID->"e9fad76b-d4dd-4793-a36c-9150e11ff055"],

Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "and so does its causal version, used for decoder self-attention"
}], "Text",ExpressionUUID->"a8529a0a-0950-4097-abb5-c74e7e4e3817"],

Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "it has 4(d\.b2 + d) = 1088 parameters, whatever the number of heads"
}], "Text",ExpressionUUID->"3dc18a4c-2c16-42b1-9081-bed0ae3821a4"],

Cell["5. Positional encoding", "Section",ExpressionUUID->"965112bc-3182-4c2c-9667-31b0b975cc08"],

Cell["\<\
Attention by itself ignores word order, so a position code is added to each \
embedding (Section 3.5). Each pair of components is a sine and a cosine of \
the position, with wavelengths from 2\[Pi] to 10000\[CenterDot]2\[Pi].\
\>", "Text",ExpressionUUID->"615dca53-d8ce-495b-ba68-37c926ef8aa5"],

Cell["\<\
PE(pos, 2i) = sin(pos / 10000^(2i/dmodel))      PE(pos, 2i+1) = cos(pos / \
10000^(2i/dmodel))\
\>", "Program",ExpressionUUID->"5a54fb41-dc85-4977-8a1e-ce1a00a6c334"],

