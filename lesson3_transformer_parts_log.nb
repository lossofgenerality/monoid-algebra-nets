Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "the peak is at step 4000, at 1/\[Sqrt](512 \[Times] 4000) \[TildeTilde] 7.0\
\[Times]10\:207b\:2074"
}], "Text",ExpressionUUID->"f6a03523-5b05-4524-a4fa-6ce8029af620"],

Cell["\<\
In Wolfram: NetTrain[\[Ellipsis], Method -> {\"ADAM\", \"Beta1\" -> 0.9, \
\"Beta2\" -> 0.98, \"LearningRate\" -> peak, \"LearningRateSchedule\" -> \
(atRate[#] / peak &)}]. The schedule is a factor of the learning rate, so the \
learning rate is set to the peak. (The ADAM \[Epsilon] of 10\:207b\:2079 made \
training collapse in the demo nets, so they keep Wolfram's default.)\
\>", "Text",ExpressionUUID->"8720f75f-8d42-42f8-aa85-760a24f9d018"],

Cell["12. Beam search with a length penalty", "Section",ExpressionUUID->"a13a2f69-5b29-4ff9-971e-f34b1840f4a1"],

Cell["\<\
The log-probability of a hypothesis only falls as it grows, so plain beam \
search prefers short outputs. The paper uses beam size 4 and divides each \
finished hypothesis's log-probability by a length penalty with \[Alpha] = 0.6 \
(Section 6.1, from Wu et al. 2016). The beam itself is the one from Lesson 1.\
\
\>", "Text",ExpressionUUID->"2138c14d-5064-4699-9b31-081095d1e0a2"],

Cell["\<\
score(Y) = log P(Y | X) / lp(Y),     lp(Y) = ((5 + |Y|) / 6)^\[Alpha]\
\>", "Program",ExpressionUUID->"9526af57-30bd-486a-969b-cae5a5cdffce"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"hypothesis\"\>", "\<\"log P\"\>", "\<\"length\"\>", "\<\"score, \
\[Alpha] = 0\"\>", "\<\"score, \[Alpha] = 0.6\"\>"},
    {"\<\"short\"\>", 
     RowBox[{"-", "2.`"}], "2", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"-2.\"\>",
        ShowStringCharacters->False],
       -2.,
       AutoDelete->True],
      NumberForm[#, 3]& ], 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"-1.82\"\>",
        ShowStringCharacters->False],
       -1.8233159112802424`,
       AutoDelete->True],
      NumberForm[#, 3]& ]},
    {"\<\"long\"\>", 
     RowBox[{"-", "2.6`"}], "8", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"-2.6\"\>",
        ShowStringCharacters->False],
       -2.6,
       AutoDelete->True],
      NumberForm[#, 3]& ], 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"-1.63\"\>",
        ShowStringCharacters->False],
       -1.6349259488288288`,
       AutoDelete->True],
      NumberForm[#, 3]& ]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"431dd2e6-4aae-4351-812f-b1307465951a"],

Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "without the penalty the short hypothesis wins; with \[Alpha] = 0.6 the \
long, slightly less likely one does"
}], "Text",ExpressionUUID->"a9c8ae36-977f-48a4-9bca-59f70b1a99f1"],

Cell["13. The parameter count of the base model", "Section",ExpressionUUID->"449f8271-0493-4801-acb6-c61fc40f552a"],

Cell["\<\
Counted from the parts above, for dmodel = 512, dff = 2048, h = 8, 6 encoder \
and 6 decoder layers, and the shared vocabulary of about 37,000 tokens \
(Section 5.1):\
\>", "Text",ExpressionUUID->"2dd7f59c-116c-4a8f-82b6-528483de96f9"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"shared embedding / pre-softmax 37000 \[Times] 512\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"18,944,000\"\>",
        ShowStringCharacters->False],
       18944000,
       Editable->False],
      NumberForm[#, DigitBlock -> 3]& ]},
    {"\<\"encoder: 6 \[Times] (attention + FFN + 2 LayerNorm)\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"18,914,304\"\>",
        ShowStringCharacters->False],
       18914304,
       Editable->False],
      NumberForm[#, DigitBlock -> 3]& ]},
    {"\<\"decoder: 6 \[Times] (2 attentions + FFN + 3 LayerNorm)\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"25,224,192\"\>",
        ShowStringCharacters->False],
       25224192,
       Editable->False],
      NumberForm[#, DigitBlock -> 3]& ]},
    {"\<\"softmax biases\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"37,000\"\>",
        ShowStringCharacters->False],
       37000,
       Editable->False],
      NumberForm[#, DigitBlock -> 3]& ]},
    {
     StyleBox["\<\"total\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox[
      TagBox[
       InterpretationBox[
        StyleBox["\<\"63,119,496\"\>",
         ShowStringCharacters->False],
        63119496,
        Editable->False],
       NumberForm[#, DigitBlock -> 3]& ],
      StripOnInput->False,
      FontWeight->Bold]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {Left, Right}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"cf8a59b4-caf8-414c-911a-35fea0436e79"],

Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "the per-layer formulas agree with Wolfram's counts for small encoder and \
decoder layers"
}], "Text",ExpressionUUID->"ea21cb9d-62fa-4331-bdad-e81e683b85e6"],

Cell[TextData[{
 StyleBox["PASS  ",
  FontWeight->Bold,
  FontColor->RGBColor[0, 0.5, 0]],
 "the total, 63,119,496, is within 5% of the 65M given in the paper's Table \
3; the exact figure depends on the vocabulary and on what is counted"
}], "Text",ExpressionUUID->"768026b3-9e36-4ef9-9b76-92cba4f03d1d"],

Cell["Where this is used in TensorNets", "Section",ExpressionUUID->"bd310ddd-d443-4605-9520-ad5e64715cbd"],

Cell["\<\
tnParserNet, tnPolicyNet and tnValueNet are all built from these parts: \
tnParserNet is a full encoder\[Dash]decoder, tnPolicyNet and tnValueNet are \
encoders with small heads on top.\
\>", "Text",ExpressionUUID->"a1c7052c-3f87-4ffc-83e1-5bb10b6dfc61"],

Cell["\[Copyright] Computational Classnotes \[CenterDot] CC BY-NC-SA 4.0", \
"Text",ExpressionUUID->"d5ba73c6-b0f3-4c03-9410-8d61f4691fe9"]
},
