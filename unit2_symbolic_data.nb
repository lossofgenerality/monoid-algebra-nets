Cell["\<\
Check: {True, True, True}. Every pair is correct, and BWD problems are longer \
than their solutions on average: differentiation lengthens expressions. The \
paper sees the same (its Table 1), and notes that a model trained only on BWD \
data learns that integrating shortens expressions, which FWD data contradicts.\
\>", "Text",ExpressionUUID->"3cba636a-dafd-4ec5-9312-5cabb6773e46"],

Cell["6.3 IBP from a small table", "Subsection",ExpressionUUID->"9bca58c9-7945-4147-97b3-f777e41bf4de"],

Cell["\<\
Start with the BWD pairs of six functions, then apply integration by parts to \
every pair (F, G) of them, three times; each round can use what the previous \
one found.\
\>", "Text",ExpressionUUID->"408578be-6e82-4097-b40d-494f16f5430e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"d3180e70", "-", 
     RowBox[{"059", "f"}], "-", 
     RowBox[{"43", "a8"}], "-", "9588", "-", 
     RowBox[{"37", 
      RowBox[{"d66e6e4bc0", " ", "\[CenterDot]", " ", "unit2_symbolic"}], 
      RowBox[{"_data", " ", "\[CenterDot]", " ", "cell"}], " ", "23", " ", 
      "of", " ", 
      RowBox[{"27", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"52", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pool", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\[FormalX]", ",", " ", 
       RowBox[{"\[FormalX]", "^", "2"}], ",", " ", 
       RowBox[{"\[FormalX]", "^", "3"}], ",", " ", 
       RowBox[{"Sin", "[", "\[FormalX]", "]"}], ",", " ", 
       RowBox[{"Cos", "[", "\[FormalX]", "]"}], ",", " ", 
       RowBox[{"Exp", "[", "\[FormalX]", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k0", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"#", ",", " ", "\[FormalX]"}], "]"}], ",", " ", "#"}], 
        "}"}], " ", "&"}], " ", "/@", " ", "pool"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ibp", " ", "=", " ", 
     RowBox[{"Drop", "[", 
      RowBox[{
       RowBox[{"Nest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ibpRound", "[", 
           RowBox[{"#", ",", " ", "pool"}], "]"}], " ", "&"}], ",", " ", "k0",
          ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"Length", "[", "k0", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], " ", 
        "/@", " ", 
        RowBox[{"Take", "[", 
         RowBox[{"ibp", ",", " ", 
          RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<problem\>\"", ",", 
         " ", "\"\<solution found by IBP\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"b4707d80-3487-40ac-8bb6-465abbe7b25d"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"problem\"\>", "\<\"solution found by IBP\"\>"},
    {
     TagBox[
      FormBox[
       RowBox[{"\[FormalX]", " ", 
        RowBox[{"cos", "(", "\[FormalX]", ")"}]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True], 
     TagBox[
      FormBox[
