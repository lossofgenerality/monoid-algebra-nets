                    RowBox[{"G", ",", " ", "\[FormalX]"}], "]"}]}], "]"}]}], ",",
                    " ", 
                   RowBox[{"s", " ", "=", " ", 
                    RowBox[{"Simplify", "[", 
                    RowBox[{
                    RowBox[{"F", " ", "G"}], " ", "-", " ", "known"}], 
                    "]"}]}]}], "}"}], ",", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"lookup", "[", 
                    RowBox[{"new", ",", " ", "p"}], "]"}], " ", "===", " ", 
                    "$Failed"}], ",", " ", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"new", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", " ", "s"}], "}"}]}], "]"}]}], "]"}]}], 
                "]"}]}], "]"}]}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"F", ",", " ", "pool"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"G", ",", " ", "pool"}], "}"}]}], "]"}], ";", " ", 
        "new"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"verifiedQ", "[", 
      RowBox[{"problem_", ",", " ", "tokens_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"F", " ", "=", " ", 
         RowBox[{"fromPrefix", "[", "tokens", "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"F", " ", "=!=", " ", "$Failed"}], " ", "&&", " ", 
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"Quiet", "@", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"F", ",", " ", "\[FormalX]"}], "]"}], " ", "-", " ", 
             "problem"}], "]"}]}], " ", "===", " ", "0"}], "]"}]}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "drawing", " ", "a", " ", "prefix", " ", "sequence", " ", "as", " ", 
     "its", " ", "tree"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"treeGraph", "[", "tokens_List", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pos", " ", "=", " ", "0"}], ",", " ", 
         RowBox[{"edges", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "rec"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"rec", "[", "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"me", " ", "=", " ", 
              RowBox[{"++", "pos"}]}], ",", " ", 
             RowBox[{"t", " ", "=", " ", 
              RowBox[{"tokens", "[", 
               RowBox[{"[", "pos", "]"}], "]"}]}], ",", " ", "k"}], "}"}], ",",
            " ", 
           RowBox[{
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"k", " ", "=", " ", 
                RowBox[{"rec", "[", "]"}]}], ";", " ", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"edges", ",", " ", 
                 RowBox[{"me", " ", "->", " ", "k"}]}], "]"}]}], ",", " ", 
              RowBox[{"Lookup", "[", 
               RowBox[{"arity", ",", " ", "t", ",", " ", "0"}], "]"}]}], 
             "]"}], ";", " ", "me"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"rec", "[", "]"}], ";", " ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "tokens", "]"}], "]"}], ",", " ", "edges", ",",
           " ", 
          RowBox[{"VertexLabels", " ", "->", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"i", " ", "->", " ", 
              RowBox[{"Placed", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"tokens", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", " ", "13"}], "]"}], ",",
                 " ", "Center"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", 
               RowBox[{"Length", "[", "tokens", "]"}]}], "}"}]}], "]"}]}], ",",
           "\n", "    ", 
          RowBox[{"VertexSize", " ", "->", " ", "0.45"}], ",", " ", 
          RowBox[{"VertexStyle", " ", "->", " ", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"1", ",", " ", "0.93", ",", " ", "0.85"}], "]"}]}], ",", 
          " ", 
          RowBox[{"GraphLayout", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<LayeredEmbedding\>\"", ",", " ", 
             RowBox[{"\"\<RootVertex\>\"", " ", "->", " ", "1"}]}], "}"}]}], ",",
           " ", 
          RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "2019", "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"5ae29332-c9ab-4e16-8ccb-fa591dbf70d1"],

Cell["2. The idea: mathematics as translation", "Section",ExpressionUUID->"b59dc574-54eb-4f26-993b-e89867b41431"],

Cell["\<\
Write a problem as a sequence of symbols and its solution as another, and a \
sequence-to-sequence model (Unit 1, Unit 3) can learn to map one to the \
other. For integration the problem is f and the solution is a function F with \
F\[Prime] = f. Three things are needed: a way to write expressions as \
sequences, a supply of correct problem\[Dash]solution pairs, and a way to \
check what the model writes. Sections 3\[Dash]7 build each one.\
\>", "Text",ExpressionUUID->"382783b5-6ae0-45e6-ba89-1ce7aef7ff87"],

Cell["\<\
An expression is a tree. Operators are internal nodes; numbers and variables \
are leaves. 2 + 3 \[Times] (5 + 2) is the tree below.\
\>", "Text",ExpressionUUID->"79d8c01a-4650-4b47-b42c-af0d3c482f14"],

