Cell[TextData[{
 StyleBox["Fig. 2. ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.83, 0.34, 0.11]],
 "The number of trees and of expressions with n internal nodes, on a log \
scale. With the paper\[CloseCurlyQuote]s operators and leaves there are about \
5.4 \[Times] 10\.b3\.b3 expressions with 15 internal nodes."
}], "Text",ExpressionUUID->"e0cb4823-42ea-4b8c-821f-a82378bd3c25"],

