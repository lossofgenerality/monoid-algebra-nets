Cell["\<\
Check: {True, False, False, False}: x + 3 is a tree; add x owes a subtree; \
add x x x has one too many; INT+ has no digits.\
\>", "Text",ExpressionUUID->"f4f756c3-4d68-47d7-ad6b-14b7c500df89"],

Cell["3.2 Integers", "Subsection",ExpressionUUID->"2dee94ac-8914-4632-a141-00415dfe4724"],

Cell["\<\
An integer is a sign token followed by its decimal digits: \[Minus]305 is INT\
\[Minus] 3 0 5. Ten digit tokens and two signs cover every integer, so the \
vocabulary stays small.\
\>", "Text",ExpressionUUID->"9f16d165-415e-4520-a3fc-e5e5cc7e78dd"],

