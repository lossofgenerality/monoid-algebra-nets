   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]", " ", "the", " ", "demo", " ", 
     "\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lcDemo", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pairs", ",", " ", "train", ",", " ", "test", ",", " ", "net"}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "   ", 
        RowBox[{"lcLogCells", " ", "=", " ", 
         RowBox[{"{", "}"}]}], ";", "\n", "   ", 
        RowBox[{"lcLog", "[", 
         RowBox[{"\"\<Paper model (lcPaperConfig): parameters counted, not \
trained\>\"", ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Config\>\"", " ", "->", " ", "lcPaperConfig"}], ",", 
            " ", 
            RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
             RowBox[{"lcParameterCount", "[", "lcPaperConfig", "]"}]}]}], 
           "|>"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"lcLog", "[", 
         RowBox[{"\"\<Demo model (lcDemoConfig)\>\"", ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Config\>\"", " ", "->", " ", "lcDemoConfig"}], ",", 
            " ", 
            RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
             RowBox[{"lcParameterCount", "[", "lcDemoConfig", "]"}]}]}], 
           "|>"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"pairs", " ", "=", " ", 
