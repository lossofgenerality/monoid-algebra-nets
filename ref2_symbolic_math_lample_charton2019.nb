               RowBox[{
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                " ", "\"\<  \[RightArrow]  \>\"", ",", " ", 
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
                " ", "\"\<      \>\"", ",", " ", 
                RowBox[{"StringRiffle", "[", 
