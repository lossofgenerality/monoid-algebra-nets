                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "&"}]}], 
                    "]"}]}], "}"}], ",", "\n", "          ", 
                  RowBox[{"Row", "[", 
                   RowBox[{"{", 
                    RowBox[{"\"\<\[Integral] \>\"", ",", " ", 
                    RowBox[{"TraditionalForm", "[", 
                    RowBox[{"pr", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                    " ", "\"\< dx  =  \>\"", ",", " ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"ok", " ", "=!=", " ", 
                    RowBox[{"{", "}"}]}], ",", " ", 
                    RowBox[{"TraditionalForm", "[", 
                    RowBox[{"First", "[", "ok", "]"}], "]"}], ",", " ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"c", " ", "===", " ", 
                    RowBox[{"{", "}"}]}], ",", " ", "\"\<\[LongDash]\>\"", ",",
                     " ", 
                    RowBox[{"TraditionalForm", "[", 
                    RowBox[{"First", "[", "c", "]"}], "]"}]}], "]"}]}], "]"}],
                     ",", " ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"ok", " ", "=!=", " ", 
