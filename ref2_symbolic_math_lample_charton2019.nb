                    RowBox[{"-", "k"}]}], "]"}]}], "}"}]}], "]"}]}]}], "]"}], 
               " ", "/@", " ", "beams"}], ",", " ", "1"}], "]"}]}], ";", "\n",
            "    ", 
           RowBox[{"cand", " ", "=", " ", 
            RowBox[{"Take", "[", 
             RowBox[{
              RowBox[{"SortBy", "[", 
               RowBox[{"cand", ",", " ", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}], ",",
               " ", 
              RowBox[{"UpTo", "[", "k", "]"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"done", " ", "=", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"done", ",", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"cand", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Last", "[", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "==", " ", 
                  "2"}], " ", "&"}]}], "]"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"beams", " ", "=", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"cand", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "!=", " ", 
                "2"}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"beams", " ", "===", " ", 
              RowBox[{"{", "}"}]}], ",", " ", 
             RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", "maxLen", "}"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"lcFromPrefix", "[", 
           RowBox[{"lcVocab", "[", 
            RowBox[{"[", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"Rest", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", "2"}], 
              "]"}], "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"SortBy", "[", 
          RowBox[{"done", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "/", 
             RowBox[{"Length", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", "&"}]}], 
          "]"}]}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"verification", ",", " ", 
     RowBox[{"as", " ", "in", " ", "the", " ", 
      RowBox[{"paper", ":", " ", 
       RowBox[{
       "differentiate", " ", "the", " ", "candidate", " ", "and", " ", 
        "compare", " ", "with", " ", "the", " ", "input", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"numerically", " ", "at", " ", "5", " ", "points"}], ",", 
          " ", 
          RowBox[{"then", " ", "symbolically"}]}], ")"}]}]}]}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lcVerifiedQ", "[", 
      RowBox[{"cand_", ",", " ", "df_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"cand", " ", "=!=", " ", "$Failed"}], " ", "&&", " ", 
      RowBox[{"!", " ", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"cand", ",", " ", "\[FormalX]"}], "]"}]}], " ", "&&", " ", 
      RowBox[{"Quiet", "@", 
       RowBox[{"TrueQ", "[", "\n", "    ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"g", " ", "=", " ", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"cand", ",", " ", "\[FormalX]"}], "]"}], " ", "-", " ", 
             "df"}]}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"N", "[", 
                 RowBox[{"g", " ", "/.", " ", 
                  RowBox[{"\[FormalX]", " ", "->", " ", "#"}]}], "]"}], " ", 
                "&"}], " ", "/@", " ", 
               RowBox[{"{", 
                RowBox[{
                "0.3", ",", " ", "0.7", ",", " ", "1.1", ",", " ", "1.9", ",",
                  " ", "2.6"}], "}"}]}], "]"}], "]"}], " ", "<", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}], " ", "&&", " ", 
           RowBox[{"TimeConstrained", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Simplify", "[", "g", "]"}], " ", "===", " ", "0"}], ",",
              " ", "2", ",", " ", "True"}], "]"}]}]}], "]"}], "]"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lcSolvedQ", "[", 
      RowBox[{"net_", ",", " ", "df_", ",", " ", "k_Integer"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"lcBeam", "[", 
        RowBox[{"net", ",", " ", "df", ",", " ", "k"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"lcVerifiedQ", "[", 
