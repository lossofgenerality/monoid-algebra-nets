                    RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
                  " ", "\"\< \>\""}], "]"}]}], "}"}], "]"}], " ", "&"}], " ", 
            "/@", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"test", ",", " ", "5"}], "]"}]}], "]"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"net", " ", "=", " ", 
         RowBox[{"lcTrain", "[", 
          
          RowBox[{"\"\<Transformer (demo)\>\"", ",", " ", "lcDemoConfig", ",",
            " ", "train", ",", " ", "30"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"lcLog", "[", 
         RowBox[{"\"\<Integration accuracy on 200 held-out functions \
(verified by differentiation, as in the paper)\>\"", ",", "\n", "    ", 
          RowBox[{"Dataset", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Beam 1\>\"", " ", "->", " ", 
              RowBox[{"N", "@", 
               RowBox[{"Mean", "@", 
