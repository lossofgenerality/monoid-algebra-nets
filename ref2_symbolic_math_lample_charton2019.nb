                     ",", " ", "\"\<   \[Times]\>\""}], "]"}]}], "}"}], 
                   "]"}]}], "]"}]}], "]"}]}], "]"}], " ", "/@", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"test", ",", " ", "12"}], "]"}]}], "]"}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"lcNet", " ", "=", " ", "net"}], ";", "\n", "   ", 
