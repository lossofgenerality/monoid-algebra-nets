            "|>"}], "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"lcLog", "[", 
         RowBox[{"\"\<Sample integrations (beam 5, best verified hypothesis \
or the top one)\>\"", ",", "\n", "    ", 
