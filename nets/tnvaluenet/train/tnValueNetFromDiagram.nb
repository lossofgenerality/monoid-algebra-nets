(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{
Cell["tnValueNetFromDiagram: a net generated from a diagram", "Title"],

Cell["Generated by the CCN Net Diagram Editor (editor/net-diagram-editor.html) on 2026-11-25 00:28 UTC.\nThe net: Input (20 tokens); embedding 128; Dims (1 per token); per-token layer 128; add; encoder 3 \:00d7 (4 heads, FF 512 GELU); Mean pool; 128 GELU; regression, 3 outputs (Estimate); 626,819 weights learnt.\nIt is built from the parts of tensor-algebra-nets (attention, feed-forward, layer normalisation, embeddings) with Wolfram\:2019s layers.", "Text"],

Cell["By Dara O Shayda and Hikari Noor Hoshino (\:661f\:91ce\:30cc\:30fc\:30eb)\nAI System Programming Group", "Text"],

Cell["The diagram", "Section"],

Cell["(* The diagram as the editor saved it; open it again in the editor with Open *)\ndiagramJSON = \"{\\\"diagram\\\":{\\\"nodes\\\":[{\\\"id\\\":\\\"t\\\",\\\"kind\\\":\\\"tokens\\\",\\\"name\\\":\\\"Input\\\",\\\"vocab\\\":20,\\\"sample\\\":\\\"P S x1 x2 x3\\\",\\\"x\\\":90,\\\"y\\\":110},{\\\"id\\\":\\\"nu\\\",\\\"kind\\\":\\\"numbers\\\",\\\"name\\\":\\\"Dims\\\",\\\"size\\\":1,\\\"x\\\":90,\\\"y\\\":290},{\\\"id\\\":\\\"e\\\",\\\"kind\\\":\\\"embed\\\",\\\"d\\\":128,\\\"pos\\\":\\\"learnt\\\",\\\"maxLen\\\":96,\\\"scale\\\":false,\\\"shared\\\":\\\"\\\",\\\"x\\\":260,\\\"y\\\":110},{\\\"id\\\":\\\"pr\\\",\\\"kind\\\":\\\"project\\\",\\\"units\\\":128,\\\"act\\\":\\\"None\\\",\\\"x\\\":260,\\\"y\\\":290},{\\\"id\\\":\\\"ad\\\",\\\"kind\\\":\\\"add\\\",\\\"nIn\\\":2,\\\"x\\\":380,\\\"y\\\":200},{\\\"id\\\":\\\"en\\\",\\\"kind\\\":\\\"encoder\\\",\\\"layers\\\":3,\\\"heads\\\":4,\\\"dff\\\":512,\\\"act\\\":\\\"GELU\\\",\\\"x\\\":500,\\\"y\\\":200},{\\\"id\\\":\\\"po\\\",\\\"kind\\\":\\\"pool\\\",\\\"op\\\":\\\"Mean\\\",\\\"x\\\":650,\\\"y\\\":200},{\\\"id\\\":\\\"de\\\",\\\"kind\\\":\\\"dense\\\",\\\"units\\\":128,\\\"act\\\":\\\"GELU\\\",\\\"x\\\":760,\\\"y\\\":200},{\\\"id\\\":\\\"re\\\",\\\"kind\\\":\\\"regression\\\",\\\"name\\\":\\\"Estimate\\\",\\\"target\\\":\\\"Target\\\",\\\"outputs\\\":3,\\\"x\\\":880,\\\"y\\\":200}],\\\"wires\\\":[{\\\"id\\\":\\\"w0\\\",\\\"from\\\":{\\\"node\\\":\\\"t\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"e\\\",\\\"port\\\":0}},{\\\"id\\\":\\\"w1\\\",\\\"from\\\":{\\\"node\\\":\\\"nu\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"pr\\\",\\\"port\\\":0}},{\\\"id\\\":\\\"w2\\\",\\\"from\\\":{\\\"node\\\":\\\"e\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"ad\\\",\\\"port\\\":0}},{\\\"id\\\":\\\"w3\\\",\\\"from\\\":{\\\"node\\\":\\\"pr\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"ad\\\",\\\"port\\\":1}},{\\\"id\\\":\\\"w4\\\",\\\"from\\\":{\\\"node\\\":\\\"ad\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"en\\\",\\\"port\\\":0}},{\\\"id\\\":\\\"w5\\\",\\\"from\\\":{\\\"node\\\":\\\"en\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"po\\\",\\\"port\\\":0}},{\\\"id\\\":\\\"w6\\\",\\\"from\\\":{\\\"node\\\":\\\"po\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"de\\\",\\\"port\\\":0}},{\\\"id\\\":\\\"w7\\\",\\\"from\\\":{\\\"node\\\":\\\"de\\\",\\\"port\\\":0},\\\"to\\\":{\\\"node\\\":\\\"re\\\",\\\"port\\\":0}}]},\\\"settings\\\":{\\\"lang\\\":\\\"wolfram\\\",\\\"name\\\":\\\"tnValueNetFromDiagram\\\",\\\"data\\\":\\\"own\\\",\\\"path\\\":\\\"\\\",\\\"pyPath\\\":\\\".\\\",\\\"epochs\\\":12,\\\"batch\\\":64,\\\"seed\\\":1234,\\\"lr\\\":0.005,\\\"l2\\\":0.0001,\\\"versionA\\\":true,\\\"versionB\\\":true}}\";", "Code"],

Cell["The parts", "Section"],

Cell["(* The parts, as in tensor-algebra-nets (ff_tensornets_new.nb and Unit 4) *)\nccnAct = <|\"ReLU\" -> Ramp, \"GELU\" -> ElementwiseLayer[\"GELU\"], \"Tanh\" -> Tanh, \"Sigmoid\" -> LogisticSigmoid|>;\nccnLinear[u_, act_] := If[act === \"None\", LinearLayer[u], NetChain[{LinearLayer[u], ccnAct[act]}]];\n\n(* Multi-head attention: projections of the query and the memory, scaled dot products, the heads joined and projected *)\nccnMHA[d_, h_, mask_] := NetGraph[<|\n    \"q\" -> NetMapOperator[NetChain[{LinearLayer[d], ReshapeLayer[{h, d/h}]}]],\n    \"k\" -> NetMapOperator[NetChain[{LinearLayer[d], ReshapeLayer[{h, d/h}]}]],\n    \"v\" -> NetMapOperator[NetChain[{LinearLayer[d], ReshapeLayer[{h, d/h}]}]],\n    \"att\" -> AttentionLayer[\"Dot\", \"ScoreRescaling\" -> \"DimensionSqrt\", \"Mask\" -> mask, \"MultiHead\" -> True],\n    \"o\" -> NetMapOperator[NetChain[{FlattenLayer[], LinearLayer[d]}]]|>,\n   {NetPort[\"Query\"] -> \"q\" -> NetPort[\"att\", \"Query\"], NetPort[\"Memory\"] -> \"k\" -> NetPort[\"att\", \"Key\"],\n    NetPort[\"Memory\"] -> \"v\" -> NetPort[\"att\", \"Value\"], \"att\" -> \"o\"},\n   \"Query\" -> {\"Varying\", d}, \"Memory\" -> {\"Varying\", d}];\nccnFF[d_, dff_, act_] := NetMapOperator[NetChain[{LinearLayer[dff], ccnAct[act], LinearLayer[d]}]];\nccnLN[] := NormalizationLayer[2, 2];        (* layer normalisation: per position, over the features *)\n\nccnEncBlock[d_, h_, dff_, act_] := NetGraph[<|\"att\" -> ccnMHA[d, h, None], \"a1\" -> TotalLayer[], \"n1\" -> ccnLN[],\n    \"ff\" -> ccnFF[d, dff, act], \"a2\" -> TotalLayer[], \"n2\" -> ccnLN[]|>,\n   {NetPort[\"Input\"] -> NetPort[\"att\", \"Query\"], NetPort[\"Input\"] -> NetPort[\"att\", \"Memory\"],\n    {NetPort[\"Input\"], \"att\"} -> \"a1\", \"a1\" -> \"n1\", \"n1\" -> \"ff\", {\"n1\", \"ff\"} -> \"a2\", \"a2\" -> \"n2\"},\n   \"Input\" -> {\"Varying\", d}];\nccnDecBlock[d_, h_, dff_, act_] := NetGraph[<|\"self\" -> ccnMHA[d, h, \"Causal\"], \"a1\" -> TotalLayer[], \"n1\" -> ccnLN[],\n    \"cross\" -> ccnMHA[d, h, None], \"a2\" -> TotalLayer[], \"n2\" -> ccnLN[], \"ff\" -> ccnFF[d, dff, act], \"a3\" -> TotalLayer[], \"n3\" -> ccnLN[]|>,\n   {NetPort[\"Input\"] -> NetPort[\"self\", \"Query\"], NetPort[\"Input\"] -> NetPort[\"self\", \"Memory\"], {NetPort[\"Input\"], \"self\"} -> \"a1\", \"a1\" -> \"n1\",\n    \"n1\" -> NetPort[\"cross\", \"Query\"], NetPort[\"Memory\"] -> NetPort[\"cross\", \"Memory\"], {\"n1\", \"cross\"} -> \"a2\", \"a2\" -> \"n2\",\n    \"n2\" -> \"ff\", {\"n2\", \"ff\"} -> \"a3\", \"a3\" -> \"n3\"},\n   \"Input\" -> {\"Varying\", d}, \"Memory\" -> {\"Varying\", d}];\nccnEncoder[d_, h_, dff_, act_, nL_] := NetChain[Table[ccnEncBlock[d, h, dff, act], nL]];\nccnDecoder[d_, h_, dff_, act_, nL_] := NetGraph[Association@Table[\"b\" <> ToString[i] -> ccnDecBlock[d, h, dff, act], {i, nL}],\n   Join[{NetPort[\"Input\"] -> NetPort[\"b1\", \"Input\"]}, Table[NetPort[\"Memory\"] -> NetPort[\"b\" <> ToString[i], \"Memory\"], {i, nL}],\n    Table[\"b\" <> ToString[i - 1] -> NetPort[\"b\" <> ToString[i], \"Input\"], {i, 2, nL}]]];\n\n(* Fixed sinusoidal positions (Unit 4): sin(position \\[Times] frequency + phase), added to the embedding *)\nccnSinusoid[d_] := NetGraph[<|\"idx\" -> SequenceIndicesLayer[], \"pos\" -> ElementwiseLayer[# - 1. &], \"col\" -> ReplicateLayer[1, 2],\n    \"angle\" -> NetMapOperator[LinearLayer[d, \"Weights\" -> List /@ Flatten@Table[{1., 1.}/10000.^(2 i/d), {i, 0, d/2 - 1}],\n       \"Biases\" -> Table[If[EvenQ[j], 0., N[Pi/2]], {j, 0, d - 1}], LearningRateMultipliers -> 0]],\n    \"sin\" -> ElementwiseLayer[Sin], \"add\" -> TotalLayer[]|>,\n   {NetPort[\"Input\"] -> \"idx\" -> \"pos\" -> \"col\" -> \"angle\" -> \"sin\", {NetPort[\"Input\"], \"sin\"} -> \"add\"}, \"Input\" -> {\"Varying\", d}];\n\n(* Token embedding, optionally sharing its weights, scaled by Sqrt[d], with learnt, sinusoidal or no positions *)\nccnEmbed[d_, v_, pos_, maxLen_, scale_, shared_] := Module[{layers, conns, last = \"tok\"},\n   layers = <|\"tok\" -> If[shared === None, EmbeddingLayer[d, v], EmbeddingLayer[d, v, \"Weights\" -> NetSharedArray[shared]]]|>;\n   conns = {NetPort[\"Input\"] -> \"tok\"};\n   If[TrueQ[scale], layers[\"scale\"] = ElementwiseLayer[Evaluate[Sqrt[N@d]] # &]; AppendTo[conns, last -> \"scale\"]; last = \"scale\"];\n   Switch[pos,\n    \"learnt\", layers = Join[layers, <|\"idx\" -> SequenceIndicesLayer[maxLen], \"pos\" -> EmbeddingLayer[d, maxLen], \"add\" -> TotalLayer[]|>];\n     conns = Join[conns, {last -> \"add\", NetPort[\"Input\"] -> \"idx\" -> \"pos\" -> \"add\"}],\n    \"sinusoidal\", layers[\"pe\"] = ccnSinusoid[d]; AppendTo[conns, last -> \"pe\"],\n    _, Null];\n   NetGraph[layers, conns, \"Input\" -> {\"Varying\", Restricted[\"Integer\", v]}]];", "Code"],

Cell["The net", "Section"],

Cell["net = NetGraph[<|\n   \"embed2\" -> ccnEmbed[128, 20, \"learnt\", 96, False, None],\n   \"project4\" -> NetMapOperator[ccnLinear[128, \"None\"]],\n   \"add5\" -> TotalLayer[],\n   \"encoder6\" -> ccnEncoder[128, 4, 512, \"GELU\", 3],\n   \"pool7\" -> AggregationLayer[Mean, 1],\n   \"dense8\" -> ccnLinear[128, \"GELU\"],\n   \"regression9\" -> LinearLayer[3],\n   \"loss_regression9\" -> MeanSquaredLossLayer[]|>,\n  {NetPort[\"Input\"] -> \"embed2\",\n   NetPort[\"Dims\"] -> \"project4\",\n   {\"embed2\", \"project4\"} -> \"add5\",\n   \"add5\" -> \"encoder6\",\n   \"encoder6\" -> \"pool7\",\n   \"pool7\" -> \"dense8\",\n   \"dense8\" -> \"regression9\",\n   \"regression9\" -> NetPort[\"Estimate\"],\n   \"regression9\" -> NetPort[\"loss_regression9\", \"Input\"],\n   NetPort[\"Target\"] -> NetPort[\"loss_regression9\", \"Target\"],\n   \"loss_regression9\" -> NetPort[\"Loss\"]},\n  \"Input\" -> {\"Varying\", Restricted[\"Integer\", 20]},\n  \"Dims\" -> {\"Varying\", 1}];\nnet", "Code"],

Cell["(* The numbers in the net: Wolfram counts the learnt weights and the fixed numbers (sinusoidal positions, label smoothing) *)\nnetCount = Information[NetInitialize[net], \"ArraysTotalElementCount\"];\nGrid[{{\"Numbers in the net, Wolfram's count\", netCount}, {\"Expected from the diagram\", 626819},\n   {\"of which learnt weights\", 626819}, {\"of which fixed numbers\", 0},\n   {\"Same?\", netCount === 626819}}, Frame -> All, Alignment -> Left]", "Code"],

Cell["Training on your own data", "Section"],

Cell["The net is trained on examples you provide. trainData is an Association with one list per port, the lists in step:\n  Input: lists of token indices, 1 to 20\n  Dims: lists of 1 numbers per token\n  Target: 3 numbers per example\nFor the TensorNets nets, the full recipes (data from the exact oracle, warm-up, beam search for decoding) are in the notebooks of tensor-algebra-nets.", "Text"],

Cell["If[ValueQ[trainData],\n  {trainTime, trained} = AbsoluteTiming[NetTrain[net, trainData, LossFunction -> \"Loss\",\n     MaxTrainingRounds -> 12, BatchSize -> 64, Method -> {\"ADAM\", \"LearningRate\" -> 0.005, \"L2Regularization\" -> 0.0001},\n     RandomSeeding -> 1234, TargetDevice -> \"CPU\", TrainingProgressReporting -> None]],\n  \"Define trainData first, as described above.\"]", "Code"],

Cell["\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0", "Text"]
}]
