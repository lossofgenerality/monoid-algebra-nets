     "so", " ", "those", " ", "biases", " ", "are", " ", "reset", " ", "here",
       " ", "as", " ", 
      RowBox[{"well", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqUniformInit", "[", "net_NetChain", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"UniformDistribution", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.08"}], ",", " ", "0.08"}], "}"}], "]"}]}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"NetInitialize", "[", 
          RowBox[{"net", ",", " ", "All", ",", " ", 
           RowBox[{"Method", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<Random\>\"", ",", " ", 
              RowBox[{"\"\<Weights\>\"", " ", "->", " ", "u"}], ",", " ", 
              RowBox[{"\"\<Biases\>\"", " ", "->", " ", "u"}]}], "}"}]}]}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"Fold", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"NetReplacePart", "[", 
            RowBox[{"#1", ",", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#2", ",", " ", "\"\<ForgetGateBiases\>\""}], "}"}], 
              " ", "->", "\n", "       ", 
              RowBox[{"RandomVariate", "[", 
               RowBox[{"u", ",", " ", 
                RowBox[{"Length", "@", 
                 RowBox[{"Normal", "@", 
                  RowBox[{"NetExtract", "[", 
                   RowBox[{"#1", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"#2", ",", " ", "\"\<ForgetGateBiases\>\""}], 
                    "}"}]}], "]"}]}]}]}], "]"}]}]}], "]"}], " ", "&"}], ",", 
          " ", "n", ",", "\n", "    ", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"Normal", "[", "n", "]"}], ",", " ", 
             "_LongShortTermMemoryLayer", ",", " ", 
             RowBox[{"{", "1", "}"}], ",", " ", 
             RowBox[{"Heads", " ", "->", " ", "False"}]}], "]"}]}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqPart5", "[", "]"}], " ", ":=", " ", 
