                 "}"}], " ", "&"}], ",", " ", "sqPaperParams"}], "]"}], ",", 
             "\n", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<total\>\"", ",", " ", "Bold"}], "]"}], ",", " ", 
               
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"Total", "[", "sqPaperParams", "]"}], ",", " ", 
                   RowBox[{"DigitBlock", " ", "->", " ", "3"}]}], "]"}], ",", 
                 " ", "Bold"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Alignment", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"Left", ",", " ", "Right"}], "}"}], "}"}]}]}], "]"}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"layer", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"LongShortTermMemoryLayer", "[", 
           RowBox[{"6", ",", " ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Varying\>\"", ",", " ", "4"}], "}"}]}]}], 
           "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"sqCheck", "[", 
         RowBox[{
          
          RowBox[{"\"\<the formula agrees with Wolfram's count for an LSTM \
layer with 4 inputs and 6 cells (\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"sqLSTMParams", "[", 
             RowBox[{"4", ",", " ", "6"}], "]"}], "]"}], " ", "<>", 
           " ", "\"\<)\>\""}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"sqLSTMParams", "[", 
            RowBox[{"4", ",", " ", "6"}], "]"}], " ", "==", " ", 
           RowBox[{"Information", "[", 
            RowBox[{"layer", ",", " ", "\"\<ArraysTotalElementCount\>\""}], 
            "]"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"sqCheck", "[", 
         RowBox[{"\"\<the total is 384,112,000: the paper's '384M parameters' \
(Section 3.4)\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Total", "[", "sqPaperParams", "]"}], " ", "==", " ", 
           "384112000"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "Running"}]}]}]}]}], " ", "the", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lesson", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqRun", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Quiet", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2014", "]"}], ";", " ", 
       RowBox[{"sqReset", "[", "]"}], ";", "\n", "   ", 
       RowBox[{
       "sqText", 
        "[", "\"\<Paper: I. Sutskever, O. Vinyals, Q. V. Le, Sequence to \
Sequence Learning with Neural Networks, NeurIPS 2014, arXiv:1409.3215. Each \
part is coded from plain arrays in lesson1_lstm_seq2seq.nb and checked \
against Wolfram's layers. The trained demo nets for this paper are in \
ref1_seq2seq_sutskever2014.nb.\>\"", "]"}], ";", "\n", "   ", 
       RowBox[{"sqPart1", "[", "]"}], ";", " ", 
       RowBox[{"sqPart2", "[", "]"}], ";", " ", 
       RowBox[{"sqPart3", "[", "]"}], ";", " ", 
       RowBox[{"sqPart4", "[", "]"}], ";", " ", 
       RowBox[{"sqPart5", "[", "]"}], ";", " ", 
       RowBox[{"sqPart6", "[", "]"}], ";", " ", 
       RowBox[{"sqPart7", "[", "]"}], ";", " ", 
       RowBox[{"sqPart8", "[", "]"}], ";", " ", 
       RowBox[{"sqPart9", "[", "]"}], ";", "\n", "   ", 
       RowBox[{
       "sqSection", "[", "\"\<Where this is used in TensorNets\>\"", "]"}], ";",
        "\n", "   ", 
       RowBox[{
       "sqText", 
        "[", "\"\<tnParserNet is a transformer rather than an LSTM (Lesson \
3), but three ideas come from this paper: an encoder\[Dash]decoder that reads \
the whole input before writing, beam search over the decoder, and clipping \
the gradient by its norm.\>\"", "]"}], ";", "\n", "   ", 
       RowBox[{"sqSaveLog", "[", "]"}], ";", "\n", "   ", 
       RowBox[{"sqAllPassQ", " ", "=", " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Values", "[", "sqResults", "]"}], ",", " ", "TrueQ"}], 
         "]"}]}], ";"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", " ", 
       RowBox[{"TrueQ", "[", "sqSkipRun", "]"}]}], ",", " ", 
      RowBox[{"sqRun", "[", "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",Expressi\
