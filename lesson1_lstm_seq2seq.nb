            RowBox[{"sqZeroState", "[", "6", "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"sqCheck", "[", 
         RowBox[{"\"\<the cell coded from arrays gives the same hidden states \
as LongShortTermMemoryLayer (7 steps, 4 inputs, 6 cells)\>\"", ",", "\n", 
          "    ", 
          RowBox[{
           RowBox[{"Max", "@", 
            RowBox[{"Abs", "[", 
             RowBox[{"mine", " ", "-", " ", 
              RowBox[{"layer", "[", "xs", "]"}]}], "]"}]}], " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "5"}]}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"starting", " ", "from", " ", "given", " ", "states"}], ",",
           " ", 
          RowBox[{"as", " ", "the", " ", "decoder", " ", "does"}]}], " ", 
         "*)"}], "\n", "   ", 
        RowBox[{"h0", " ", "=", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "6"}], 
          "]"}]}], ";", " ", 
        RowBox[{"c0", " ", "=", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "6"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"out", " ", "=", " ", 
         RowBox[{
          RowBox[{"sqWithStates", "[", "layer", "]"}], "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Input\>\"", " ", "->", " ", "xs"}], ",", " ", 
            RowBox[{"\"\<h0\>\"", " ", "->", " ", "h0"}], ",", " ", 
            RowBox[{"\"\<c0\>\"", " ", "->", " ", "c0"}]}], "|>"}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"sqCheck", "[", 
         RowBox[{"\"\<it also agrees when it starts from given states h0, c0 \
(the decoder's situation)\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "@", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"sqLSTMRun", "[", 
                 RowBox[{"wl", ",", " ", "xs", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"h0", ",", " ", "c0"}], "}"}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
               
               RowBox[{"out", "[", "\"\<Output\>\"", "]"}]}], "]"}]}], " ", "<",
             " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "5"}]}]}], " ", "&&", "\n", "     ", 
           RowBox[{
            RowBox[{"Max", "@", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", 
                 RowBox[{"sqLSTMRun", "[", 
                  RowBox[{"wl", ",", " ", "xs", ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"h0", ",", " ", "c0"}], "}"}]}], "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
               RowBox[{"out", "[", "\"\<CFinal\>\"", "]"}]}], "]"}]}], " ", "<",
             " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "5"}]}]}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqText", 
         "[", "\"\<In Wolfram the four gates are the arrays InputGate\
\[Ellipsis], ForgetGate\[Ellipsis], OutputGate\[Ellipsis] and MemoryGate\
\[Ellipsis] of LongShortTermMemoryLayer; the ports State and CellState are h \
and c, and are reached through NetGraph (sqWithStates).\>\"", "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "2."}]}]}]}]}], " ", "The", " ", "deep", " ", 
     "LSTM", " ", "encoder", " ", "and", " ", "the", " ", "thought", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"vector", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ",
     "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"The", " ", "paper", " ", "stacks", " ", "4", " ", 
      RowBox[{"LSTMs", ":", " ", 
       RowBox[{
        RowBox[{
        "layer", " ", "k", " ", "reads", " ", "the", " ", "hidden", " ", 
         "states", " ", "of", " ", "layer", " ", "k"}], "-", 
        RowBox[{
        "1.", "\n", "   ", "After", " ", "the", " ", "last", " ", "source", " ",
