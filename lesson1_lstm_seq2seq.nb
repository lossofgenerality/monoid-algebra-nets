   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "NetInitialize", " ", "gives", " ", "every", " ", "array", " ", 
      "uniform", " ", "values"}], ",", " ", 
     RowBox[{
      RowBox[{
      "except", " ", "that", " ", "it", " ", "sets", " ", "the", " ", "LSTM", 
       " ", "forget"}], "-", 
