              RowBox[{
               RowBox[{"sqLags", "[", 
                RowBox[{"T", ",", " ", "True"}], "]"}], ",", 
               " ", "\"\<reversed\>\""}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
