        RowBox[{
        "sqSection", 
         "[", "\"\<5. Uniform initialisation in [\[Minus]0.08, 0.08]\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqText", 
         "[", "\"\<All parameters start uniformly distributed in \
[\[Minus]0.08, 0.08] (Section 3.4). In Wolfram, NetInitialize does this with \
one option, except for the LSTM forget-gate biases, which it always sets to 1 \
(a later practice: Jozefowicz, Zaremba and Sutskever, 2015). sqUniformInit \
resets those too.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqFormula", 
         "[", "\"\<NetInitialize[net, All, Method -> {\\\"Random\\\", \
\\\"Weights\\\" -> UniformDistribution[{-0.08, 0.08}], \\\"Biases\\\" -> \
UniformDistribution[{-0.08, 0.08}]}]\nthen NetReplacePart[net, {k, \
\\\"ForgetGateBiases\\\"} -> RandomVariate[UniformDistribution[{-0.08, \
0.08}], n]]\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"plain", " ", "=", " ", 
         RowBox[{"NetInitialize", "[", 
          RowBox[{
           RowBox[{"NetChain", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"LongShortTermMemoryLayer", "[", "20", "]"}], "}"}], ",",
              " ", 
             RowBox[{"\"\<Input\>\"", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Varying\>\"", ",", " ", "10"}], "}"}]}]}], "]"}], 
           ",", " ", "All", ",", "\n", "     ", 
           RowBox[{"Method", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<Random\>\"", ",", " ", 
              RowBox[{"\"\<Weights\>\"", " ", "->", " ", 
               RowBox[{"UniformDistribution", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "0.08"}], ",", " ", "0.08"}], "}"}], "]"}]}], ",",
               " ", 
              RowBox[{"\"\<Biases\>\"", " ", "->", " ", 
               RowBox[{"UniformDistribution", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "0.08"}], ",", " ", "0.08"}], "}"}], "]"}]}]}],
              "}"}]}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"sqCheck", "[", 
         RowBox[{"\"\<NetInitialize alone sets the forget-gate biases to 1, \
so the paper's rule needs one more step\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Union", "@", 
            RowBox[{"Flatten", "@", 
