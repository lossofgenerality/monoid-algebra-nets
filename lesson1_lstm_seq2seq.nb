            "1"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqText", 
         "[", "\"\<The paper reports test perplexity falling from 5.8 to 4.7 \
and BLEU rising from 25.9 to 30.6 with reversed sources (Section 3.3).\>\"", 
