        RowBox[{
        "sqSection", "[", "\"\<6. Clipping the gradient by its norm\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqText", 
         "[", "\"\<LSTMs rarely have vanishing gradients but can have \
exploding ones. For each batch the paper computes the norm s of the whole \
gradient g (all parameters together) and, if s > 5, rescales g to 5 g / s \
(Section 3.4).\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqFormula", 
