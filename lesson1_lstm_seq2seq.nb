          RowBox[{"\"\<reversal leaves the average distance unchanged (\>\"", 
           " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"Mean", "[", 
             RowBox[{"sqLags", "[", "T", "]"}], "]"}], "]"}], " ", "<>", 
