       "2", " ", "x", " ", "4", " ", "layers", " ", "x", " ", "1000", " ", 
        "cells"}]}], " ", "=", " ", 
      RowBox[{"8000", " ", 
       RowBox[{"numbers", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqDeepRun", "[", 
      RowBox[{"ws_List", ",", " ", "xs_List"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"seq", " ", "=", " ", "xs"}], ",", " ", 
         RowBox[{"finals", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "run"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"run", " ", "=", " ", 
            RowBox[{"sqLSTMRun", "[", 
             RowBox[{"w", ",", " ", "seq", ",", " ", 
              RowBox[{"sqZeroState", "[", 
               RowBox[{"Length", "[", 
                RowBox[{"w", "[", "\"\<InputGateBiases\>\"", "]"}], "]"}], 
               "]"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"seq", " ", "=", " ", 
            RowBox[{"run", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", " ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"finals", ",", " ", 
             RowBox[{"Last", "[", "run", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "ws"}], "}"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Outputs\>\"", " ", "->", " ", "seq"}], ",", " ", 
          RowBox[{"\"\<FinalStates\>\"", " ", "->", " ", "finals"}]}], 
         "|>"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqPart2", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chain", ",", " ", "ws", ",", " ", "xs", ",", " ", "mine"}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
        "sqSection", 
         "[", "\"\<2. The deep LSTM encoder and the thought vector\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqText", 
         "[", "\"\<The paper stacks four LSTMs: layer k reads the hidden \
states of layer k\[Minus]1. After the last source word, the final (h, c) of \
every layer together form a fixed-size summary of the whole sentence. The \
decoder starts from it.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"chain", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"NetChain", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"LongShortTermMemoryLayer", "[", "5", "]"}], ",", " ", 
              RowBox[{"LongShortTermMemoryLayer", "[", "5", "]"}], ",", " ", 
              RowBox[{"LongShortTermMemoryLayer", "[", "5", "]"}]}], "}"}], ",",
             "\n", "      ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Varying\>\"", ",", " ", "3"}], "}"}]}]}], 
           "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"ws", " ", "=", " ", 
         RowBox[{"sqWeights", " ", "/@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"NetExtract", "[", 
             RowBox[{"chain", ",", " ", "k"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", "\n", 
        "   ", 
        RowBox[{"xs", " ", "=", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"mine", " ", "=", " ", 
         RowBox[{"sqDeepRun", "[", 
          RowBox[{"ws", ",", " ", "xs"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"sqCheck", "[", 
         RowBox[{"\"\<a 3-layer stack coded from arrays matches NetChain of \
three LongShortTermMemoryLayers\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Max", "@", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"mine", "[", "\"\<Outputs\>\"", "]"}], " ", "-", " ", 
              RowBox[{"chain", "[", "xs", "]"}]}], "]"}]}], " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "5"}]}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"sqCheck", "[", 
         RowBox[{"\"\<the thought vector of the paper's model has 2 \[Times] \
4 \[Times] 1000 = 8000 numbers (paper, Section 3.4)\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "*", "4", "*", "1000"}], " ", "==", " ", "8000"}], 
           " ", "&&", " ", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"mine", "[", "\"\<FinalStates\>\"", "]"}], "]"}], "]"}],
             " ", "==", " ", 
            RowBox[{"2", "*", "3", "*", "5"}]}]}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "3."}]}]}]}]}], " ", "The", " ", "decoder", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"step", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "decoder", " ", "is", " ", "a", " ", "second", " ", "deep", " ",
       "LSTM", " ", "with", " ", "its", " ", "own", " ", 
      RowBox[{"weights", ".", " ", "It"}], " ", "starts", " ", "from", " ", 
      "the", " ", 
      RowBox[{"encoder", "'"}], "s", " ", "final", "\n", "   ", "states"}], ",",
      " ", 
     RowBox[{
     "reads", " ", "the", " ", "embedding", " ", "of", " ", "the", " ", 
      "previous", " ", "output", " ", "word"}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "a", " ", "softmax", " ", "over", " ", "the", " ", "target",
        "\n", "   ", "vocabulary", " ", "gives", " ", "p", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"next", " ", "word"}], ")"}], ".", " ", "Generation"}], " ", 
       "stops", " ", "when", " ", "it", " ", "produces"}], " ", "<", "EOS", ">",
       "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"sqDecodeStep", "[", 
       RowBox[{"ws_List", ",", " ", "wOut_", ",", " ", "bOut_"}], "]"}], "[", 
      
      RowBox[{"states_List", ",", " ", "xEmb_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "=", " ", "xEmb"}], ",", " ", 
         RowBox[{"new", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "st"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"st", " ", "=", " ", 
            RowBox[{
             RowBox[{"sqLSTMStep", "[", 
              RowBox[{"ws", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}], "[", 
             RowBox[{
              RowBox[{"states", "[", 
               RowBox[{"[", "k", "]"}], "]"}], ",", " ", "x"}], "]"}]}], ";", 
           " ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"new", ",", " ", "st"}], "]"}], ";", " ", 
           RowBox[{"x", " ", "=", " ", 
            RowBox[{"st", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", 
            RowBox[{"Length", "[", "ws", "]"}]}], "}"}]}], "]"}], ";", "\n", 
        "   ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\"\<Probabilities\>\"", " ", "->", " ", 
             RowBox[{
              RowBox[{"Exp", "[", "#", "]"}], "/", 
              RowBox[{"Total", "[", 
               RowBox[{"Exp", "[", "#", "]"}], "]"}]}]}], " ", "&"}], "[", 
           RowBox[{
            RowBox[{"wOut", " ", ".", " ", "x"}], " ", "+", " ", "bOut"}], 
           "]"}], ",", " ", 
          RowBox[{"\"\<States\>\"", " ", "->", " ", "new"}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqPart3", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "enc", ",", " ", "dec", ",", " ", "wsE", ",", " ", "wsD", ",", " ", 
         "src", ",", " ", "emb", ",", " ", "wOut", ",", " ", "bOut", ",", " ",
          "thought", ",", " ", "step", ",", " ", 
         RowBox[{"vocab", " ", "=", " ", "10"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"sqSection", "[", "\"\<3. The decoder step\>\"", "]"}], ";", 
        "\n", "   ", 
        RowBox[{
        "sqText", 
         "[", "\"\<The decoder is a second deep LSTM with its own weights \
(the paper uses two different LSTMs). It starts from the encoder's final \
states, reads the embedding of the previous output word, and a softmax over \
the target vocabulary gives the probability of the next word.\>\"", "]"}], ";",
         "\n", "   ", 
        RowBox[{
        "sqFormula", 
         "[", "\"\<p(y_t | y_<t, x) = softmax(W\[CenterDot]h_t + b),   h_t \
from the top decoder layer\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"enc", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"NetChain", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"LongShortTermMemoryLayer", "[", "4", "]"}], ",", " ", 
              RowBox[{"LongShortTermMemoryLayer", "[", "4", "]"}]}], "}"}], ",",
             " ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Varying\>\"", ",", " ", "3"}], "}"}]}]}], 
           "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"dec", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"NetChain", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"LongShortTermMemoryLayer", "[", "4", "]"}], ",", " ", 
              RowBox[{"LongShortTermMemoryLayer", "[", "4", "]"}]}], "}"}], ",",
             " ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Varying\>\"", ",", " ", "3"}], "}"}]}]}], 
           "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"wsE", " ", "=", " ", 
         RowBox[{"sqWeights", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"NetExtract", "[", 
             RowBox[{"enc", ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"enc", ",", " ", "2"}], "]"}]}], "}"}]}]}], ";", "\n", 
        "   ", 
