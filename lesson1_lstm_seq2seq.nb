          RowBox[{
          "Zaremba", " ", "and", " ", "Sutskever", " ", "in", " ", "2015"}]}],
          ")"}], ".", " ", "The"}], " ", "paper", " ", "used", "\n", "   ", 
       "the", " ", "uniform", " ", "distribution", " ", "for", " ", "every", " ",
        "parameter"}]}], ",", " ", 
