          "]"}]}], ";", "\n", "   ", 
        RowBox[{"vals", " ", "=", " ", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Normal", "@", 
