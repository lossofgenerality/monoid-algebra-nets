     "gradient", " ", "by", " ", "its", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"norm", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"\"\<for each training batch, we compute s = ||g||_2 ... If s > \
5, we set g = 5 g / s.\>\"", "\n", "   ", "g", " ", "is", " ", "the", " ", 
      "gradient", " ", "of", " ", "ALL", " ", "parameters", " ", 
      RowBox[{"together", ".", " ", "Scaling"}], " ", "keeps", " ", "its", " ",
       "direction"}], ";", " ", 
     RowBox[{
     "clipping", " ", "each", "\n", "   ", "component", " ", "separately", " ",
       "would", " ", "turn", " ", 
      RowBox[{"it", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqClipNorm", "[", 
      RowBox[{"g_List", ",", " ", 
       RowBox[{"threshold_", " ", ":", " ", "5"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"Norm", "[", 
          RowBox[{"Flatten", "[", "g", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"s", " ", ">", " ", "threshold"}], ",", " ", 
         RowBox[{"g", " ", 
          RowBox[{"threshold", "/", "s"}]}], ",", " ", "g"}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
