            RowBox[{"w", "[", "\"\<MemoryGateInputWeights\>\"", "]"}], " ", ".",
             " ", "x"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"w", "[", "\"\<MemoryGateStateWeights\>\"", "]"}], " ", ".",
             " ", "h"}], " ", "+", " ", 
           RowBox[{"w", "[", "\"\<MemoryGateBiases\>\"", "]"}]}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"cNew", " ", "=", " ", 
         RowBox[{
          RowBox[{"f", " ", "c"}], " ", "+", " ", 
          RowBox[{"i", " ", "g"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"o", " ", 
           RowBox[{"Tanh", "[", "cNew", "]"}]}], ",", " ", "cNew"}], 
         "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"run", " ", "over", " ", "a", " ", "whole", " ", "sequence"}], ";",
      " ", 
     RowBox[{"returns", " ", "the", " ", "list", " ", "of", " ", 
      RowBox[{"{", 
       RowBox[{"h", ",", " ", "c"}], "}"}], " ", "after", " ", "each", " ", 
      "step"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqLSTMRun", "[", 
      RowBox[{"w_Association", ",", " ", "xs_List", ",", " ", "init_List"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Rest", "@", 
      RowBox[{"FoldList", "[", 
       RowBox[{
        RowBox[{"sqLSTMStep", "[", "w", "]"}], ",", " ", "init", ",", " ", 
        "xs"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqZeroState", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", " ", "n"}], "]"}], ",", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", " ", "n"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "a", " ", "Wolfram", " ", "LSTM", " ", "layer", " ", "whose", " ", 
      "starting", " ", "states", " ", "h0"}], ",", " ", 
     RowBox[{"c0", " ", "are", " ", 
      RowBox[{"inputs", ":", " ", 
       RowBox[{
       "the", " ", "ports", " ", "State", " ", "and", " ", "CellState", "\n", 
        "   ", "of", " ", "LongShortTermMemoryLayer", " ", "are", " ", 
        "reached", " ", "through", " ", "NetGraph"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqWithStates", "[", "lstm_", "]"}], " ", ":=", " ", 
     RowBox[{"NetGraph", "[", 
      RowBox[{
       RowBox[{"{", "lstm", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], " ", "->", " ", 
          "1"}], ",", " ", 
         RowBox[{
          RowBox[{"NetPort", "[", "\"\<h0\>\"", "]"}], " ", "->", " ", 
          RowBox[{"NetPort", "[", 
           RowBox[{"1", ",", " ", "\"\<State\>\""}], "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"NetPort", "[", "\"\<c0\>\"", "]"}], " ", "->", " ", 
          RowBox[{"NetPort", "[", 
           RowBox[{"1", ",", " ", "\"\<CellState\>\""}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"NetPort", "[", 
           RowBox[{"1", ",", " ", "\"\<Output\>\""}], "]"}], " ", "->", " ", 
          RowBox[{"NetPort", "[", "\"\<Output\>\"", "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"NetPort", "[", 
           RowBox[{"1", ",", " ", "\"\<CellState\>\""}], "]"}], " ", "->", 
          " ", 
          RowBox[{"NetPort", "[", "\"\<CFinal\>\"", "]"}]}]}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sqPart1", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "layer", ",", " ", "xs", ",", " ", "mine", ",", " ", "h0", ",", " ", 
         "c0", ",", " ", "wl", ",", " ", "out"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"sqSection", "[", "\"\<1. The LSTM cell\>\"", "]"}], ";", 
        "\n", "   ", 
        RowBox[{
        "sqText", 
         "[", "\"\<An LSTM keeps a hidden state h and a memory cell c. Each \
step reads one input vector x and computes four gates; the memory is updated \
by addition, which is what lets information and gradients survive across long \
sentences.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "sqFormula", 
         "[", "\"\<i = \[Sigma](Wi\[CenterDot]x + Ui\[CenterDot]h + bi)    f \
= \[Sigma](Wf\[CenterDot]x + Uf\[CenterDot]h + bf)    o = \[Sigma](Wo\
\[CenterDot]x + Uo\[CenterDot]h + bo)\ng = tanh(Wg\[CenterDot]x + Ug\
\[CenterDot]h + bg)\nc' = f\[Times]c + i\[Times]g        h' = \
o\[Times]tanh(c')\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"layer", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"LongShortTermMemoryLayer", "[", 
           RowBox[{"6", ",", " ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Varying\>\"", ",", " ", "4"}], "}"}]}]}], 
           "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"xs", " ", "=", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"7", ",", " ", "4"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"wl", " ", "=", " ", 
         RowBox[{"sqWeights", "[", "layer", "]"}]}], ";", "\n", "   ", 
        RowBox[{"mine", " ", "=", " ", 
