           RowBox[{"ToString", "[", 
            RowBox[{"Length", "[", "vals", "]"}], "]"}], " ", "<>", 
           " ", "\"\< parameters of a 2-layer LSTM lies in [\[Minus]0.08, \
0.08]\>\""}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "vals", "]"}], "]"}], " ", "<=", " ", 
           "0.08"}]}], "]"}], ";", "\n", "   ", 
