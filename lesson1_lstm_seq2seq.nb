                "]"}]}]}]}], " ", "==", " ", 
           RowBox[{"{", "1.", "}"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"net", " ", "=", " ", 
         RowBox[{"sqUniformInit", "[", 
          RowBox[{"NetChain", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"LongShortTermMemoryLayer", "[", "20", "]"}], ",", " ", 
              
              RowBox[{"LongShortTermMemoryLayer", "[", "20", "]"}]}], "}"}], ",",
             " ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
