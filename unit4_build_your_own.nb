Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"949", "c7566"}], "-", 
     RowBox[{"068", "c"}], "-", 
     RowBox[{"4", "d92"}], "-", 
     RowBox[{"8", "a76"}], "-", 
     RowBox[{
      RowBox[{"f77eb6da9061", " ", "\[CenterDot]", " ", "unit4_build"}], 
      "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "14", " ", 
      "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"greedy", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"beamSearch", "[", 
        RowBox[{
        "ownNet", ",", " ", "#Source", ",", " ", "1", ",", " ", "False"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "test"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"free", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"beamSearch", "[", 
        RowBox[{
        "ownNet", ",", " ", "#Source", ",", " ", "4", ",", " ", "False"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "test"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gram", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"beamSearch", "[", 
        RowBox[{
        "ownNet", ",", " ", "#Source", ",", " ", "4", ",", " ", "True"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "test"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"valid", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "@", 
      RowBox[{"Mean", "@", 
       RowBox[{"Boole", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"parseT", "[", 
            RowBox[{"First", "@", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "=!=", " ", 
           "$Failed"}], " ", "&"}], " ", "/@", " ", "r"}], "]"}]}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"same", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "@", 
      RowBox[{"Mean", "@", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Boole", "[", 
           RowBox[{
            RowBox[{"First", "@", 
             RowBox[{"First", "[", "#1", "]"}]}], " ", "===", " ", 
            RowBox[{"#2", "[", "\"\<Target\>\"", "]"}]}], "]"}], " ", "&"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "test"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"top", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "@", 
      RowBox[{"Mean", "@", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Boole", "[", 
           RowBox[{"equivalentQ", "[", 
            RowBox[{
             RowBox[{"#2", "[", "\"\<Tree\>\"", "]"}], ",", " ", 
             RowBox[{"First", "@", 
              RowBox[{"First", "[", "#1", "]"}]}]}], "]"}], "]"}], " ", "&"}],
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "test"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"any", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"N", "@", 
      RowBox[{"Mean", "@", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Boole", "[", 
           RowBox[{"AnyTrue", "[", 
            RowBox[{
             RowBox[{"First", " ", "/@", " ", "#1"}], ",", " ", 
             RowBox[{"Function", "[", 
              RowBox[{"h", ",", " ", 
               RowBox[{"equivalentQ", "[", 
                RowBox[{
                 RowBox[{"#2", "[", "\"\<Tree\>\"", "]"}], ",", " ", "h"}], 
                "]"}]}], "]"}]}], "]"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "test"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"valid", "[", "#2", "]"}], "]"}], ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"same", "[", "#2", "]"}], "]"}], ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"top", "[", "#2", "]"}], "]"}], ",", " ", 
           RowBox[{"PercentForm", "[", 
            RowBox[{"any", "[", "#2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", 
        "@@@", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<greedy\>\"", ",", " ", "greedy"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<beam 4\>\"", ",", " ", "free"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<beam 4 + grammar\>\"", ",", " ", "gram"}], "}"}]}], 
         "}"}]}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<decoding (100 test sources)\>\"", ",", 
         " ", "\"\<valid prefix\>\"", ",", 
         " ", "\"\<same tokens as the oracle\>\"", ",", 
         " ", "\"\<top answer verified\>\"", ",", 
         " ", "\"\<any in beam verified\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"82117a01-6194-429a-bf04-aef32c126e6c"],

