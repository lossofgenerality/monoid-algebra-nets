Cell[TextData[{
 StyleBox["Fig. 2. ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.83, 0.34, 0.11]],
 "The training loss per round. It cannot reach 0: with label smoothing its \
floor is the entropy of the smoothed target (dashed)."
}], "Text",ExpressionUUID->"0c2ba163-099f-4b73-9abc-dbc200ba6a9b"],

Cell["\<\
With V = 10 tokens and \[CurlyEpsilon] = 0.1 the smoothed target gives 0.91 \
to the right token and 0.01 to each other. Its entropy is \[Minus](0.91 ln \
0.91 + 9 \[Times] 0.01 ln 0.01) = 0.0858 + 0.4145 = 0.500. A perfect model \
would score 0.500, not 0.\
\>", "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.83, 0.34, 0.11],
 Background->RGBColor[
  1, 0.97, 0.92],ExpressionUUID->"d25fc129-87b3-4380-967b-aaa9b3811468"],

