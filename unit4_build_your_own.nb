Cell["\<\
Check: the fraction of pairs whose expansion is longer than the source.\
\>", "Text",ExpressionUUID->"e4a45e1d-5f23-4534-b3bb-0e49c9d3d532"],

Cell["3. The data", "Section",ExpressionUUID->"7cbd8e93-df67-406f-aa5f-82a73174d789"],

Cell["\<\
Trees are drawn uniformly with Algorithm 1 of Unit 2, with 1 to 5 operators, \
each \:2a02 or \:2a01, over the atoms a, b, c, d. \:2a02 binds tighter than \
\:2a01, so the source needs parentheses only around a \:2a01 that sits under \
a \:2a02. Pairs with a source over 25 tokens or a target over 40 are dropped.\
\
\>", "Text",ExpressionUUID->"275588ef-c8d7-4afe-b5e7-57d5e8886119"],

Cell["\<\
The tree \:2a02(\:2a01(a, b), c) in prefix is \:2a02 \:2a01 a b c. In infix, \
the left child is a \:2a01 under a \:2a02, so it is bracketed: ( a \:2a01 b ) \
\:2a02 c, 7 tokens. The tree \:2a01(a, \:2a02(b, c)) needs no brackets: a \
\:2a01 b \:2a02 c, 5 tokens, because \:2a02 binds tighter.\
\>", "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.83, 0.34, 0.11],
 Background->RGBColor[
  1, 0.97, 0.92],ExpressionUUID->"6aa3880a-d602-4d9a-9791-5f0ebe416cd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"6", "c1f313c"}], "-", 
     RowBox[{"3", "dd6"}], "-", 
     RowBox[{"42", "fe"}], "-", 
     RowBox[{"90", "f6"}], "-", 
     RowBox[{"0", 
      RowBox[{"ac19f4943ca", " ", "\[CenterDot]", " ", "unit4_build"}], 
      "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "5", " ", "of",
       " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"infix", "[", 
     RowBox[{"parseT", "[", 
      RowBox[{"{", 
       RowBox[{
       "otimes", ",", " ", "oplus", ",", " ", "\"\<a\>\"", ",", 
        " ", "\"\<b\>\"", ",", " ", "\"\<c\>\""}], "}"}], "]"}], "]"}], ",", 
    " ", 
    RowBox[{"infix", "[", 
     RowBox[{"parseT", "[", 
      RowBox[{"{", 
       RowBox[{
       "oplus", ",", " ", "\"\<a\>\"", ",", " ", "otimes", ",", 
        " ", "\"\<b\>\"", ",", " ", "\"\<c\>\""}], "}"}], "]"}], "]"}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"0052b6fe-5140-4b0f-a0df-3e059fdc7986"],

