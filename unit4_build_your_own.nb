Cell["8. Where the net goes wrong", "Section",ExpressionUUID->"25a0cfe5-55ff-43e2-ae75-a61e3f07cb21"],

Cell["\<\
The oracle shows exactly which answers are wrong. Group the test sources by \
the length of their expansion and compare the top-answer accuracy:\
\>", "Text",ExpressionUUID->"59806671-0498-4820-80a3-85a36eaeafd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"afab7108", "-", "f11c", "-", 
     RowBox[{"49", "c0"}], "-", 
     RowBox[{"847", "b"}], "-", 
     RowBox[{"5", 
      RowBox[{"fed3877847f", " ", "\[CenterDot]", " ", "unit4_build"}], 
      "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "17", " ", 
      "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"byLen", " ", "=", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#Target", "]"}], " ", "&"}], " ", "/@", 
           " ", "test"}], ",", " ", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Boole", "[", 
              RowBox[{"equivalentQ", "[", 
               RowBox[{
                RowBox[{"#2", "[", "\"\<Tree\>\"", "]"}], ",", " ", 
                RowBox[{"First", "@", 
                 RowBox[{"First", "[", "#1", "]"}]}]}], "]"}], "]"}], " ", 
             "&"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"gram", ",", " ", "test"}], "}"}]}], "]"}]}], "}"}], 
        "]"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", "10"}], ",", 
           " ", "\"\<1\[Dash]10\>\"", ",", " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", "20"}], ",", 
           " ", "\"\<11\[Dash]20\>\"", ",", " ", "True", ",", 
           " ", "\"\<21\[Dash]40\>\""}], "]"}], " ", "&"}], " ", "->", " ", 
        "Last"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"byLen", " ", "=", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{"byLen", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<1\[Dash]10\>\"", ",", " ", "\"\<11\[Dash]20\>\"", ",", 
         " ", "\"\<21\[Dash]40\>\""}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"Mean", " ", "/@", " ", 
       RowBox[{"Values", "[", "byLen", "]"}]}], "]"}], ",", " ", 
     RowBox[{"ChartLabels", " ", "->", " ", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", "<>", " ", "\"\< (\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "#2", "]"}], "]"}], " ", "<>", 
          " ", "\"\<)\>\""}], " ", "&"}], ",", " ", "byLen"}], "]"}]}], ",", 
     "\n", " ", 
     RowBox[{"ChartStyle", " ", "->", " ", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.98", ",", " ", "0.56", ",", " ", "0.17"}], "]"}]}], ",", 
     " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<target length in tokens\>\"", ",", 
        " ", "\"\<top answer verified\>\""}], "}"}]}], ",", "\n", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<Accuracy by length of the expansion\>\""}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "480"}], ",", " ", 
     RowBox[{"ImagePadding", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"60", ",", " ", "10"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"40", ",", " ", "30"}], "}"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"6fac551d-279e-42f8-b01e-06a22c796146"],

