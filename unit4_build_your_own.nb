Cell["\<\
Check: the number of test sources in each group, and the accuracy of each. A \
single wrong token spoils a whole expansion, so longer targets are harder.\
\>", "Text",ExpressionUUID->"ea3a0903-5f2c-4bb9-97fe-4c8322db4b9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"79353432", "-", "2036", "-", 
     RowBox[{"4", "a14"}], "-", "b231", "-", 
     RowBox[{
      RowBox[{"b855c729ff6e", " ", "\[CenterDot]", " ", "unit4_build"}], 
      "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "19", " ", 
      "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"wrong", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "test", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"equivalentQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"test", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "[", "\"\<Tree\>\"", "]"}], ",", 
           " ", 
           RowBox[{"First", "@", 
            RowBox[{"First", "[", 
             RowBox[{"gram", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}]}]}], "]"}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"test", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Source\>\"", "]"}], ",",
              " ", "\"\< \>\""}], "]"}], ",", " ", 
           RowBox[{"Row", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"test", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Target\>\"", "]"}], ",",
              " ", "\"\< \>\""}], "]"}], ",", " ", 
           RowBox[{"Row", "[", 
            RowBox[{
             RowBox[{"First", "@", 
              RowBox[{"First", "[", 
               RowBox[{"gram", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
             " ", "\"\< \>\""}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Take", "[", 
            RowBox[{"wrong", ",", " ", 
             RowBox[{"UpTo", "[", "6", "]"}]}], "]"}]}], "}"}]}], "]"}], ",", 
       "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<source\>\"", ",", " ", "\"\<correct expansion\>\"", ",", 
         " ", "\"\<the net\[CloseCurlyQuote]s answer\>\""}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"fd93cd5d-7ca0-41e1-ac31-b44567396442"],

