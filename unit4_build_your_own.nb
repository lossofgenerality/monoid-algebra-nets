           RowBox[{"ReshapeLayer", "[", 
            RowBox[{"{", 
             RowBox[{"h", ",", " ", 
              RowBox[{"d", "/", "h"}]}], "}"}], "]"}], "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<att\>\"", " ", "->", " ", 
