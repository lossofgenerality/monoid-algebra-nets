Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"d9dc7677", "-", 
     RowBox[{"38", "a4"}], "-", "4587", "-", 
     RowBox[{"84", "c9"}], "-", 
     RowBox[{"6758", 
      RowBox[{"a3ee43ee", " ", "\[CenterDot]", " ", "unit4_build"}], "_your", 
      
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "4", " ", "of",
