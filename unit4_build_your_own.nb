Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"59950", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[9]=",ExpressionUUID->"cad0f5b3-1c0f-4157-a64d-01e8c4313dc2"],

Cell["\<\
Counting with the formulas of Unit 3 (d = 32, dff = 128): attention 4(32\.b2 \
+ 32) = 4224; feed-forward 32\[CenterDot]128 + 128 + 128\[CenterDot]32 + 32 = \
8352; LayerNorm 64. Encoder layer 4224 + 8352 + 128 = 12 704; decoder layer 2\
\[CenterDot]4224 + 8352 + 192 = 16 992. Two of each: 59 392. The shared \
embedding adds 10 \[Times] 32 = 320 and the output biases 10. The smoothing \
layer\[CloseCurlyQuote]s 10 \[Times] 10 = 100 frozen numbers and the two \
position layers\[CloseCurlyQuote] 2 \[Times] (32 + 32) = 128 frozen numbers \
are stored too: 59 392 + 320 + 10 + 100 + 128 = 59 950.\
\>", "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.83, 0.34, 0.11],
 Background->RGBColor[
  1, 0.97, 0.92],ExpressionUUID->"a7f37ffd-cb19-4b24-998b-8322a1a2986e"],

Cell["\<\
Check: {59950, True}: the count by hand, and one shared array for the three \
embeddings.\
\>", "Text",ExpressionUUID->"24b20717-9800-45cd-b963-b2cf4a12b79c"],

Cell["6. Training", "Section",ExpressionUUID->"809e1ec2-4ec0-4490-b988-f87148256b15"],

Cell["\<\
12 000 training pairs and 100 test pairs, with no test source in the training \
set. Adam with \[Beta]\:2082 = 0.98, the warm-up schedule of Unit 3 with 400 \
warm-up steps, batches of 64, 40 rounds. This cell takes about five minutes.\
\>", "Text",ExpressionUUID->"703b273d-7101-42a1-95e1-585eb118db2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"787", "c7c35"}], "-", 
     RowBox[{"291", "f"}], "-", 
     RowBox[{"4", "c52"}], "-", "b41e", "-", 
     RowBox[{"77", 
      RowBox[{"ae2d085ebc", " ", "\[CenterDot]", " ", "unit4_build"}], 
      "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "10", " ", 
      "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"test", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"makePair", "[", "]"}], ",", " ", 
       RowBox[{"settings", "[", "\"\<test\>\"", "]"}]}], "]"}]}], ";", " ", 
    RowBox[{"testSources", " ", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"#Source", " ", "&"}], " ", "/@", " ", "test"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"pairs", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";", " ", 
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "pairs", "]"}], " ", "<", " ", 
       RowBox[{"settings", "[", "\"\<train\>\"", "]"}]}], ",", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"makePair", "[", "]"}]}], "}"}], ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"testSources", ",", " ", 
             RowBox[{"p", "[", "\"\<Source\>\"", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"pairs", ",", " ", "p"}], "]"}]}], "]"}]}], "]"}]}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"result", " ", "=", " ", 
     RowBox[{"train", "[", 
      RowBox[{"settings", ",", " ", "pairs"}], "]"}]}], ";", " ", 
    RowBox[{"ownNet", " ", "=", " ", 
     RowBox[{"result", "[", "\"\<TrainedNet\>\"", "]"}]}], ";", " ", 
    RowBox[{"losses", " ", "=", " ", 
     RowBox[{"result", "[", "\"\<RoundLossList\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "pairs", "]"}], ",", " ", 
     RowBox[{"Length", "[", "test", "]"}], ",", " ", 
     RowBox[{"Round", "@", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", " ", "=", " ", 
          RowBox[{"result", "[", "\"\<TotalTrainingTime\>\"", "]"}]}], "}"}], 
        ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"QuantityQ", "[", "t", "]"}], ",", " ", 
          RowBox[{"QuantityMagnitude", "[", 
           RowBox[{"UnitConvert", "[", 
            RowBox[{"t", ",", " ", "\"\<Seconds\>\""}], "]"}], "]"}], ",", 
          " ", "t"}], "]"}]}], "]"}]}]}], "}"}]}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"54f144b3-2673-40c0-b3ff-688b8ffd9708"],

