Cell["9. Saving the net", "Section",ExpressionUUID->"56857fd8-682f-47bb-8b24-a9add18b8446"],

Cell[TextData[{
 "The trained net goes into its own notebook, unit4_",
 Cell[BoxData[
  SubscriptBox["build", "your"]],ExpressionUUID->
  "4471c3bd-e740-44b4-93ac-f0cadb9792bf"],
 "_",
 Cell[BoxData[
  SubscriptBox["own", "nets"]],ExpressionUUID->
  "a2e74d86-9ddd-41d0-9277-92aecb749827"],
 ".nb, as one Input cell ownNet = Uncompress[\"\[Ellipsis]\"]. Evaluating \
that notebook brings the net back without training."
}], "Text",ExpressionUUID->"0ae36959-dec7-4e91-a488-13fd32915cbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"3", "c3b8b81"}], "-", 
     RowBox[{"873", "c"}], "-", "4691", "-", "b645", "-", 
     RowBox[{"075", 
      RowBox[{"a5ad17584", " ", "\[CenterDot]", " ", "unit4_build"}], "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "20", " ", 
      "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"saveNet", "[", 
     RowBox[{"ownNet", ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
            RowBox[{"Directory", "[", "]"}]}], "]"}]}], ",", 
         " ", "\"\<unit4_build_your_own_nets.nb\>\""}], "}"}], "]"}]}], "]"}],
     ";"}], "\n", 
   RowBox[{"First", "@", 
    RowBox[{"First", "@", 
     RowBox[{"beamSearch", "[", 
      RowBox[{"ownNet", ",", " ", 
       RowBox[{"Characters", "[", "\"\<(a\:2a01b)\:2a02c\>\"", "]"}], ",", 
       " ", "4", ",", " ", "True"}], "]"}]}]}]}]}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"901a2a7d-65c5-4cd9-8221-b7d642937f82"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"\:2a01\"\>", ",", "\<\"\:2a02\"\>", ",", "\<\"a\"\>", 
   ",", "\<\"c\"\>", ",", "\<\"\:2a02\"\>", ",", "\<\"b\"\>", 
   ",", "\<\"c\"\>"}], "}"}]], "Output",
 CellLabel->"Out[20]=",ExpressionUUID->"c3929ad5-4e67-401e-a083-f127c66c07e5"],

Cell["\<\
Check: {\:2a01, \:2a02, a, c, \:2a02, b, c}: the saved net expands (a\:2a01b)\
\:2a02c to a\:2a02c \:2a01 b\:2a02c. Characters splits a typed expression \
into tokens, since every symbol is one character.\
\>", "Text",ExpressionUUID->"8fef2747-8fc9-4cf1-935b-05fef23c7869"],

Cell["10. Exercises", "Section",ExpressionUUID->"268798de-8d88-4dbf-a384-1eb2710a4635"],

Cell["1. Expand a\:2a02(b\:2a01c)\:2a02d by hand, and count its words.", \
"Text",ExpressionUUID->"5e04096d-6166-47dc-bcbb-90a4abc90ff3"],

Cell["\<\
2. How many words has (a\:2a01b)\:2a02(c\:2a01d)\:2a02(a\:2a01b)? How long is \
its expansion in prefix tokens?\
\>", "Text",ExpressionUUID->"987ef201-6f5e-4aef-80df-ab38f3ac7b1d"],

Cell["3. What would the loss floor of \[Section]6 be with \[CurlyEpsilon] = \
0.2?", "Text",ExpressionUUID->"42cd8742-7db8-411d-b71a-b82e23a45445"],

Cell["\<\
4. Ask the net to expand an expression of your own, and check its answer with \
equivalentQ.\
\>", "Text",ExpressionUUID->"6eca22dc-954e-4f6d-9897-bbe9e105eb4d"],

Cell["5. What does the grammar allow after \:2a02 \:2a01 a b?", "Text",ExpressionUUID->"31eb1fd0-9507-441a-a327-c64b56662b1e"],

Cell["Answers, computed:", "Text",ExpressionUUID->"b0dadde5-ea81-4ab2-880c-cb5f6f7000f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"7", "def9994"}], "-", 
     RowBox[{"1", "efd"}], "-", 
     RowBox[{"40", "b3"}], "-", "a123", "-", 
     RowBox[{"04744", 
      RowBox[{"aef791f", " ", "\[CenterDot]", " ", "unit4_build"}], "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "21", " ", 
      "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"words", "[", 
     RowBox[{"parseT", "[", 
      RowBox[{"{", 
       RowBox[{
       "otimes", ",", " ", "\"\<a\>\"", ",", " ", "otimes", ",", " ", "oplus",
         ",", " ", "\"\<b\>\"", ",", " ", "\"\<c\>\"", ",", 
        " ", "\"\<d\>\""}], "}"}], "]"}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", "@", 
       RowBox[{"words", "[", 
        RowBox[{"parseT", "[", 
         RowBox[{"{", 
          RowBox[{
          "otimes", ",", " ", "oplus", ",", " ", "\"\<a\>\"", ",", 
           " ", "\"\<b\>\"", ",", " ", "otimes", ",", " ", "oplus", ",", 
           " ", "\"\<c\>\"", ",", " ", "\"\<d\>\"", ",", " ", "oplus", ",", 
           " ", "\"\<a\>\"", ",", " ", "\"\<b\>\""}], "}"}], "]"}], "]"}]}], ",",
       " ", 
      RowBox[{"Length", "@", 
       RowBox[{"expand", "[", 
        RowBox[{"parseT", "[", 
         RowBox[{"{", 
          RowBox[{
          "otimes", ",", " ", "oplus", ",", " ", "\"\<a\>\"", ",", 
           " ", "\"\<b\>\"", ",", " ", "otimes", ",", " ", "oplus", ",", 
           " ", "\"\<c\>\"", ",", " ", "\"\<d\>\"", ",", " ", "oplus", ",", 
           " ", "\"\<a\>\"", ",", " ", "\"\<b\>\""}], "}"}], "]"}], "]"}]}]}],
      "}"}], ",", "\n", " ", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"0.82", " ", 
        RowBox[{"Log", "[", "0.82", "]"}]}], " ", "+", " ", 
       RowBox[{"9", " ", "0.02", " ", 
        RowBox[{"Log", "[", "0.02", "]"}]}]}], ")"}]}], ",", "\n", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"src", " ", "=", " ", 
        RowBox[{"Characters", "[", "\"\<a\:2a02(b\:2a01c)\>\"", "]"}]}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"First", "@", 
         RowBox[{"First", "@", 
          RowBox[{"beamSearch", "[", 
           RowBox[{
           "ownNet", ",", " ", "src", ",", " ", "4", ",", " ", "True"}], 
           "]"}]}]}], ",", " ", 
        RowBox[{"equivalentQ", "[", 
         RowBox[{
          RowBox[{"parseT", "[", 
           RowBox[{"{", 
            RowBox[{
            "otimes", ",", " ", "\"\<a\>\"", ",", " ", "oplus", ",", 
             " ", "\"\<b\>\"", ",", " ", "\"\<c\>\""}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"First", "@", 
           RowBox[{"First", "@", 
            RowBox[{"beamSearch", "[", 
             RowBox[{
             "ownNet", ",", " ", "src", ",", " ", "4", ",", " ", "True"}], 
             "]"}]}]}]}], "]"}]}], "}"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"allowed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<<s>\>\"", ",", " ", "otimes", ",", " ", "oplus", ",", 
        " ", "\"\<a\>\"", ",", " ", "\"\<b\>\""}], "}"}], ",", " ", "True"}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"72d47549-33fa-4e7d-9dff-db220865cd83"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"d\"\>"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>"}], "}"}]}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", "47"}], "}"}], ",", "0.8668939107306137`", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\<\"\:2a01\"\>", ",", "\<\"\:2a02\"\>", ",", "\<\"a\"\>", 
       ",", "\<\"b\"\>", ",", "\<\"\:2a02\"\>", ",", "\<\"a\"\>", 
       ",", "\<\"c\"\>"}], "}"}], ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>",
      ",", "\<\"\:2a02\"\>", ",", "\<\"\:2a01\"\>"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[21]=",ExpressionUUID->"9545b286-2382-4821-8ede-1d9346893a88"],

Cell["\<\
1: {abd, acd}, two words. 2: 8 words of 3 atoms; the expansion has 8 \[Times] \
5 + 7 = 47 prefix tokens, more than the 40 allowed in training, so the net \
has never seen one so long. 3: 0.867. 4: the net\[CloseCurlyQuote]s answer \
for a\:2a02(b\:2a01c) and its check. 5: one subtree is still owed (the right \
factor), so an atom or an operator, but not </s>.\
\>", "Text",ExpressionUUID->"0cfa29a1-93e2-4bb6-8fa8-212374f11532"],

Cell["11. Summary", "Section",ExpressionUUID->"46c54ae9-4842-4e52-ba0b-c7539ac98994"],

Cell["\<\
Every part came from the earlier units. Unit 2 gave the data: uniform trees, \
prefix targets and an exact oracle. Unit 3 gave the net, built from primitive \
Wolfram layers, with shared embeddings, label smoothing and warm-up. Units 1 \
and 3 gave the decoding: beam search with a length penalty, here constrained \
by the prefix grammar. The oracle makes the net safe to use: an answer that \
fails the check is never accepted, and the beam gives several chances.\
\>", "Text",ExpressionUUID->"b9566974-7490-4042-9ff3-a3e060fabdb6"],

Cell[TextData[{
 "In TensorNets: tnParserNet in ",
 Cell[BoxData[
  SubscriptBox["ff", "tensornets"]],ExpressionUUID->
  "12278885-36e6-4a0f-a9db-658ebb27c49c"],
 "_new.nb is this kind of encoder\[Dash]decoder, mapping tokens to the prefix \
tree; tnPolicyNet and tnValueNet reuse the encoder. There, simplification is \
done by the policy net choosing rewrite rules that the exact engine applies, \
so every step is sound, rather than by writing the whole answer at once as \
here."
}], "Text",ExpressionUUID->"37828a00-f42e-4223-82d6-3e893f27448d"],

