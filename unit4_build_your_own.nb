"Text",ExpressionUUID->"5a13ab8e-d4e4-475c-96bb-5b6bdd0dbd56"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"44918652", "-", "fb91", "-", 
     RowBox[{"475", "e"}], "-", "a45c", "-", 
     RowBox[{
      RowBox[{"e37cb1f3186a", " ", "\[CenterDot]", " ", "unit4_build"}], 
      "_your", 
      RowBox[{"_own", " ", "\[CenterDot]", " ", "cell"}], " ", "6", " ", "of",
       " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "07"}]}], ":", 
    RowBox[{"18", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"b4", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", "9"}], "]"}], ",", 
       " ", 
       RowBox[{
        RowBox[{
         RowBox[{"parseT", "[", 
          RowBox[{"#", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"0", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
             RowBox[{"2", " ", "->", " ", "oplus"}]}], "}"}]}], "]"}], " ", "=!=",
          " ", "$Failed"}], " ", "&"}]}], "]"}]}], ";", " ", 
    RowBox[{"s4", " ", "=", " ", 
     RowBox[{"Counts", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"binaryTree", "[", "4", "]"}], ",", " ", "14000"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "b4", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Keys", "[", "s4", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"Sort", "[", "b4", "]"}]}], ",", " ", 
     RowBox[{"Min", "[", 
      RowBox[{"Values", "[", "s4", "]"}], "]"}], ",", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Values", "[", "s4", "]"}], "]"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"59aa0b70-f888-482b-8509-e15964a1781f"],

