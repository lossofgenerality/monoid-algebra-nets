       0.15342460575502262`, 0.7830599790949564, 0.6021943875429379]]}, 
    "DefaultBoundaryStyle" -> Automatic, "DefaultChartBaseStyle" -> 
    Directive[
      RGBColor[1., 0.835, 0.25]], 
    "DefaultGraphicsInteraction" -> {
     "Version" -> 1.2, "TrackMousePosition" -> {True, False}, 
