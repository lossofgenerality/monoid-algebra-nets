       RowBox[{"L", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"syEPrinted", "[", 
      RowBox[{"n_", ",", " ", 
       RowBox[{"w", " ", ":", " ", 
        RowBox[{"{", 
         RowBox[{"L_", ",", " ", "p1_", ",", " ", "p2_"}], "}"}]}]}], "]"}], 
     " ", ":=", " ", 
     RowBox[{
      RowBox[{"syEPrinted", "[", 
       RowBox[{"n", ",", " ", "w"}], "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p1", " ", "+", " ", 
            RowBox[{"2", " ", "L", " ", "p2"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "n"}], " ", "-", " ", "1"}], ")"}], " ", 
          RowBox[{"syEPrinted", "[", 
           RowBox[{
            RowBox[{"n", " ", "-", " ", "1"}], ",", " ", "w"}], "]"}]}], " ", 
         "-", " ", 
         RowBox[{"p1", " ", 
          RowBox[{"(", 
           RowBox[{"n", " ", "-", " ", "2"}], ")"}], " ", 
          RowBox[{"syEPrinted", "[", 
           RowBox[{
            RowBox[{"n", " ", "-", " ", "2"}], ",", " ", "w"}], "]"}]}]}], 
        ")"}], "/", 
