            RowBox[{"NumberForm", "[", 
             RowBox[{"pg", ",", " ", "3"}], "]"}], "]"}], " ", "<>", 
           " ", "\"\<)\>\""}], ",", " ", 
          RowBox[{"pg", " ", ">", " ", "0.001"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{
          
          RowBox[{"\"\<the naive sampler is far from uniform (p = \>\"", " ", 
           "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{"pn", ",", " ", "2"}], "]"}], "]"}], " ", "<>", 
           " ", "\"\<)\>\""}], ",", " ", 
          RowBox[{"pn", " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
