     RowBox[{"the", " ", "integral", " ", "of", " ", "F", " ", 
      RowBox[{"G", "'"}], " ", "is", " ", "F", " ", "G", " ", "minus", " ", 
      RowBox[{"it", ".", "\n", "   ", "\"\<Known\>\""}], " ", 
