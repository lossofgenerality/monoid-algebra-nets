   RowBox[{
    RowBox[{
     RowBox[{"syEPrinted", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"L_", ",", " ", "p1_", ",", " ", "p2_"}], "}"}]}], "]"}], " ",
      ":=", " ", "L"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"syEPrinted", "[", 
