               "]"}], " ", "&"}]}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Union", "[", "good", "]"}], " ", "==", " ", 
            RowBox[{"Sort", "[", "all", "]"}]}]}]}], "]"}], ";", "\n", "   ", 
        
        RowBox[{"syCheck", "[", 
         RowBox[{
          
          RowBox[{"\"\<its counts are consistent with uniform (chi-square p = \
\>\"", " ", "<>", " ", 
