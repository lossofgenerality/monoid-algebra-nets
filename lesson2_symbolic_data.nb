   RowBox[{
    RowBox[{
     RowBox[{"syPart5", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"problem", " ", "=", " ", 
          RowBox[{"\[FormalX]", " ", 
           RowBox[{"Cos", "[", "\[FormalX]", "]"}]}]}], ",", " ", "hyps", ",",
          " ", "ok"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
        "sySection", 
         "[", "\"\<5. Checking a hypothesis instead of trusting it\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<Nothing stops the decoder from writing an invalid prefix \
sequence; such hypotheses are simply discarded. And an integral can be \
checked by differentiating it. So the paper verifies every hypothesis in the \
beam, not only the most likely one: 'beam size 10' means at least one of the \
10 was correct (Section 4.4). A constant of integration does not matter.\>\"",
          "]"}], ";", "\n", "   ", 
        RowBox[{"hyps", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<add\>\"", ",", " ", "\"\<mul\>\"", ",", 
             " ", "\"\<x\>\"", ",", " ", "\"\<sin\>\"", ",", " ", "\"\<x\>\"",
              ",", " ", "\"\<cos\>\"", ",", " ", "\"\<x\>\""}], "}"}], ",", 
           "\n", "     ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<add\>\"", ",", " ", "\"\<mul\>\"", ",", 
             " ", "\"\<x\>\"", ",", " ", "\"\<sin\>\"", ",", " ", "\"\<x\>\"",
              ",", " ", "\"\<add\>\"", ",", " ", "\"\<cos\>\"", ",", 
             " ", "\"\<x\>\"", ",", " ", "\"\<INT+\>\"", ",", 
             " ", "\"\<3\>\""}], "}"}], ",", "\n", "     ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<mul\>\"", ",", " ", "\"\<x\>\"", ",", 
             " ", "\"\<sin\>\"", ",", " ", "\"\<x\>\""}], "}"}], ",", "\n", 
           "     ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<add\>\"", ",", " ", "\"\<mul\>\"", ",", 
             " ", "\"\<x\>\"", ",", " ", "\"\<sin\>\""}], "}"}]}], "}"}]}], ";",
         "\n", "   ", 
        RowBox[{"ok", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"syVerifiedQ", "[", 
            RowBox[{"problem", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "hyps"}]}], ";", "\n", "   ", 
        RowBox[{"syShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Row", "[", 
                   RowBox[{"#", ",", " ", "\"\< \>\""}], "]"}], " ", "&"}], 
                 " ", "/@", " ", "hyps"}], ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"syValidQ", "[", "#", "]"}], ",", " ", 
                    RowBox[{"TraditionalForm", "[", 
                    RowBox[{"syParse", "[", "#", "]"}], "]"}], ",", 
                    " ", "\"\<invalid prefix\>\""}], "]"}], " ", "&"}], " ", "/@",
                  " ", "hyps"}], ",", " ", "ok"}], "}"}], "]"}], ",", "\n", 
             "      ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<hypothesis\>\"", ",", " ", "\"\<expression\>\"", ",",
                " ", "\"\<verified\>\""}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<for \[Integral] x cos x dx: x sin x + cos x and x sin x \
+ cos x + 3 are accepted; x sin x and an invalid sequence are rejected\>\"", ",",
           "\n", "    ", 
          RowBox[{"ok", " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{
            "True", ",", " ", "True", ",", " ", "False", ",", " ", "False"}], 
            "}"}]}]}], "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "Running"}]}]}]}]}], " ", "the", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lesson", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"syRun", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Quiet", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2019", "]"}], ";", " ", 
       RowBox[{"syReset", "[", "]"}], ";", "\n", "   ", 
       RowBox[{
       "syText", 
        "[", "\"\<Paper: G. Lample, F. Charton, Deep Learning for Symbolic \
Mathematics, ICLR 2020, arXiv:1912.01412. The model itself is a transformer \
(Lesson 3); the trained demo net is in \
ref2_symbolic_math_lample_charton2019.nb. This lesson codes the data \
side.\>\"", "]"}], ";", "\n", "   ", 
       RowBox[{"syPart1", "[", "]"}], ";", " ", 
       RowBox[{"syPart2", "[", "]"}], ";", " ", 
       RowBox[{"syPart3", "[", "]"}], ";", " ", 
       RowBox[{"syPart4", "[", "]"}], ";", " ", 
       RowBox[{"syPart5", "[", "]"}], ";", "\n", "   ", 
       RowBox[{
       "sySection", "[", "\"\<Where this is used in TensorNets\>\"", "]"}], ";",
        "\n", "   ", 
       RowBox[{
       "syText", 
        "[", "\"\<TensorNets writes trees in the same prefix notation (tnS, \
tnP, tnE, atoms), samples \:2a02/\:2a01 trees with the binary Algorithm 1 \
(Lesson 4), and checks every answer against an exact oracle (tnEquivalentQ), \
exactly as this paper checks integrals by differentiation.\>\"", "]"}], ";", 
       "\n", "   ", 
       RowBox[{"sySaveLog", "[", "]"}], ";", "\n", "   ", 
       RowBox[{"syAllPassQ", " ", "=", " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Values", "[", "syResults", "]"}], ",", " ", "TrueQ"}], 
         "]"}]}], ";"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", " ", 
       RowBox[{"TrueQ", "[", "sySkipRun", "]"}]}], ",", " ", 
      RowBox[{"syRun", "[", "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",Expressi\
