        RowBox[{
        "sySection", "[", "\"\<3. Sampling trees uniformly\>\"", "]"}], ";", 
        "\n", "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<A naive recursive generator (choose binary or unary with \
fixed probabilities, then split the remaining nodes at random) favours some \
shapes. The paper samples every tree with n internal nodes equally often, \
using D(e, n) (Appendix C, Algorithm 2):\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "syFormula", 
         "[", "\"\<P(next node at position k, unary)  = D(e\[Minus]k, n\
\[Minus]1) / D(e, n)\nP(next node at position k, binary) = D(e\[Minus]k+1, n\
\[Minus]1) / D(e, n),     k = 0 \[Ellipsis] e\[Minus]1\nthe k slots before it \
become leaves;  e \[LeftArrow] e\[Minus]k (unary)  or  e\[Minus]k+1 (binary); \
 n \[LeftArrow] n\[Minus]1\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"all", " ", "=", " ", 
         RowBox[{"syAllTrees", "[", "n", "]"}]}], ";", "\n", "   ", 
