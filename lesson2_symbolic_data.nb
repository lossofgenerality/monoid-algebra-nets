   RowBox[{
    RowBox[{
     RowBox[{"syPart4", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "bwd", ",", " ", "fwd", ",", " ", "len", ",", " ", "pool", ",", " ", 
         "k0", ",", " ", "k3", ",", " ", "ibp"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
        "sySection", 
         "[", "\"\<4. Making integration data: FWD, BWD and IBP\>\"", "]"}], ";",
         "\n", "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<Forward (FWD): draw a function and ask a computer algebra \
system for its integral. It is slow, and it only contains integrals that \
system can find. Backward (BWD): draw a function F and differentiate it; the \
pair (F', F) is always available and fast. Integration by parts (IBP): if the \
integral of F'G is already known, the integral of FG' is FG minus it, with no \
computer algebra system (Section 3).\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "syFormula", 
         "[", "\"\<\[Integral] F G' dx = F G \[Minus] \[Integral] F' G dx\>\"",
          "]"}], ";", "\n", "   ", 
        RowBox[{"bwd", " ", "=", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"syBWD", "[", "]"}], ",", " ", "60"}], "]"}], ",", " ", 
           "$Failed"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"fwd", " ", "=", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"syFWD", "[", "]"}], ",", " ", "30"}], "]"}], ",", " ", 
           "$Failed"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"len", "[", 
          RowBox[{"set_", ",", " ", "i_"}], "]"}], " ", ":=", " ", 
         RowBox[{"N", "@", 
          RowBox[{"Mean", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"syPrefix", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "&"}], " ",
             "/@", " ", "set"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"syShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<method\>\"", ",", " ", "\"\<pairs\>\"", ",", 
               " ", "\"\<mean problem length\>\"", ",", 
               " ", "\"\<mean solution length\>\""}], "}"}], ",", "\n", 
             "      ", 
             RowBox[{"{", 
              RowBox[{"\"\<FWD\>\"", ",", " ", 
               RowBox[{"Length", "[", "fwd", "]"}], ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"len", "[", 
                  RowBox[{"fwd", ",", " ", "1"}], "]"}], ",", " ", "3"}], 
                "]"}], ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"len", "[", 
                  RowBox[{"fwd", ",", " ", "2"}], "]"}], ",", " ", "3"}], 
                "]"}]}], "}"}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"\"\<BWD\>\"", ",", " ", 
               RowBox[{"Length", "[", "bwd", "]"}], ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"len", "[", 
                  RowBox[{"bwd", ",", " ", "1"}], "]"}], ",", " ", "3"}], 
                "]"}], ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"len", "[", 
                  RowBox[{"bwd", ",", " ", "2"}], "]"}], ",", " ", "3"}], 
                "]"}]}], "}"}]}], "}"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<every BWD pair is correct: differentiating the solution \
gives the problem\>\"", ",", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"bwd", ",", " ", 
            RowBox[{
             RowBox[{"syVerifiedQ", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{"syPrefix", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], " ", "&"}]}],
            "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<every FWD pair is correct as well\>\"", ",", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"fwd", ",", " ", 
            RowBox[{
             RowBox[{"syVerifiedQ", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{"syPrefix", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], " ", "&"}]}],
            "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<BWD problems are longer than their solutions on \
average, as the paper observes (Table 1)\>\"", ",", " ", 
          RowBox[{
           RowBox[{"len", "[", 
            RowBox[{"bwd", ",", " ", "1"}], "]"}], " ", ">", " ", 
           RowBox[{"len", "[", 
            RowBox[{"bwd", ",", " ", "2"}], "]"}]}]}], "]"}], ";", "\n", 
        "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<IBP from a small table. Start with the BWD pairs of a few \
functions, then apply integration by parts to every pair (F, G) of them, \
three times; each round can use what the previous round found.\>\"", "]"}], ";",
         "\n", "   ", 
        RowBox[{"pool", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"\[FormalX]", ",", " ", 
           RowBox[{"\[FormalX]", "^", "2"}], ",", " ", 
           RowBox[{"\[FormalX]", "^", "3"}], ",", " ", 
           RowBox[{"Sin", "[", "\[FormalX]", "]"}], ",", " ", 
           RowBox[{"Cos", "[", "\[FormalX]", "]"}], ",", " ", 
           RowBox[{"Exp", "[", "\[FormalX]", "]"}]}], "}"}]}], ";", "\n", 
        "   ", 
        RowBox[{"k0", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"#", ",", " ", "\[FormalX]"}], "]"}], ",", " ", "#"}], 
            "}"}], " ", "&"}], " ", "/@", " ", "pool"}]}], ";", "\n", "   ", 
        RowBox[{"k3", " ", "=", " ", 
         RowBox[{"Nest", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"syIBPRound", "[", 
             RowBox[{"#", ",", " ", "pool"}], "]"}], " ", "&"}], ",", " ", 
           "k0", ",", " ", "3"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"ibp", " ", "=", " ", 
         RowBox[{"Drop", "[", 
          RowBox[{"k3", ",", " ", 
           RowBox[{"Length", "[", "k0", "]"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"syShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"TraditionalForm", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
                 RowBox[{"TraditionalForm", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}],
               " ", "/@", " ", 
              RowBox[{"Take", "[", 
               RowBox[{"ibp", ",", " ", 
                RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<problem\>\"", ",", 
               " ", "\"\<solution found by IBP\>\""}], "}"}]}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{
          RowBox[{"\"\<IBP found \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"Length", "[", "ibp", "]"}], "]"}], " ", "<>", 
           " ", "\"\< new pairs, all correct, without calling \
Integrate\>\""}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "ibp", "]"}], " ", ">", " ", "0"}], " ", "&&",
            " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"ibp", ",", " ", 
             RowBox[{
              RowBox[{"syVerifiedQ", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"syPrefix", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], " ", 
              "&"}]}], "]"}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<among them the integral of x\.b3 sin x (up to sign), \
whose solution \[Minus]x\.b3 cos x + 3x\.b2 sin x + 6x cos x \[Minus] 6 sin x \
is the example in Section 3 of the paper\>\"", ",", "\n", "    ", 
          RowBox[{"AnyTrue", "[", 
           RowBox[{"ibp", ",", " ", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"Quiet", "@", 
                RowBox[{"Simplify", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[FormalX]", "^", "3"}], " ", 
                    RowBox[{"Sin", "[", "\[FormalX]", "]"}]}], ")"}]}], 
                 "]"}]}], ",", " ", "\[FormalX]"}], "]"}], " ", "&"}]}], 
           "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
