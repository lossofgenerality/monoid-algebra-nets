them\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"good", ",", " ", 
             RowBox[{
              RowBox[{"syValidQ", "[", 
               RowBox[{"#", " ", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"0", " ", "->", " ", "\"\<x\>\""}], ",", " ", 
                  RowBox[{"1", " ", "->", " ", "\"\<sin\>\""}], ",", " ", 
