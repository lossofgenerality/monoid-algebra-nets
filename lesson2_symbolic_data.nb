           "0"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"syShow", "[", 
         RowBox[{"BarChart", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"freq", "[", "good", "]"}], ",", " ", 
             RowBox[{"freq", "[", "naive", "]"}]}], "}"}], ",", " ", 
           RowBox[{"ChartLayout", " ", "->", " ", "\"\<Column\>\""}], ",", 
           " ", 
           RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", "\n", "      ", 
           
           RowBox[{"ChartLabels", " ", "->", " ", 
