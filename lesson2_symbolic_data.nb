                  " ", "1", ",", " ", "$Failed"}], "]"}]}], ";", "\n", 
              "     ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"syGoodQ", "[", "df", "]"}], ",", " ", 
                RowBox[{"Return", "[", 
