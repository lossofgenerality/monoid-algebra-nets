        RowBox[{"n", " ", "+", " ", "1"}], ")"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"syPart2", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "3", ",", " ", "2"}], "}"}]}], ",", " ", 
         RowBox[{"paper", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"11", ",", " ", "15", ",", " ", "4"}], "}"}]}]}], "}"}], ",",
        "\n", "   ", 
       RowBox[{
        RowBox[{
        "sySection", "[", "\"\<2. Counting trees and expressions\>\"", "]"}], 
        ";", "\n", "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<To sample fairly one must count. D(e, n) is the number of \
ways to complete a tree that still has e empty slots and n internal nodes to \
place: the first empty slot is a leaf, a unary node or a binary node \
(Appendix C).\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "syFormula", 
         "[", "\"\<D(0, n) = 0  (n > 0),    D(e, 0) = 1,    D(e, n) = D(e\
\[Minus]1, n) + D(e, n\[Minus]1) + D(e+1, n\[Minus]1)\nbinary trees only:  \
D(e, n) = D(e\[Minus]1, n) + D(e+1, n\[Minus]1)\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"syShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"n", ",", " ", 
                 RowBox[{"CatalanNumber", "[", "n", "]"}], ",", " ", 
                 RowBox[{"syDBin", "[", 
                  RowBox[{"1", ",", " ", "n"}], "]"}], ",", " ", 
                 RowBox[{"sySchroeder", "[", "n", "]"}], ",", " ", 
                 RowBox[{"syD", "[", 
                  RowBox[{"1", ",", " ", "n"}], "]"}], ",", " ", 
                 RowBox[{"Length", "[", 
                  RowBox[{"syAllTrees", "[", "n", "]"}], "]"}]}], "}"}], ",", 
               " ", 
               RowBox[{"{", 
                RowBox[{"n", ",", " ", "0", ",", " ", "7"}], "}"}]}], "]"}], ",",
              "\n", "      ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<n\>\"", ",", " ", "\"\<Catalan C\:2099\>\"", ",", 
               " ", "\"\<binary D(1,n)\>\"", ",", 
               " ", "\"\<Schr\[ODoubleDot]der S\:2099 (Eq. 1)\>\"", ",", 
               " ", "\"\<D(1,n)\>\"", ",", " ", "\"\<listed\>\""}], "}"}]}], 
            "]"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<binary D(1, n) equals the Catalan numbers, n = 0\
\[Ellipsis]12\>\"", ",", "\n", "    ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "12"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"syDBin", "[", 
               RowBox[{"1", ",", " ", "#"}], "]"}], " ", "==", " ", 
              RowBox[{"CatalanNumber", "[", "#", "]"}]}], " ", "&"}]}], 
           "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<unary-binary D(1, n) equals the large \
Schr\[ODoubleDot]der numbers of Equation 1, n = 0\[Ellipsis]12\>\"", ",", 
          "\n", "    ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "12"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"syD", "[", 
               RowBox[{"1", ",", " ", "#"}], "]"}], " ", "==", " ", 
              RowBox[{"sySchroeder", "[", "#", "]"}]}], " ", "&"}]}], "]"}]}],
          "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<and both equal the number of trees listed one by one, n \
= 0\[Ellipsis]7\>\"", ",", "\n", "    ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "7"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"syAllTrees", "[", "#", "]"}], "]"}], " ", "==", " ", 
              RowBox[{"syD", "[", 
               RowBox[{"1", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<Counting expressions rather than shapes: each leaf takes \
one of L values, each unary node one of p1 operators, each binary node one of \
p2. Weighting every listed tree by L^leaves p1^unary p2^binary gives the \
exact count, which the weighted D(e, n) also computes (start from D(e, 0) = \
L^e and multiply the three terms by L, p1 and p2).\>\"", "]"}], ";", "\n", 
        "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<Equation 2 of the paper, as printed, ends in \[Minus]p1(n\
\[Minus]2)E\:2099\:208b\:2082. Expanding (1 \[Minus] p1 z)\.b2 in the \
generating function of Appendix B gives p1\.b2 there. The two agree only when \
p1 is 0 or 1, the cases the paper checks against Equation 1 and the Catalan \
numbers. A count of every tree settles it:\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "syFormula", 
         "[", "\"\<corrected:  (n+1) E\:2099 = (p1 + 2 L p2)(2n\[Minus]1) E\
\:2099\:208b\:2081 \[Minus] p1\.b2 (n\[Minus]2) E\:2099\:208b\:2082,    E\
\:2080 = L,  E\:2081 = p1 L + p2 L\.b2\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"syShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"n", ",", " ", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", 
                    RowBox[{"Count", "[", 
                    RowBox[{"#", ",", " ", "0"}], "]"}]}], " ", 
                    RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "^", 
                    RowBox[{"Count", "[", 
                    RowBox[{"#", ",", " ", "1"}], "]"}]}], " ", 
                    RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "^", 
                    RowBox[{"Count", "[", 
                    RowBox[{"#", ",", " ", "2"}], "]"}]}]}], ")"}], " ", 
                    "&"}], " ", "/@", " ", 
                   RowBox[{"syAllTrees", "[", "n", "]"}]}], "]"}], ",", " ", 
                 RowBox[{"syE", "[", 
                  RowBox[{"n", ",", " ", "w"}], "]"}], ",", " ", 
                 RowBox[{"syEPrinted", "[", 
                  RowBox[{"n", ",", " ", "w"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"n", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",",
              "\n", "      ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<n\>\"", ",", 
               " ", "\"\<counted (L=4, p1=3, p2=2)\>\"", ",", 
               " ", "\"\<corrected Eq. 2\>\"", ",", 
               " ", "\"\<Eq. 2 as printed\>\""}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<the corrected Equation 2 equals the count of every \
tree, for L = 4, p1 = 3, p2 = 2 and n = 0\[Ellipsis]6\>\"", ",", "\n", "    ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "6"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"syE", "[", 
               RowBox[{"#", ",", " ", "w"}], "]"}], " ", "==", " ", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", 
                    RowBox[{"Count", "[", 
                    RowBox[{"#", ",", " ", "0"}], "]"}]}], " ", 
                   RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "^", 
                    RowBox[{"Count", "[", 
                    RowBox[{"#", ",", " ", "1"}], "]"}]}], " ", 
                   RowBox[{
                    RowBox[{"w", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "^", 
                    RowBox[{"Count", "[", 
                    RowBox[{"#", ",", " ", "2"}], "]"}]}]}], ")"}], " ", 
                 "&"}], " ", "/@", " ", 
                RowBox[{"syAllTrees", "[", "#", "]"}]}], "]"}], " ", "==", 
              " ", 
              RowBox[{"syDW", "[", 
               RowBox[{"1", ",", " ", "#", ",", " ", "w"}], "]"}]}], " ", 
             "&"}]}], "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<the printed form differs from the count when p1 = 3 \
(from n = 3 on)\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"syEPrinted", "[", 
             RowBox[{"3", ",", " ", "w"}], "]"}], " ", "!=", " ", 
            RowBox[{"syE", "[", 
             RowBox[{"3", ",", " ", "w"}], "]"}]}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"syEPrinted", "[", 
             RowBox[{"2", ",", " ", "w"}], "]"}], " ", "==", " ", 
            RowBox[{"syE", "[", 
             RowBox[{"2", ",", " ", "w"}], "]"}]}]}]}], "]"}], ";", "\n", 
        "   ", 
        RowBox[{"syCheck", "[", 
         RowBox[{"\"\<and the printed form is right when p1 = 1 (here L = 5, \
p2 = 3, n = 0\[Ellipsis]10)\>\"", ",", "\n", "    ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "10"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"syEPrinted", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"5", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], 
              " ", "==", " ", 
              RowBox[{"syE", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"5", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], 
              " ", "==", " ", 
              RowBox[{"syDW", "[", 
               RowBox[{"1", ",", " ", "#", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"5", ",", " ", "1", ",", " ", "3"}], "}"}]}], 
               "]"}]}], " ", "&"}]}], "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{
        "syText", 
         "[", "\"\<With the paper's settings (L = 11 leaves, p1 = 15 unary \
and p2 = 4 binary operators) the number of expressions grows very fast \
(corrected formula):\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"syShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"n", ",", " ", 
                 RowBox[{"ScientificForm", "[", 
                  RowBox[{
                   RowBox[{"N", "[", 
                    RowBox[{"syE", "[", 
                    RowBox[{"n", ",", " ", "paper"}], "]"}], "]"}], ",", " ", 
                   "3"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"n", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"5", ",", " ", "10", ",", " ", "15"}], "}"}]}], 
                "}"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<internal nodes n\>\"", ",", 
               " ", "\"\<expressions E\:2099\>\""}], "}"}]}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"syCheck", "[", 
