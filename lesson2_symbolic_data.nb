              "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "table"}], "}"}]}], "]"}], ";", "\n", "   ",
         "$Failed"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"syIBPRound", "[", 
      RowBox[{"table_", ",", " ", "pool_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"new", " ", "=", " ", "table"}], ",", " ", "known"}], "}"}], 
       ",", "\n", "   ", 
       RowBox[{
        RowBox[{"Do", "[", 
