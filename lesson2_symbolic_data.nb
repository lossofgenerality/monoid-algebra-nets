          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"F", " ", "=!=", " ", "G"}], ",", "\n", "     ", 
            RowBox[{
             RowBox[{"known", " ", "=", " ", 
              RowBox[{"syLookup", "[", 
