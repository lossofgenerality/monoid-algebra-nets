Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{
           RowBox[{"sin", "(", 
             SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[FormalX]", "+", 
              RowBox[{"cos", "(", 
                SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]}]], 
           " ", 
           RowBox[{"cos", "(", 
             RowBox[{"cos", "(", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"cos", "(", 
                  SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]], 
               ")"}], ")"}], " ", 
           RowBox[{"sin", "(", 
