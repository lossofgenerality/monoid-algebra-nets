Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{
           RowBox[{"sin", "(", 
             SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[FormalX]", "+", 
              RowBox[{"cos", "(", 
                SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]}]], 
           " ", 
           RowBox[{"cos", "(", 
             RowBox[{"cos", "(", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"cos", "(", 
                  SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]], 
               ")"}], ")"}], " ", 
           RowBox[{"sin", "(", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"cos", "(", 
                SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]], 
             ")"}]}], TraditionalForm], TraditionalForm, Editable -> True], 
       "\"  \[RightArrow]  \"", 
       TagBox[
        FormBox[
         RowBox[{"sin", "(", 
           RowBox[{"cos", "(", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"cos", "(", 
                SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]], 
             ")"}], ")"}], TraditionalForm], TraditionalForm, Editable -> 
        True], "\"      \"", "\"sin cos exp cos exp x\""},
      "RowDefault"]},
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{
           RowBox[{"4", " ", "\[FormalX]"}], "+", 
           RowBox[{"\[FormalX]", " ", 
             RowBox[{"(", 
               RowBox[{"-", 
                 RowBox[{"sin", "(", "\[FormalX]", ")"}]}], ")"}]}], "+", 
           RowBox[{"cos", "(", "\[FormalX]", ")"}], "+", "2"}], 
         TraditionalForm], TraditionalForm, Editable -> True], 
       "\"  \[RightArrow]  \"", 
       TagBox[
        FormBox[
         RowBox[{"\[FormalX]", " ", 
           RowBox[{"(", 
             RowBox[{
               RowBox[{"2", " ", "\[FormalX]"}], "+", 
               RowBox[{"cos", "(", "\[FormalX]", ")"}], "+", "2"}], ")"}]}], 
         TraditionalForm], TraditionalForm, Editable -> True], "\"      \"", 
       "\"mul x add INT+ 2 add mul INT+ 2 x cos x\""},
      "RowDefault"]},
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{"cos", "(", 
           RowBox[{"\[FormalX]", "+", "5"}], ")"}], TraditionalForm], 
        TraditionalForm, Editable -> True], "\"  \[RightArrow]  \"", 
       TagBox[
        FormBox[
         RowBox[{"sin", "(", 
           RowBox[{"\[FormalX]", "+", "5"}], ")"}], TraditionalForm], 
        TraditionalForm, Editable -> True], "\"      \"", 
       "\"sin add INT+ 5 x\""},
      "RowDefault"]},
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{"-", 
           RowBox[{"(", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{"2", " ", "\[FormalX]"}], "+", "1"}], ")"}], " ", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{
                  SuperscriptBox["\[FormalX]", "2"], "+", "\[FormalX]"}]], 
               " ", 
               RowBox[{"sin", "(", 
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                    SuperscriptBox["\[FormalX]", "2"], "+", "\[FormalX]"}]], 
                 ")"}]}], ")"}]}], TraditionalForm], TraditionalForm, 
        Editable -> True], "\"  \[RightArrow]  \"", 
       TagBox[
        FormBox[
         RowBox[{"cos", "(", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
              SuperscriptBox["\[FormalX]", "2"], "+", "\[FormalX]"}]], ")"}], 
         TraditionalForm], TraditionalForm, Editable -> True], "\"      \"", 
       "\"cos exp add x pow x INT+ 2\""},
      "RowDefault"]},
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{"6", " ", 
           RowBox[{"cos", "(", 
             RowBox[{"6", " ", "\[FormalX]"}], ")"}]}], TraditionalForm], 
