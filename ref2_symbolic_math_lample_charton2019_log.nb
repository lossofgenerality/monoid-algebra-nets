              RowBox[{"cos", "(", 
                SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]], 
             ")"}]}], TraditionalForm], TraditionalForm, Editable -> True], 
       "\"  \[RightArrow]  \"", 
       TagBox[
        FormBox[
         RowBox[{"sin", "(", 
           RowBox[{"cos", "(", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"cos", "(", 
                SuperscriptBox["\[ExponentialE]", "\[FormalX]"], ")"}]], 
             ")"}], ")"}], TraditionalForm], TraditionalForm, Editable -> 
        True], "\"      \"", "\"sin cos exp cos exp x\""},
      "RowDefault"]},
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{
           RowBox[{"4", " ", "\[FormalX]"}], "+", 
           RowBox[{"\[FormalX]", " ", 
             RowBox[{"(", 
               RowBox[{"-", 
                 RowBox[{"sin", "(", "\[FormalX]", ")"}]}], ")"}]}], "+", 
           RowBox[{"cos", "(", "\[FormalX]", ")"}], "+", "2"}], 
         TraditionalForm], TraditionalForm, Editable -> True], 
       "\"  \[RightArrow]  \"", 
       TagBox[
        FormBox[
         RowBox[{"\[FormalX]", " ", 
           RowBox[{"(", 
             RowBox[{
               RowBox[{"2", " ", "\[FormalX]"}], "+", 
               RowBox[{"cos", "(", "\[FormalX]", ")"}], "+", "2"}], ")"}]}], 
         TraditionalForm], TraditionalForm, Editable -> True], "\"      \"", 
       "\"mul x add INT+ 2 add mul INT+ 2 x cos x\""},
      "RowDefault"]},
    {
     TemplateBox[{
       TagBox[
        FormBox[
         RowBox[{"cos", "(", 
           RowBox[{"\[FormalX]", "+", "5"}], ")"}], TraditionalForm], 
        TraditionalForm, Editable -> True], "\"  \[RightArrow]  \"", 
       TagBox[
        FormBox[
         RowBox[{"sin", "(", 
