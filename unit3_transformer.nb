Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "1050624"}], "}"}]], "Output",\

 CellLabel->"Out[10]=",ExpressionUUID->"64a0b9dd-a6f5-4625-9791-b3ad94b088ba"],

Cell["\<\
Check: {True, True, True, 1050624}. The net from primitive layers equals \
multi-head attention from arrays (d = 16, h = 4), also with the causal mask; \
4(d\.b2 + d) parameters, the same for 1 head as for 4; 1 050 624 for the base \
model.\
\>", "Text",ExpressionUUID->"55bf88ed-65ac-492b-a198-72c46a763858"],

Cell["7. Positional encoding", "Section",ExpressionUUID->"6fb7c39c-baa5-4a04-b7aa-8d186327cac6"],

Cell["\<\
Attention by itself ignores word order, so a position code is added to each \
embedding (Section 3.5). Each pair of components is a sine and a cosine of \
the position, with wavelengths from 2\[Pi] to 10000 \[CenterDot] 2\[Pi]:\
\>", "Text",ExpressionUUID->"35b190eb-9fa3-4a93-93a5-bca9602423c4"],

Cell["\<\
PE(pos, 2i) = sin(pos / 10000^(2i/dmodel)),      PE(pos, 2i+1) = cos(pos / \
10000^(2i/dmodel))\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Times",
 FontSize->15,
 FontSlant->"Italic",ExpressionUUID->"395a208b-09c4-4261-9b30-823a956b8173"],

Cell["\<\
Take dmodel = 4 and pos = 1. For i = 0 the frequency is 1: PE = (sin 1, cos \
1) = (0.8415, 0.5403). For i = 1 it is 1/10000^(2/4) = 0.01: PE = (sin 0.01, \
cos 0.01) = (0.0100, 0.99995). So PE(1) = (0.8415, 0.5403, 0.0100, 0.99995): \
fast components tell nearby positions apart, slow ones tell distant ones \
apart.\
\>", "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.83, 0.34, 0.11],
 Background->RGBColor[
  1, 0.97, 0.92],ExpressionUUID->"37f96ac6-4e26-4141-a835-5d9ccd03f2eb"],

