Cell[TextData[{
 StyleBox["Fig. 2. ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.83, 0.34, 0.11]],
 "The mean largest softmax weight over 10 random keys. Without scaling it \
climbs towards 1 (one-hot) as d\:2096 grows; with scaling it stays near 0.3 \
for every d\:2096."
}], "Text",ExpressionUUID->"575460b8-83f7-477a-af7c-66f420dd54ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"55977", "ce4"}], "-", 
     RowBox[{"2", "f22"}], "-", 
     RowBox[{"44", "ce"}], "-", 
     RowBox[{"869", "b"}], "-", 
     RowBox[{
      RowBox[{
      "b2006ff434ff", " ", "\[CenterDot]", " ", "unit3_transformer", " ", "\[CenterDot]",
        " ", "cell"}], " ", "7", " ", "of", " ", 
      RowBox[{"24", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"58", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"sat", "[", 
      RowBox[{"[", 
       RowBox[{"4", ",", " ", "1"}], "]"}], "]"}], " ", ">", " ", "0.75"}], ",",
