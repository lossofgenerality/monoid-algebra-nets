Cell[TextData[{
 StyleBox["Fig. 4. ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.83, 0.34, 0.11]],
 "The position code of positions 0\[Dash]99 (across) in 64 dimensions (down). \
The first dimensions oscillate fast, the last ones hardly change."
}], "Text",ExpressionUUID->"5995c471-e8cc-4688-9809-99ba7bd26bb1"],

Cell["\<\
The reason given for sinusoids: for every offset k there is one fixed matrix \
M\:2096, a rotation in each pair of components, with PE(pos + k) = M\:2096 \
PE(pos) for every position. So \[OpenCurlyDoubleQuote]k places later\
\[CloseCurlyDoubleQuote] is a linear operation the net can learn.\
\>", "Text",ExpressionUUID->"0e00ca55-d962-4ad5-9b99-746e73702f6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"84461", "cb2"}], "-", 
     RowBox[{"72", "ba"}], "-", "4407", "-", 
     RowBox[{"9", "e5d"}], "-", 
     RowBox[{"8", 
      RowBox[{
      "f03e6428a6d", " ", "\[CenterDot]", " ", "unit3_transformer", " ", "\[CenterDot]",
        " ", "cell"}], " ", "13", " ", "of", " ", 
      RowBox[{"24", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"58", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"p100", " ", "=", " ", 
     RowBox[{"pe", "[", 
      RowBox[{"100", ",", " ", "64"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "5", ",", " ", "17"}], "}"}], ",", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"close", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"shiftMatrix", "[", 
              RowBox[{"s", ",", " ", "64"}], "]"}], " ", ".", " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"p100", "[", 
               RowBox[{"[", 
                RowBox[{"1", " ", ";;", " ", 
                 RowBox[{"100", " ", "-", " ", "s"}]}], "]"}], "]"}], "]"}]}],
             "]"}], ",", " ", 
           RowBox[{"p100", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", " ", "+", " ", "s"}], " ", ";;", " ", "100"}], 
             "]"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}], "]"}]}], "]"}]}], "]"}], ",", "\n", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dd", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"p100", "[", 
             RowBox[{"[", "p", "]"}], "]"}], " ", ".", " ", 
            RowBox[{"p100", "[", 
             RowBox[{"[", 
              RowBox[{"p", " ", "+", " ", "7"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "1", ",", " ", "90"}], "}"}]}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "dd", "]"}], " ", "-", " ", 
         RowBox[{"Min", "[", "dd", "]"}]}], " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}], ",", "\n", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pn", " ", "=", " ", 
          RowBox[{"NetInitialize", "@", 
           RowBox[{"peNet", "[", "64", "]"}]}]}], ",", " ", 
         RowBox[{"xx", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"12", ",", " ", "64"}], "}"}]}], "]"}]}]}], "}"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"close", "[", 
         RowBox[{
          RowBox[{"pn", "[", "xx", "]"}], ",", " ", 
          RowBox[{"xx", " ", "+", " ", 
           RowBox[{"pe", "[", 
            RowBox[{"12", ",", " ", "64"}], "]"}]}]}], "]"}], " ", "&&", " ", 
        
        RowBox[{"close", "[", 
         RowBox[{
          RowBox[{"pn", "[", 
           RowBox[{"xx", "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"xx", "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", "3"}], "]"}], "]"}], " ", "+", " ", 
           RowBox[{"pe", "[", 
            RowBox[{"3", ",", " ", "64"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
    "}"}]}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"45f0b5bd-2045-41f1-bf82-2cfc0c43b3a4"],

