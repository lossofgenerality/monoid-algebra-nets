Cell[TextData[{
 StyleBox["Fig. 3. ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.83, 0.34, 0.11]],
 "Attention weights with a causal mask, for 6 positions. Everything above the \
diagonal is exactly 0: no position looks ahead."
}], "Text",ExpressionUUID->"0d4a5ccb-bcb6-4330-bc0b-47eb62adcc86"],

