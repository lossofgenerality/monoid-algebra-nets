Cell["\<\
Check: {True, True, True}. Both layer nets equal their array versions, and \
the decoder is causal: output i does not change when a later output position \
changes.\
\>", "Text",ExpressionUUID->"9cbe3ba0-9a0e-4d89-acb5-7f7ec5194336"],

Cell["10. Shared embeddings, multiplied by \[Sqrt]dmodel", "Section",ExpressionUUID->"ba550446-5e98-423c-8178-06ea93db66df"],

Cell["\<\
The paper uses one weight matrix for the input embedding, the output \
embedding and the projection before the softmax, and multiplies the \
embeddings by \[Sqrt]dmodel (Section 3.4). In Wolfram the sharing is \
NetSharedArray: EmbeddingLayer stores a V \[Times] d matrix, and \
LinearLayer[V] on d-dimensional inputs stores a V \[Times] d matrix too, so \
one array serves both.\
\>", "Text",ExpressionUUID->"93877238-13eb-4b61-a53e-d70d8071bb2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"20", "b14262"}], "-", "9197", "-", 
     RowBox[{"4", "db5"}], "-", 
     RowBox[{"83", "d8"}], "-", 
     RowBox[{"9", 
      RowBox[{
      "fabfe93cf74", " ", "\[CenterDot]", " ", "unit3_transformer", " ", "\[CenterDot]",
        " ", "cell"}], " ", "17", " ", "of", " ", 
      RowBox[{"24", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"58", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"shared", " ", "=", " ", 
     RowBox[{"NetInitialize", "@", 
      RowBox[{"NetGraph", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<emb\>\"", " ", "->", " ", 
           RowBox[{"EmbeddingLayer", "[", 
            RowBox[{"8", ",", " ", "20", ",", " ", 
             RowBox[{"\"\<Weights\>\"", " ", "->", " ", 
              RowBox[{"NetSharedArray", "[", "\"\<W\>\"", "]"}]}]}], "]"}]}], 
          ",", " ", 
          RowBox[{"\"\<scale\>\"", " ", "->", " ", 
           RowBox[{"ElementwiseLayer", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Evaluate", "[", 
               RowBox[{"Sqrt", "[", "8.", "]"}], "]"}], " ", "#"}], " ", 
             "&"}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<out\>\"", " ", "->", " ", 
           RowBox[{"NetMapOperator", "[", 
            RowBox[{"LinearLayer", "[", 
             RowBox[{"20", ",", " ", 
              RowBox[{"\"\<Weights\>\"", " ", "->", " ", 
               RowBox[{"NetSharedArray", "[", "\"\<W\>\"", "]"}]}]}], "]"}], 
            "]"}]}]}], "|>"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<emb\>\"", " ", "->", " ", 
          RowBox[{"\"\<scale\>\"", " ", "->", " ", "\"\<out\>\""}]}], "}"}], ",",
         " ", 
        RowBox[{"\"\<Input\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Varying\>\"", ",", " ", 
           RowBox[{"Restricted", "[", 
            RowBox[{"\"\<Integer\>\"", ",", " ", "20"}], "]"}]}], "}"}]}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "@", 
       RowBox[{"NetExtract", "[", 
        RowBox[{"shared", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<emb\>\"", ",", " ", "\"\<Weights\>\""}], "}"}]}], 
        "]"}]}], " ", "==", " ", 
      RowBox[{"Normal", "@", 
       RowBox[{"NetExtract", "[", 
        RowBox[{"shared", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<out\>\"", ",", " ", "\"\<Net\>\"", ",", 
           " ", "\"\<Weights\>\""}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"Information", "[", 
      RowBox[{"shared", ",", " ", "\"\<ArraysTotalElementCount\>\""}], 
      "]"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"b489b91a-e7b8-4f5e-8b99-19e300f0dec9"],

