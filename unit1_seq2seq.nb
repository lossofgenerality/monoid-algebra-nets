         RowBox[{"-", "2."}], "}"}]}], ",", "\n", "   ", 
       RowBox[{"\"\<ForgetGateInputWeights\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "0.", "}"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ForgetGateStateWeights\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "0.", "}"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<ForgetGateBiases\>\"", " ", "->", " ", 
        RowBox[{"{", "bf", "}"}]}], ",", "\n", "   ", 
       RowBox[{"\"\<OutputGateInputWeights\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "0.", "}"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<OutputGateStateWeights\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "0.", "}"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<OutputGateBiases\>\"", " ", "->", " ", 
        RowBox[{"{", "5.", "}"}]}], ",", "\n", "   ", 
       RowBox[{"\"\<MemoryGateInputWeights\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "2.", "}"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<MemoryGateStateWeights\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "0.", "}"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<MemoryGateBiases\>\"", " ", "->", " ", 
        RowBox[{"{", "0.", "}"}]}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pulse", " ", "=", " ", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"{", "0.", "}"}], ",", " ", "24"}], "]"}], ",", " ", 
       RowBox[{"{", "1.", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
