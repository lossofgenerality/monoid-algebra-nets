          RowBox[{"zeroState", "[", "1", "]"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2", ",", " ", "1"}], "]"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"bf", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3.", ",", " ", "0.", ",", " ", 
           RowBox[{"-", "3."}]}], "}"}]}], "}"}]}], "]"}], ",", "\n", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<forget bias 3 (f = 0.95)\>\"", ",", 
        " ", "\"\<forget bias 0 (f = 0.5)\>\"", ",", 
