Cell["Check: {8, 8, 8, 1}.", "Text",ExpressionUUID->"7529d9d8-b534-405b-a007-ad1e8351d41e"],

Cell["7. The training recipe", "Section",ExpressionUUID->"ba11ca66-8ba9-49c2-9457-9e1d343cdf0b"],

Cell["7.1 Starting weights, and a Wolfram detail", "Subsection",ExpressionUUID->"0975ab05-4d3b-4940-9176-23b8b18af6b0"],

Cell["\<\
All parameters start uniformly distributed in [\[Minus]0.08, 0.08] (Section \
3.4). NetInitialize does this with one option, except that it always sets the \
LSTM forget-gate biases to 1, a later practice recommended by Jozefowicz, \
Zaremba and Sutskever (2015). To follow the paper, uniformInit (\[Section]1) \
resets those biases too.\
\>", "Text",ExpressionUUID->"8d48b087-1aec-4087-a72c-c84c7c16c510"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"17034447", "-", "9340", "-", 
     RowBox[{"4", "b00"}], "-", "b712", "-", 
     RowBox[{"9", 
      RowBox[{
      "d8d5801c751", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "14", " ", "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"40", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"plain", " ", "=", " ", 
     RowBox[{"NetInitialize", "[", 
      RowBox[{
       RowBox[{"NetChain", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"LongShortTermMemoryLayer", "[", "20", "]"}], "}"}], ",", 
         " ", 
         RowBox[{"\"\<Input\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Varying\>\"", ",", " ", "10"}], "}"}]}]}], "]"}], ",",
        " ", "All", ",", "\n", "   ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Random\>\"", ",", " ", 
          RowBox[{"\"\<Weights\>\"", " ", "->", " ", 
           RowBox[{"UniformDistribution", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.08"}], ",", " ", "0.08"}], "}"}], "]"}]}], ",", 
          " ", 
          RowBox[{"\"\<Biases\>\"", " ", "->", " ", 
           RowBox[{"UniformDistribution", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.08"}], ",", " ", "0.08"}], "}"}], "]"}]}]}], 
         "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paper", " ", "=", " ", 
     RowBox[{"uniformInit", "[", 
      RowBox[{"NetChain", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"LongShortTermMemoryLayer", "[", "20", "]"}], ",", " ", 
          RowBox[{"LongShortTermMemoryLayer", "[", "20", "]"}]}], "}"}], ",", 
        " ", 
        RowBox[{"\"\<Input\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Varying\>\"", ",", " ", "10"}], "}"}]}]}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Normal", "@", 
        RowBox[{"NetExtract", "[", 
         RowBox[{"plain", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "\"\<ForgetGateBiases\>\""}], "}"}]}], 
         "]"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"Max", "@", 
       RowBox[{"Abs", "@", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"paper", ",", " ", 
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "a"}], "}"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "gates"}], "}"}]}], "]"}]}]}]}], " ", "<=",
       " ", "0.08"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"1bc9f0d3-1022-477d-bd09-f28737b4399e"],

