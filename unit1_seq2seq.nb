Cell["Check: True.", "Text",ExpressionUUID->"3992ecc2-86da-4c4e-981f-52a1921c8566"],

Cell["3.3 The forget gate sets how long memory lasts", "Subsection",ExpressionUUID->"28e9747a-1ddb-4419-9f88-5cc16fa21fbd"],

Cell["\<\
A one-cell LSTM reads a single pulse, x = 1 at step 1 and 0 afterwards. Only \
the forget-gate bias changes between the three curves. With f = \[Sigma](3) = \
0.95 the memory fades slowly; with f = \[Sigma](\[Minus]3) = 0.05 it is gone \
after two steps.\
\>", "Text",ExpressionUUID->"cdaa3af7-0005-411c-abeb-133e41fa0022"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"ba025d43", "-", "5797", "-", 
     RowBox[{"405", "b"}], "-", "b727", "-", 
     RowBox[{
      RowBox[{
      "a098801b90e4", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "6", " ", "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"40", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pulseCell", "[", "bf_", "]"}], " ", ":=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<InputGateInputWeights\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "5.", "}"}], "}"}]}], ",", " ", 
