      "dda52ab1d0c0", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "3", " ", "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"40", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"w1", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
