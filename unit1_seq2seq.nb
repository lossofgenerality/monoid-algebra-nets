          RowBox[{
           RowBox[{"weightsOf", "[", "layer", "]"}], ",", " ", "xs", ",", " ", 
           RowBox[{"{", 
            RowBox[{"h0", ",", " ", "c0"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
