    RowBox[{"h0", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "6"}], "]"}]}],
     ";", " ", 
    RowBox[{"c0", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "6"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"out", " ", "=", " ", 
     RowBox[{
      RowBox[{"withStates", "[", "layer", "]"}], "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Input\>\"", " ", "->", " ", "xs"}], ",", " ", 
        RowBox[{"\"\<h0\>\"", " ", "->", " ", "h0"}], ",", " ", 
        RowBox[{"\"\<c0\>\"", " ", "->", " ", "c0"}]}], "|>"}], "]"}]}], 
    ";"}], "\n", 
