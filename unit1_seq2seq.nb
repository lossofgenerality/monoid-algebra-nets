Cell["\<\
Check: greedy gives {<s>, A, <e>} with probability 0.24; the beam of width 2 \
gives {<s>, B, <e>} with 0.38.\
\>", "Text",ExpressionUUID->"63a7339f-c81a-4369-9b23-502f7bd1af74"],

