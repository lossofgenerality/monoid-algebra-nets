Cell["Check: {{0.1743}, {0.2877}}, the h\[Prime] and c\[Prime] computed by \
hand.", "Text",ExpressionUUID->"7add3a50-3e21-4f82-919b-7763ab5c1fd3"],

Cell["3.2 The same cell as Wolfram\[CloseCurlyQuote]s layer", "Subsection",ExpressionUUID->"b939c1c5-0146-4663-b1c5-be320becb0f1"],

Cell["\<\
LongShortTermMemoryLayer stores exactly these twelve arrays: InputGate\
\[Ellipsis], ForgetGate\[Ellipsis], OutputGate\[Ellipsis] and MemoryGate\
\[Ellipsis] (Wolfram calls g the memory gate). Copy them out of a random \
layer and run our lstmStep over a sequence; the hidden states must agree.\
\>", "Text",ExpressionUUID->"ec202689-47b7-4069-9a4a-4a65d8f26eb9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"f3ef1c87", "-", "e68c", "-", 
     RowBox[{"401", "f"}], "-", 
     RowBox[{"8", "eb6"}], "-", 
     RowBox[{
      RowBox[{
      "e2969f9d828f", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "4", " ", "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"40", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"layer", " ", "=", " ", 
     RowBox[{"NetInitialize", "@", 
      RowBox[{"LongShortTermMemoryLayer", "[", 
       RowBox[{"6", ",", " ", 
        RowBox[{"\"\<Input\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Varying\>\"", ",", " ", "4"}], "}"}]}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"xs", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"7", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Max", "@", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"lstmRun", "[", 
         RowBox[{
          RowBox[{"weightsOf", "[", "layer", "]"}], ",", " ", "xs", ",", " ", 
          
          RowBox[{"zeroState", "[", "6", "]"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
       RowBox[{"layer", "[", "xs", "]"}]}], "]"}]}], " ", "<", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "5"}]}]}]}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"c35f202b-945c-4217-9feb-33afdeba6b82"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]=",ExpressionUUID->"f98d8f9d-a72d-49c3-a138-0293370bc4f9"],

Cell["\<\
Check: True (7 steps, 4 inputs, 6 cells). The layer can also start from given \
states, as the decoder must; its ports State and CellState are h and c, \
reached through NetGraph (withStates in \[Section]1):\
\>", "Text",ExpressionUUID->"c7c1a84e-a1a8-4c38-ad4a-da5f232fe20a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{
     RowBox[{"2", "c31d887"}], "-", "d4f1", "-", 
     RowBox[{"40", "fb"}], "-", 
     RowBox[{"88", "eb"}], "-", 
     RowBox[{
      RowBox[{
      "e8e1208a9b1f", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "5", " ", "of", " ", 
