Cell["\<\
Check: {0.7, 0.35, 0.175, 0.021875}; the last half epoch runs at 0.7/32.\
\>", "Text",ExpressionUUID->"161d8afa-b5f6-484b-8dfc-ad7252b5d3be"],

Cell["8. Beam search", "Section",ExpressionUUID->"28e1d30a-ede4-4f98-aa3b-6af5ee76a0c6"],

Cell["\<\
To write, the decoder must choose words. Greedy decoding takes the most \
likely word at each step. Beam search keeps the B most likely partial outputs \
instead: each is extended by every word, and the B best of all the extensions \
are kept. A hypothesis that ends in <EOS> leaves the beam and joins the \
finished list. The paper finds that B = 1 already works well and that B = 2 \
gives most of the benefit (Section 3.2).\
\>", "Text",ExpressionUUID->"dd651b1c-497b-4e63-b677-276b09a53432"],

Cell["8.1 Worked by hand: a model where greedy goes wrong", "Subsection",ExpressionUUID->"bf6ab79a-b6e2-44cd-8f06-cbcd8ff17316"],

Cell["\<\
A toy model writes A (0.6) or B (0.4) first. After A it hesitates: A 0.3, B \
0.3, <e> 0.4. After B it almost always stops: <e> 0.95. Greedy takes A (0.6), \
then <e> (0.4): the output \[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote] \
has probability 0.6 \[Times] 0.4 = 0.24. A beam of width 2 keeps both A and B \
after step 1. At step 2 the six extensions have probabilities A<e> 0.24, AA \
0.18, AB 0.18, B<e> 0.38, BA 0.01, BB 0.01. The best two, B<e> and A<e>, are \
both finished, and B<e> wins with 0.38.\
\>", "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.83, 0.34, 0.11],
 Background->RGBColor[
  1, 0.97, 0.92],ExpressionUUID->"bb255c5d-d3bb-4818-9602-d9eee480915e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"eca20ce8", "-", "8002", "-", 
     RowBox[{"4", "b5a"}], "-", 
     RowBox[{"95", "e1"}], "-", 
     RowBox[{"906", 
      RowBox[{
      "f54ce835e", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "18", " ", "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"40", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"toy", "[", "prefix_List", "]"}], " ", ":=", " ", 
     RowBox[{"Log", " ", "/@", " ", 
      RowBox[{"Switch", "[", 
       RowBox[{
        RowBox[{"Last", "[", "prefix", "]"}], ",", " ", "\"\<<s>\>\"", ",", 
        " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<A\>\"", " ", "->", " ", "0.6"}], ",", " ", 
          RowBox[{"\"\<B\>\"", " ", "->", " ", "0.4"}]}], "|>"}], ",", "\n", 
        "    ", "\"\<A\>\"", ",", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<A\>\"", " ", "->", " ", "0.3"}], ",", " ", 
          RowBox[{"\"\<B\>\"", " ", "->", " ", "0.3"}], ",", " ", 
          RowBox[{"\"\<<e>\>\"", " ", "->", " ", "0.4"}]}], "|>"}], ",", 
        " ", "\"\<B\>\"", ",", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<A\>\"", " ", "->", " ", "0.025"}], ",", " ", 
          RowBox[{"\"\<B\>\"", " ", "->", " ", "0.025"}], ",", " ", 
          RowBox[{"\"\<<e>\>\"", " ", "->", " ", "0.95"}]}], "|>"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"First", "@", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"Exp", "@", 
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"beam", "[", 
       RowBox[{
       "toy", ",", " ", "\"\<<s>\>\"", ",", " ", "\"\<<e>\>\"", ",", " ", "1",
         ",", " ", "6"}], "]"}], ",", " ", 
      RowBox[{"beam", "[", 
       RowBox[{
       "toy", ",", " ", "\"\<<s>\>\"", ",", " ", "\"\<<e>\>\"", ",", " ", "2",
         ",", " ", "6"}], "]"}]}], "}"}]}]}]}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"d558738f-d42a-46be-a105-087395e286d1"],

