Cell[TextData[{
 StyleBox["Fig. 2. ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.83, 0.34, 0.11]],
 "The memory c of a one-cell LSTM after one input pulse. After the pulse c is \
multiplied by f at every step, so it decays like f\:1d57."
}], "Text",ExpressionUUID->"0fda3956-0bcb-49aa-8749-a3d218f2fef8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"67878510", "-", "ea4f", "-", 
     RowBox[{"48", "e4"}], "-", "afdf", "-", 
     RowBox[{"8", 
      RowBox[{
      "b358b19d844", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "7", " ", "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"40", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", " ", "=", " ", 
      RowBox[{
       RowBox[{"lstmRun", "[", 
        RowBox[{
         RowBox[{"pulseCell", "[", "3.", "]"}], ",", " ", "pulse", ",", " ", 
         RowBox[{"zeroState", "[", "1", "]"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2", ",", " ", "1"}], "]"}], "]"}]}], "}"}], 
    ",", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "/", 
        RowBox[{"c", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
       RowBox[{"\[Sigma]", "[", "3.", "]"}]}], "]"}], " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"7ad34247-27fb-4e41-9b55-d0acfe8a9b25"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[7]=",ExpressionUUID->"d05b0920-1bc5-4efd-a563-e90ff27069d8"],

Cell["\<\
Check: True. After the pulse the ratio of successive memories is exactly f = \
\[Sigma](3) = 0.9526.\
\>", "Text",ExpressionUUID->"2b2e5155-28fb-418c-8dc2-fb73a6cbe9ff"],

Cell["4. A deep encoder and its thought vector", "Section",ExpressionUUID->"c2259d75-5c89-49bf-bf3f-accd024e546e"],

Cell["\<\
The paper stacks four LSTMs. Layer k reads the hidden states of layer k \
\[Minus] 1, so higher layers see a more processed sentence. After the last \
source word, the final (h, c) of every layer is kept: that is the thought \
vector, 2 \[Times] 4 \[Times] 1000 = 8000 numbers in the paper\
\[CloseCurlyQuote]s model.\
\>", "Text",ExpressionUUID->"4fbf0dc1-0769-40c9-b85f-acecc8b80a5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"id", ":", " ", 
    RowBox[{"f2068ac8", "-", "8223", "-", 
     RowBox[{"48", "e7"}], "-", "8831", "-", 
     RowBox[{"5", 
      RowBox[{
      "abb0cf3054b", " ", "\[CenterDot]", " ", "unit1_seq2seq", " ", "\[CenterDot]",
        " ", "cell"}], " ", "8", " ", "of", " ", 
      RowBox[{"21", " ", "\[CenterDot]", " ", "updated"}], " ", "2026"}], "-",
      "11", "-", 
     RowBox[{"24", " ", "06"}]}], ":", 
    RowBox[{"40", " ", "UTC"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chain", " ", "=", " ", 
     RowBox[{"NetInitialize", "@", 
      RowBox[{"NetChain", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"LongShortTermMemoryLayer", "[", "5", "]"}], ",", " ", 
          RowBox[{"LongShortTermMemoryLayer", "[", "5", "]"}], ",", " ", 
          RowBox[{"LongShortTermMemoryLayer", "[", "5", "]"}]}], "}"}], ",", 
        " ", 
        RowBox[{"\"\<Input\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Varying\>\"", ",", " ", "3"}], "}"}]}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"src", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"enc", " ", "=", " ", 
     RowBox[{"deepRun", "[", 
      RowBox[{
       RowBox[{"weightsOf", " ", "/@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"NetExtract", "[", 
           RowBox[{"chain", ",", " ", "k"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", "src"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Max", "@", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"enc", "[", "\"\<Outputs\>\"", "]"}], " ", "-", " ", 
         RowBox[{"chain", "[", "src", "]"}]}], "]"}]}], " ", "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "5"}]}]}], ",", " ", 
     RowBox[{"Length", "@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"enc", "[", "\"\<FinalStates\>\"", "]"}], "]"}]}], ",", " ", 
     RowBox[{"2", "*", "4", "*", "1000"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"aedc2e05-defc-4ca8-bbb5-0a7ce08a36c4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "30", ",", "8000"}], "}"}]], "Output",
 CellLabel->"Out[8]=",ExpressionUUID->"e20b2b8e-81d7-4d5b-80f8-056cd160f929"],

Cell["\<\
Check: {True, 30, 8000}. Our three-layer stack equals NetChain of three \
LongShortTermMemoryLayers; its thought vector has 2 \[Times] 3 \[Times] 5 = \
30 numbers; the paper\[CloseCurlyQuote]s has 8000.\
\>", "Text",ExpressionUUID->"14f50fac-3ef2-449c-b806-ec69150d6ce7"],

Cell["5. The decoder", "Section",ExpressionUUID->"c3c21d19-02d1-4030-9b79-014c8d3e602e"],

Cell["\<\
The decoder is a second deep LSTM with its own weights. Its layers start from \
the encoder\[CloseCurlyQuote]s final states. At each step it reads the \
embedding of the previous word, and a softmax over the target vocabulary \
turns its top hidden state into probabilities for the next word.\
\>", "Text",ExpressionUUID->"23ad33d3-d376-4236-92d1-712b4bdee5a4"],

Cell["p(next word = k) = exp(z_k) / \[CapitalSigma]\:2c7c exp(z_j),    z = W \
h + b", "Text",
 TextAlignment->Center,
 FontFamily->"Times",
 FontSize->15,
 FontSlant->"Italic",ExpressionUUID->"0cb12acc-b534-4174-9162-f38429d608c5"],

Cell["5.1 Worked by hand: a softmax", "Subsection",ExpressionUUID->"30ab52dc-2c31-499d-85dc-8b2b25b720b3"],

Cell["\<\
For scores z = (2, 1, 0): e\.b2 = 7.389, e\.b9 = 2.718, e\:2070 = 1, total \
11.107. The probabilities are 7.389/11.107 = 0.665, 2.718/11.107 = 0.245 and \
1/11.107 = 0.090. They are positive and sum to 1; adding the same number to \
every score changes nothing.\
\>", "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.83, 0.34, 0.11],
 Background->RGBColor[
  1, 0.97, 0.92],ExpressionUUID->"83ad7093-ecb2-4d95-9c1b-e2b964f852b4"],

