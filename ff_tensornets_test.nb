     RowBox[{"\"\<Worked examples\>\"", ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"tnSimplify", "[", 
          RowBox[{"\"\<(a\:2a01b)\:2a02c\>\"", ",", " ", "\"\<Expand\>\""}], 
          "]"}], "[", "\"\<Result\>\"", "]"}], " ", "===", 
        " ", "\"\<a \:2a02 c \:2a01 b \:2a02 c\>\""}], " ", "&&", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"tnSimplify", "[", 
          RowBox[{"\"\<(V\[CirclePlus]W)^2\>\"", ",", " ", "\"\<Expand\>\""}],
           "]"}], "[", "\"\<Result\>\"", "]"}], " ", "===", 
        " ", "\"\<V \:2a02 V \:2a01 V \:2a02 W \:2a01 W \:2a02 V \:2a01 W \
\:2a02 W\>\""}], " ", "&&", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"tnSimplify", "[", 
          
          RowBox[{"\"\<a\:2a02b \:2a01 a\:2a02c\>\"", ",", 
           " ", "\"\<Factor\>\""}], "]"}], "[", "\"\<Result\>\"", "]"}], " ", 
        "===", " ", "\"\<a \:2a02 (b \:2a01 c)\>\""}], " ", "&&", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"tnSimplify", "[", 
          
          RowBox[{"\"\<(V\[CirclePlus]W)\:2a02(V\[CirclePlus]W) \:2a02 \
\|01d7d9 \:2a01 0\>\"", ",", " ", "\"\<Simplify\>\""}], "]"}], 
         "[", "\"\<Result\>\"", "]"}], " ", "===", 
        " ", "\"\<(V \:2a01 W)^2\>\""}], " ", "&&", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"tnEvaluate", "[", 
          RowBox[{"\"\<(V\:2a01W)^2\>\"", ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<V\>\"", " ", "->", " ", "2"}], ",", " ", 
             RowBox[{"\"\<W\>\"", " ", "->", " ", "3"}]}], "|>"}]}], "]"}], "[", 
         RowBox[{"\"\<Exact\>\"", ",", " ", "\"\<Dimension\>\""}], "]"}], " ",
         "===", " ", "25"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Without nets everything falls back to the oracles\>\"", ",",
       "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"tnParse", "[", "\"\<(a\:2a01b)\:2a02c\>\"", "]"}], 
         "[", "\"\<Method\>\"", "]"}], " ", "===", " ", "\"\<Reference\>\""}],
        " ", "&&", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"tnSimplify", "[", 
          RowBox[{"\"\<(a\:2a01b)\:2a02c\>\"", ",", " ", "\"\<Expand\>\""}], 
          "]"}], "[", "\"\<Method\>\"", "]"}], " ", "===", 
        " ", "\"\<Oracle\>\""}]}]}], "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"4.", " ", 
      RowBox[{"nets", ":", " ", 
       RowBox[{"small", " ", "sizes"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"only", " ", "to", " ", "prove", " ", "the", " ", "wiring"}], ";",
       " ", 
      RowBox[{"full", " ", "sizes", " ", "are", " ", 
       RowBox[{"tnTrainAll", "[", "]"}], " ", "defaults"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t0", " ", "=", " ", 
     RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tnTrainAll", "[", 
     RowBox[{
      RowBox[{"\"\<Examples\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"3000", ",", " ", "2000", ",", " ", "1000"}], "}"}]}], ",", 
      " ", 
      RowBox[{"\"\<Rounds\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<Size\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"32", ",", " ", "2", ",", " ", "1"}], "}"}]}]}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"trainSeconds", " ", "=", " ", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Three nets trained, with inference ports only\>\"", ",", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "tnParserNet", ",", " ", "tnPolicyNet", ",", " ", "tnValueNet"}], 
          "}"}], ",", " ", "tnNetQ"}], "]"}], " ", "&&", "\n", "   ", 
       RowBox[{
        RowBox[{"Information", "[", 
         RowBox[{"tnParserNet", ",", " ", "\"\<InputPortNames\>\""}], "]"}], 
        " ", "===", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Input\>\"", ",", " ", "\"\<Target\>\""}], "}"}]}], " ", 
       "&&", " ", 
       RowBox[{
        RowBox[{"Information", "[", 
         RowBox[{"tnParserNet", ",", " ", "\"\<OutputPortNames\>\""}], "]"}], 
        " ", "===", " ", 
        RowBox[{"{", "\"\<Probabilities\>\"", "}"}]}], " ", "&&", "\n", "   ", 
       RowBox[{
        RowBox[{"Information", "[", 
         RowBox[{"tnPolicyNet", ",", " ", "\"\<InputPortNames\>\""}], "]"}], 
        " ", "===", " ", 
        RowBox[{"{", "\"\<Input\>\"", "}"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Information", "[", 
         RowBox[{"tnPolicyNet", ",", " ", "\"\<OutputPortNames\>\""}], "]"}], 
        " ", "===", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<RuleProb\>\"", ",", " ", "\"\<NodeProb\>\""}], "}"}]}], 
       " ", "&&", "\n", "   ", 
       RowBox[{
        RowBox[{"Information", "[", 
         RowBox[{"tnValueNet", ",", " ", "\"\<InputPortNames\>\""}], "]"}], 
        " ", "===", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Input\>\"", ",", " ", "\"\<Dims\>\""}], "}"}]}], " ", "&&",
        " ", 
       RowBox[{
        RowBox[{"Information", "[", 
         RowBox[{"tnValueNet", ",", " ", "\"\<OutputPortNames\>\""}], "]"}], 
        " ", "===", " ", 
        RowBox[{"{", "\"\<Estimate\>\"", "}"}]}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Net decoding always yields a well-formed tree\>\"", ",", 
      "\n", "  ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t", " ", "=", " ", 
              RowBox[{"tnRandomTree", "[", 
               RowBox[{
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "4"}], "}"}], "]"}]}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{"!", " ", 
             RowBox[{"FailureQ", "[", 
              RowBox[{
               RowBox[{"tnParse", "[", 
                RowBox[{
                 RowBox[{"tnRender", "[", 
                  RowBox[{"t", ",", " ", 
                   RowBox[{"tnRandomNames", "[", 
                    RowBox[{"tnAtomCount", "[", "t", "]"}], "]"}]}], "]"}], ",",
                  " ", 
                 RowBox[{"Method", " ", "->", " ", "\"\<Net\>\""}]}], "]"}], 
               "[", "\"\<Tree\>\"", "]"}], "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", "100", "}"}]}], "]"}], ",", " ", "TrueQ"}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Automatic parsing always returns the correct tree (net \
checked against the reference)\>\"", ",", "\n", "  ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t", " ", "=", " ", 
              RowBox[{"tnRandomTree", "[", 
               RowBox[{
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "4"}], "}"}], "]"}]}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"tnParse", "[", 
               RowBox[{"tnRender", "[", 
                RowBox[{"t", ",", " ", 
                 RowBox[{"tnRandomNames", "[", 
                  RowBox[{"tnAtomCount", "[", "t", "]"}], "]"}]}], "]"}], 
               "]"}], "[", "\"\<Tree\>\"", "]"}], " ", "===", " ", "t"}]}], 
           "]"}], ",", " ", 
          RowBox[{"{", "100", "}"}]}], "]"}], ",", " ", "TrueQ"}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Net-driven Expand is always complete and verified\>\"", ",",
       "\n", "  ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"tnSimplify", "[", 
               RowBox[{
                RowBox[{"tnRandomTree", "[", 
                 RowBox[{
                  RowBox[{"RandomInteger", "[", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
                  RowBox[{"RandomInteger", "[", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "3"}], "}"}], "]"}]}], "]"}], ",", 
                " ", "\"\<Expand\>\"", ",", " ", 
                RowBox[{"Method", " ", "->", " ", "\"\<Net\>\""}]}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{
             RowBox[{"r", "[", "\"\<Complete\>\"", "]"}], " ", "&&", " ", 
             RowBox[{"r", "[", "\"\<Verified\>\"", "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", "100", "}"}]}], "]"}], ",", " ", "TrueQ"}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Net-driven Factor and Simplify are always verified\>\"", ",",
       "\n", "  ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t", " ", "=", " ", 
              RowBox[{"tnRandomTree", "[", 
               RowBox[{
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "3"}], "}"}], "]"}]}], "]"}]}], 
             "}"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"tnSimplify", "[", 
               RowBox[{
                RowBox[{"tnRunOracle", "[", 
                 RowBox[{"t", ",", " ", "\"\<Expand\>\""}], "]"}], ",", 
                " ", "\"\<Factor\>\"", ",", " ", 
                RowBox[{"Method", " ", "->", " ", "\"\<Net\>\""}]}], "]"}], 
              "[", "\"\<Verified\>\"", "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"tnSimplify", "[", 
               RowBox[{"t", ",", " ", "\"\<Simplify\>\"", ",", " ", 
                RowBox[{"Method", " ", "->", " ", "\"\<Net\>\""}]}], "]"}], 
              "[", "\"\<Verified\>\"", "]"}]}]}], "]"}], ",", " ", 
          RowBox[{"{", "100", "}"}]}], "]"}], ",", " ", "TrueQ"}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Value net gives an estimate beside the exact dimension\>\"",
       ",", "\n", "  ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", " ", "=", " ", 
          RowBox[{"tnEvaluate", "[", 
           RowBox[{"\"\<(V\:2a01W)^2\:2a02U\>\"", ",", " ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<V\>\"", " ", "->", " ", "2"}], ",", " ", 
              RowBox[{"\"\<W\>\"", " ", "->", " ", "3"}], ",", " ", 
              RowBox[{"\"\<U\>\"", " ", "->", " ", "4"}]}], "|>"}]}], "]"}]}],
          "}"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"e", "[", 
           RowBox[{"\"\<Exact\>\"", ",", " ", "\"\<Dimension\>\""}], "]"}], 
          " ", "===", " ", "100"}], " ", "&&", " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"e", "[", 
           RowBox[{"\"\<NetEstimate\>\"", ",", " ", "\"\<Dimension\>\""}], 
           "]"}], "]"}]}]}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<tnSolve exports to JSON\>\"", ",", " ", 
      RowBox[{"StringQ", "[", 
       RowBox[{"ExportString", "[", 
        RowBox[{
         RowBox[{"tnSolve", "[", 
          
          RowBox[{"\"\<(a\:2a01b)\:2a02c \:2a01 a\:2a02d\>\"", ",", 
           " ", "\"\<Simplify\>\"", ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}], ",", " ", 
             RowBox[{"\"\<b\>\"", " ", "->", " ", "3"}], ",", " ", 
             RowBox[{"\"\<c\>\"", " ", "->", " ", "4"}], ",", " ", 
             RowBox[{"\"\<d\>\"", " ", "->", " ", "5"}]}], "|>"}]}], "]"}], ",",
          " ", "\"\<JSON\>\""}], "]"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<tnAPI answers\>\"", ",", " ", 
      RowBox[{"!", " ", 
       RowBox[{"FailureQ", "[", 
        RowBox[{"tnAPI", "[", 
         RowBox[{"<|", 
          RowBox[{
           
           RowBox[{"\"\<expr\>\"", " ", "->", 
            " ", "\"\<(a\:2a01b)\:2a02c\>\""}], ",", " ", 
           RowBox[{"\"\<goal\>\"", " ", "->", " ", "\"\<Expand\>\""}], ",", 
           " ", 
           RowBox[{"\"\<dims\>\"", " ", "->", " ", "\"\<a=2,b=3,c=4\>\""}]}], 
          "|>"}], "]"}], "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"5.", " ", "log", " ", "notebook"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"tnLog", "[", 
     RowBox[{"\"\<Tests\>\"", ",", " ", 
      RowBox[{"Dataset", "[", "T", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tnLog", "[", 
     RowBox[{"\"\<Training time for the small test nets (s)\>\"", ",", " ", 
      "trainSeconds"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tnLogSave", "[", "logFile", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Put", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Tests\>\"", " ", "->", " ", "T"}], ",", " ", 
