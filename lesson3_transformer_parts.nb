            RowBox[{"10", "^", 
             RowBox[{"-", "4"}]}]}], "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<the decoder is causal: output i does not change when \
later output positions change\>\"", ",", "\n", "    ", 
