              RowBox[{"t", "[", 
               RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", "0.91"}], "]"}],
             " ", "<", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}]}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
