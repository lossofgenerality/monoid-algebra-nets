      RowBox[{
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<idx\>\"", " ", "->", " ", 
          RowBox[{"SequenceIndicesLayer", "[", "]"}]}], ",", " ", 
         RowBox[{"\"\<pos\>\"", " ", "->", " ", 
          RowBox[{"ElementwiseLayer", "[", 
           RowBox[{
            RowBox[{"#", " ", "-", " ", "1."}], " ", "&"}], "]"}]}], ",", " ", 
         RowBox[{"\"\<col\>\"", " ", "->", " ", 
          RowBox[{"ReplicateLayer", "[", 
           RowBox[{"1", ",", " ", "2"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<angle\>\"", " ", "->", " ", 
          RowBox[{"NetMapOperator", "[", 
