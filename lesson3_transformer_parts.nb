            RowBox[{"4", ",", " ", "d"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"mem", " ", "=", " ", 
         RowBox[{"enc", "[", "x", "]"}]}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
