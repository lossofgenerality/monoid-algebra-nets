       RowBox[{
        RowBox[{
        "atSection", 
         "[", "\"\<7. Residual connection and layer normalisation\>\"", "]"}],
         ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<Each sub-layer (attention or feed-forward) is wrapped in a \
residual connection and followed by layer normalisation (Section 3.1). The \
residual lets the signal and its gradient pass straight through; the \
normalisation keeps every position's vector at mean 0 and variance 1 before a \
learned scale and shift.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "atFormula", 
         "[", "\"\<output = LayerNorm(x + Sublayer(x))\nLayerNorm(v) = \
\[Gamma] (v \[Minus] mean v)/\[Sqrt](var v + \[Epsilon]) + \[Beta]\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{"ln", " ", "=", " ", 
         RowBox[{"NetInitialize", "[", 
          RowBox[{"NormalizationLayer", "[", 
           RowBox[{"2", ",", " ", "2", ",", " ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "8"}], "}"}]}]}], "]"}], "]"}]}], ";", 
        "\n", "   ", 
        RowBox[{"ln", " ", "=", " ", 
         RowBox[{"NetReplacePart", "[", 
          RowBox[{"ln", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Scaling\>\"", " ", "->", " ", 
              RowBox[{"RandomReal", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0.5", ",", " ", "1.5"}], "}"}], ",", " ", "8"}], 
               "]"}]}], ",", " ", 
             RowBox[{"\"\<Biases\>\"", " ", "->", " ", 
              RowBox[{"RandomReal", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}], ",", " ", 
                "8"}], "]"}]}]}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"5", ",", " ", "8"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"atCheck", "[", 
         RowBox[{
          
          RowBox[{"\"\<NormalizationLayer[2, 2] is LayerNorm over each \
position's features, with \[Epsilon] = \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"ln", ",", " ", "\"\<Epsilon\>\""}], "]"}], "]"}]}], ",",
           "\n", "    ", 
          RowBox[{"atClose", "[", 
           RowBox[{
            RowBox[{"ln", "[", "x", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"atLN", "[", 
              RowBox[{"ln", ",", " ", 
               RowBox[{"{", "}"}]}], "]"}], "[", "x", "]"}], ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "4"}]}]}], "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<The paper places the normalisation after the residual sum \
(post-norm). Many later transformers place it before the sub-layer \
(pre-norm), which is easier to train when there are many layers; the lessons \
follow the paper.\>\"", "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
