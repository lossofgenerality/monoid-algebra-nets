          ",", " ", "x", ",", " ", "m"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"atSection", "[", "\"\<4. Multi-head attention\>\"", "]"}], ";",
         "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<One attention with dmodel-dimensional queries is replaced \
by h attentions with dk = dmodel/h dimensions each, on different learned \
projections; their outputs are joined and projected again. The total cost is \
about that of one full-size attention, but each head can attend to different \
things (Section 3.2.2).\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "atFormula", 
         "[", "\"\<MultiHead(Q, K, V) = Concat(head_1, \[Ellipsis], head_h) \
W^O\nhead_i = Attention(Q W_i^Q, K W_i^K, V W_i^V)\>\"", "]"}], ";", "\n", 
        "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<As a Wolfram net, built from primitive layers: LinearLayer \
for the projections (all heads at once), ReshapeLayer to split dmodel \
features into h groups of dk, AttentionLayer with \\\"MultiHead\\\" -> True \
for the h scaled dot-product attentions, FlattenLayer to join the heads, and \
a last LinearLayer for W^O.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"net", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"atMHANet", "[", 
           RowBox[{"d", ",", " ", "h"}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"atShow", "[", 
