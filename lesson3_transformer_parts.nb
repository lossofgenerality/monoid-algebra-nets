   RowBox[{
    RowBox[{
     RowBox[{"atPart2", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dk", " ", "=", " ", "64"}], ",", " ", "q", ",", " ", "k", ",",
          " ", "dots", ",", " ", "sat", ",", " ", "unscaled", ",", " ", 
         "scaled"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
        "atSection", "[", "\"\<2. Why the scores are divided by \[Sqrt]dk\>\"",
          "]"}], ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<If the components of q and k are independent with mean 0 \
and variance 1, their dot product has mean 0 and variance dk (footnote 4 of \
the paper). For dk = 64 the scores are then about \[PlusMinus]8, the softmax \
is close to one-hot, and its gradients are tiny. Dividing by \[Sqrt]dk brings \
the variance back to 1.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"20000", ",", " ", "dk"}], "}"}]}], "]"}]}], ";", " ", 
        RowBox[{"k", " ", "=", " ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"20000", ",", " ", "dk"}], "}"}]}], "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"dots", " ", "=", " ", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"q", " ", "k"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"sat", "[", "scale_", "]"}], " ", ":=", " ", 
         RowBox[{"Mean", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Max", "@", 
             RowBox[{"atSoftmaxRows", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{
                   RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "dk"}],
                   "]"}], " ", ".", " ", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"10", ",", " ", "dk"}], "}"}]}], "]"}], "]"}]}], "/",
                 "scale"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"{", "2000", "}"}]}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"unscaled", " ", "=", " ", 
         RowBox[{"sat", "[", "1.", "]"}]}], ";", " ", 
        RowBox[{"scaled", " ", "=", " ", 
         RowBox[{"sat", "[", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"N", "@", "dk"}], "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"atShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<\>\"", ",", 
               " ", "\"\<variance of q\[CenterDot]k\>\"", ",", 
               " ", "\"\<mean largest softmax weight (10 keys)\>\""}], "}"}], 
             ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"\"\<unscaled\>\"", ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"Variance", "[", "dots", "]"}], ",", " ", "3"}], 
                "]"}], ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"unscaled", ",", " ", "3"}], "]"}]}], "}"}], ",", 
             "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"\"\<divided by \[Sqrt]64\>\"", ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"Variance", "[", 
                  RowBox[{"dots", "/", "8."}], "]"}], ",", " ", "3"}], "]"}], 
               ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"scaled", ",", " ", "3"}], "]"}]}], "}"}]}], "}"}], ",",
            " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{
          
          RowBox[{"\"\<the variance of q\[CenterDot]k is about dk = 64 \
(measured \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"Variance", "[", "dots", "]"}], ",", " ", "3"}], "]"}], 
            "]"}], " ", "<>", " ", "\"\<)\>\""}], ",", " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Variance", "[", "dots", "]"}], "/", "64"}], " ", "-", 
             " ", "1"}], "]"}], " ", "<", " ", "0.05"}]}], "]"}], ";", "\n", 
        "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<after dividing by \[Sqrt]dk it is about 1\>\"", ",", 
          " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Variance", "[", 
              RowBox[{"dots", "/", "8."}], "]"}], " ", "-", " ", "1"}], "]"}],
            " ", "<", " ", "0.05"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
