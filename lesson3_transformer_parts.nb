             RowBox[{"LearningRateMultipliers", " ", "->", " ", "0"}]}], 
            "]"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<sin\>\"", " ", "->", " ", 
          RowBox[{"ElementwiseLayer", "[", "Sin", "]"}]}], ",", " ", 
         RowBox[{"\"\<add\>\"", " ", "->", " ", 
          RowBox[{"TotalLayer", "[", "]"}]}]}], "|>"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], " ", "->", " ", 
          RowBox[{"\"\<idx\>\"", " ", "->", " ", 
           RowBox[{"\"\<pos\>\"", " ", "->", " ", 
            RowBox[{"\"\<col\>\"", " ", "->", " ", 
