          RowBox[{"--", " ", "11."}]}]}]}]}], " ", "The", " ", "learning"}], "-", 
     RowBox[{"rate", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"schedule", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atRate", "[", 
      RowBox[{
       RowBox[{"step_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"d_", " ", ":", " ", "512"}], ",", " ", 
       RowBox[{"warmup_", " ", ":", " ", "4000"}]}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"d", "^", 
       RowBox[{"-", "0.5"}]}], " ", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"step", "^", 
         RowBox[{"-", "0.5"}]}], ",", " ", 
        RowBox[{"step", " ", 
         RowBox[{"warmup", "^", 
          RowBox[{"-", "1.5"}]}]}]}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atPart11", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
        "atSection", "[", "\"\<11. The warm-up learning-rate schedule\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<Adam with \[Beta]\:2081 = 0.9, \[Beta]\:2082 = 0.98, \
\[Epsilon] = 10\:207b\:2079. The rate rises linearly for the first 4000 \
steps, then falls as 1/\[Sqrt]step (Section 5.3). The warm-up protects the \
young network from large, badly-aimed steps.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "atFormula", 
         "[", "\"\<lrate = dmodel^(\[Minus]0.5) \[CenterDot] min(step^(\
\[Minus]0.5), step \[CenterDot] warmup^(\[Minus]1.5)),     warmup = 4000\>\"",
          "]"}], ";", "\n", "   ", 
        RowBox[{"atShow", "[", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"atRate", "[", "s", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "1", ",", " ", "40000"}], "}"}], ",", " ", 
           
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<training step\>\"", ",", 
              " ", "\"\<learning rate\>\""}], "}"}]}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<the peak is at step 4000, at 1/\[Sqrt](512 \[Times] \
4000) \[TildeTilde] 7.0\[Times]10\:207b\:2074\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"atRate", "[", "4000", "]"}], " ", "-", " ", 
              RowBox[{"1", "/", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"512.", " ", "4000"}], "]"}]}]}], "]"}], " ", "<", 
            " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"atRate", "[", "3999", "]"}], " ", "<", " ", 
            RowBox[{"atRate", "[", "4000", "]"}]}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"atRate", "[", "4001", "]"}], " ", "<", " ", 
            RowBox[{"atRate", "[", "4000", "]"}]}]}]}], "]"}], ";", "\n", 
        "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<In Wolfram: NetTrain[\[Ellipsis], Method -> {\\\"ADAM\\\", \
\\\"Beta1\\\" -> 0.9, \\\"Beta2\\\" -> 0.98, \\\"LearningRate\\\" -> peak, \\\
\"LearningRateSchedule\\\" -> (atRate[#] / peak &)}]. The schedule is a \
factor of the learning rate, so the learning rate is set to the peak. (The \
ADAM \[Epsilon] of 10\:207b\:2079 made training collapse in the demo nets, so \
they keep Wolfram's default.)\>\"", "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "12."}]}]}]}]}], " ", "Beam", " ", "search", " ", 
     "with", " ", "a", " ", "length", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"penalty", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Log", "-", 
      RowBox[{
      "probabilities", " ", "only", " ", "fall", " ", "as", " ", "a", " ", 
       "hypothesis", " ", "grows"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "so", " ", "plain", " ", "beam", " ", "search", " ", "prefers", " ", 
       "short", " ", 
       RowBox[{"outputs", ".", "\n", "   ", "The"}], " ", "paper", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"following", " ", "Wu", " ", "et", " ", 
          RowBox[{"al", "."}]}], ",", " ", "2016"}], ")"}], " ", "divides", " ",
        "by", " ", "lp", 
       RowBox[{"(", "Y", ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"5", " ", "+"}], " ", "|", "Y", "|"}], ")"}], "/", "6"}], 
        ")"}], "^", "alpha"}]}], ",", " ", 
     RowBox[{"alpha", " ", "=", " ", "0.6"}], ",", " ", 
     RowBox[{"beam", " ", "4."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atLP", "[", 
      RowBox[{"len_", ",", " ", 
       RowBox[{"alpha_", " ", ":", " ", "0.6"}]}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"5", " ", "+", " ", "len"}], ")"}], "/", "6."}], ")"}], "^", 
      "alpha"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atRank", "[", 
      RowBox[{"hyps_List", ",", " ", "alpha_"}], "]"}], " ", ":=", " ", 
     RowBox[{"SortBy", "[", 
      RowBox[{"hyps", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "/", 
         RowBox[{"atLP", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", " ", "alpha"}], "]"}]}], " ",
         "&"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atPart12", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"hyps", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<short\>\"", ",", " ", 
             RowBox[{"-", "2.0"}], ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<long\>\"", ",", " ", 
             RowBox[{"-", "2.6"}], ",", " ", "8"}], "}"}]}], "}"}]}], "}"}], ",",
        "\n", "   ", 
       RowBox[{
        RowBox[{
        "atSection", "[", "\"\<12. Beam search with a length penalty\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<The log-probability of a hypothesis only falls as it \
grows, so plain beam search prefers short outputs. The paper uses beam size 4 \
and divides each finished hypothesis's log-probability by a length penalty \
with \[Alpha] = 0.6 (Section 6.1, from Wu et al. 2016). The beam itself is \
the one from Lesson 1.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "atFormula", 
         "[", "\"\<score(Y) = log P(Y | X) / lp(Y),     lp(Y) = ((5 + |Y|) / \
6)^\[Alpha]\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"atShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "/", 
                    RowBox[{"atLP", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", " ", "0"}], "]"}]}], 
                   ",", " ", "3"}], "]"}], ",", " ", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "/", 
                    RowBox[{"atLP", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", " ", "0.6"}], 
                    "]"}]}], ",", " ", "3"}], "]"}]}], "}"}], " ", "&"}], " ",
               "/@", " ", "hyps"}], ",", "\n", "      ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<hypothesis\>\"", ",", " ", "\"\<log P\>\"", ",", 
               " ", "\"\<length\>\"", ",", " ", "\"\<score, \[Alpha] = 0\>\"",
                ",", " ", "\"\<score, \[Alpha] = 0.6\>\""}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"None", ",", " ", 
              RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<without the penalty the short hypothesis wins; with \
\[Alpha] = 0.6 the long, slightly less likely one does\>\"", ",", "\n", 
          "    ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"atRank", "[", 
              RowBox[{"hyps", ",", " ", "0"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "==", 
            " ", "\"\<short\>\""}], " ", "&&", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"atRank", "[", 
              RowBox[{"hyps", ",", " ", "0.6"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "==", 
            " ", "\"\<long\>\""}]}]}], "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "13."}]}]}]}]}], " ", "The", " ", "parameter", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"count", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atLayerParams", "[", 
      RowBox[{"d_", ",", " ", "dff_"}], "]"}], " ", ":=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<MHA\>\"", " ", "->", " ", 
        RowBox[{"atMHAParams", "[", "d", "]"}]}], ",", " ", 
       RowBox[{"\"\<FFN\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"d", " ", "dff"}], " ", "+", " ", "dff", " ", "+", " ", 
         RowBox[{"dff", " ", "d"}], " ", "+", " ", "d"}]}], ",", " ", 
       RowBox[{"\"\<LN\>\"", " ", "->", " ", 
        RowBox[{"2", " ", "d"}]}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atBaseParams", "[", 
      RowBox[{
       RowBox[{"V_", " ", ":", " ", "37000"}], ",", " ", 
       RowBox[{"d_", " ", ":", " ", "512"}], ",", " ", 
       RowBox[{"dff_", " ", ":", " ", "2048"}], ",", " ", 
       RowBox[{"n_", " ", ":", " ", "6"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"atLayerParams", "[", 
          RowBox[{"d", ",", " ", "dff"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<shared embedding / pre-softmax \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "V", "]"}], " ", "<>", 
           " ", "\"\< \[Times] \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "d", "]"}]}], " ", "->", " ", 
          RowBox[{"V", " ", "d"}]}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"\"\<encoder: \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "n", "]"}], " ", "<>", 
           " ", "\"\< \[Times] (attention + FFN + 2 LayerNorm)\>\""}], " ", "->",
           " ", 
          RowBox[{"n", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p", "[", "\"\<MHA\>\"", "]"}], " ", "+", " ", 
             RowBox[{"p", "[", "\"\<FFN\>\"", "]"}], " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"p", "[", "\"\<LN\>\"", "]"}]}]}], ")"}]}]}], ",", "\n",
          "    ", 
         RowBox[{
          RowBox[{"\"\<decoder: \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "n", "]"}], " ", "<>", 
           " ", "\"\< \[Times] (2 attentions + FFN + 3 LayerNorm)\>\""}], " ",
           "->", " ", 
          RowBox[{"n", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"p", "[", "\"\<MHA\>\"", "]"}]}], " ", "+", " ", 
             RowBox[{"p", "[", "\"\<FFN\>\"", "]"}], " ", "+", " ", 
             RowBox[{"3", " ", 
              RowBox[{"p", "[", "\"\<LN\>\"", "]"}]}]}], ")"}]}]}], ",", "\n",
          "    ", 
         RowBox[{"\"\<softmax biases\>\"", " ", "->", " ", "V"}]}], "|>"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atPart13", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"atBaseParams", "[", "]"}]}], ",", " ", "enc", ",", " ", 
         "dec"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
        "atSection", "[", "\"\<13. The parameter count of the base model\>\"",
          "]"}], ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<Counted from the parts above, for dmodel = 512, dff = \
2048, h = 8, 6 encoder and 6 decoder layers, and the shared vocabulary of \
about 37,000 tokens (Section 5.1):\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"atShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"KeyValueMap", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#1", ",", " ", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{"#2", ",", " ", 
                    RowBox[{"DigitBlock", " ", "->", " ", "3"}]}], "]"}]}], 
                 "}"}], " ", "&"}], ",", " ", "p"}], "]"}], ",", "\n", 
             "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<total\>\"", ",", " ", "Bold"}], "]"}], ",", " ", 
               
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"Total", "[", "p", "]"}], ",", " ", 
                   RowBox[{"DigitBlock", " ", "->", " ", "3"}]}], "]"}], ",", 
                 " ", "Bold"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Alignment", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"Left", ",", " ", "Right"}], "}"}], "}"}]}]}], "]"}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"enc", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"atEncoderLayerNet", "[", 
           RowBox[{"16", ",", " ", "4", ",", " ", "32"}], "]"}]}]}], ";", " ", 
        RowBox[{"dec", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"atDecoderLayerNet", "[", 
           RowBox[{"16", ",", " ", "4", ",", " ", "32"}], "]"}]}]}], ";", 
        "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<the per-layer formulas agree with Wolfram's counts for \
small encoder and decoder layers\>\"", ",", "\n", "    ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"q", " ", "=", " ", 
              RowBox[{"atLayerParams", "[", 
               RowBox[{"16", ",", " ", "32"}], "]"}]}], "}"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Information", "[", 
               RowBox[{"enc", ",", " ", "\"\<ArraysTotalElementCount\>\""}], 
               "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"q", "[", "\"\<MHA\>\"", "]"}], " ", "+", " ", 
               RowBox[{"q", "[", "\"\<FFN\>\"", "]"}], " ", "+", " ", 
               RowBox[{"2", " ", 
                RowBox[{"q", "[", "\"\<LN\>\"", "]"}]}]}]}], " ", "&&", "\n", 
             "      ", 
             RowBox[{
              RowBox[{"Information", "[", 
               RowBox[{"dec", ",", " ", "\"\<ArraysTotalElementCount\>\""}], 
               "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"2", " ", 
                RowBox[{"q", "[", "\"\<MHA\>\"", "]"}]}], " ", "+", " ", 
               RowBox[{"q", "[", "\"\<FFN\>\"", "]"}], " ", "+", " ", 
               RowBox[{"3", " ", 
                RowBox[{"q", "[", "\"\<LN\>\"", "]"}]}]}]}]}]}], "]"}]}], 
         "]"}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{
          RowBox[{"\"\<the total, \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"Total", "[", "p", "]"}], ",", " ", 
              RowBox[{"DigitBlock", " ", "->", " ", "3"}]}], "]"}], "]"}], 
           " ", "<>", 
           " ", "\"\<, is within 5% of the 65M given in the paper's Table 3; \
the exact figure depends on the vocabulary and on what is counted\>\""}], ",",
           "\n", "    ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Total", "[", "p", "]"}], "/", "65*^6"}], " ", "-", " ",
              "1"}], "]"}], " ", "<", " ", "0.05"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", " ", "Running"}]}]}]}]}], " ", "the", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lesson", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atRun", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Quiet", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2017", "]"}], ";", " ", 
       RowBox[{"atReset", "[", "]"}], ";", "\n", "   ", 
       RowBox[{
       "atText", 
        "[", "\"\<Paper: A. Vaswani et al., Attention Is All You Need, \
NeurIPS 2017, arXiv:1706.03762. Every part is coded from plain arrays and as \
a Wolfram net built from primitive layers, and the two are checked against \
each other. The trained demo net for this paper is in \
ref3_transformer_vaswani2017.nb; Lesson 4 assembles these parts into a \
tensor-algebra transformer.\>\"", "]"}], ";", "\n", "   ", 
       RowBox[{"atPart1", "[", "]"}], ";", " ", 
       RowBox[{"atPart2", "[", "]"}], ";", " ", 
       RowBox[{"atPart3", "[", "]"}], ";", " ", 
       RowBox[{"atPart4", "[", "]"}], ";", " ", 
       RowBox[{"atPart5", "[", "]"}], ";", " ", 
       RowBox[{"atPart6", "[", "]"}], ";", " ", 
       RowBox[{"atPart7", "[", "]"}], ";", " ", 
       RowBox[{"atPart8", "[", "]"}], ";", " ", 
       RowBox[{"atPart9", "[", "]"}], ";", " ", 
       RowBox[{"atPart10", "[", "]"}], ";", " ", 
       RowBox[{"atPart11", "[", "]"}], ";", " ", 
       RowBox[{"atPart12", "[", "]"}], ";", " ", 
       RowBox[{"atPart13", "[", "]"}], ";", "\n", "   ", 
       RowBox[{
       "atSection", "[", "\"\<Where this is used in TensorNets\>\"", "]"}], ";",
        "\n", "   ", 
       RowBox[{
       "atText", 
        "[", "\"\<tnParserNet, tnPolicyNet and tnValueNet are all built from \
these parts: tnParserNet is a full encoder\[Dash]decoder, tnPolicyNet and \
tnValueNet are encoders with small heads on top.\>\"", "]"}], ";", "\n", 
       "   ", 
       RowBox[{"atSaveLog", "[", "]"}], ";", "\n", "   ", 
       RowBox[{"atAllPassQ", " ", "=", " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Values", "[", "atResults", "]"}], ",", " ", "TrueQ"}], 
         "]"}]}], ";"}], "]"}]}], ";"}], "\n", "\n", 
