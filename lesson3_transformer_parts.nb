     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"smoothing", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"With", " ", "epsilon"}], " ", "=", " ", 
      RowBox[{"0.1", " ", "and", " ", "K", " ", "classes"}]}], ",", " ", 
     RowBox[{
      RowBox[{"the", " ", "target", " ", "is", " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "epsilon"}], ")"}], " ", "on", " ", "the",
        " ", "right", " ", "class", " ", "plus", " ", 
       RowBox[{"epsilon", "/", "K"}], "\n", "   ", "spread", " ", "over", " ",
        "all", " ", 
       RowBox[{"classes", ".", " ", "The"}], " ", "cross"}], "-", 
      RowBox[{
      "entropy", " ", "against", " ", "it", " ", "is", " ", "smallest", " ", 
       "when", " ", "the", " ", "model", " ", "predicts", "\n", "   ", 
       "exactly", " ", "that", " ", "smoothed", " ", "target"}]}], ",", " ", 
     RowBox[{
      RowBox[{"not", " ", "a", " ", "one"}], "-", 
      RowBox[{"hot", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atSmooth", "[", 
      RowBox[{"k_Integer", ",", " ", "K_Integer", ",", " ", 
       RowBox[{"eps_", " ", ":", " ", "0.1"}]}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"eps", "/", "K"}], ",", " ", "K"}], "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "eps"}], ")"}], " ", 
       RowBox[{"UnitVector", "[", 
        RowBox[{"K", ",", " ", "k"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atCrossEntropy", "[", 
      RowBox[{"target_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"-", 
      RowBox[{"target", " ", ".", " ", 
       RowBox[{"Log", "[", "p", "]"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"atPart10", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"K", " ", "=", " ", "10"}], ",", " ", "t", ",", " ", 
         "confident", ",", " ", "smoothed", ",", " ", "sure"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"atSection", "[", "\"\<10. Label smoothing\>\"", "]"}], ";", 
        "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<The training target is not one-hot: with \[Epsilon] = 0.1 \
and K classes it puts (1\[Minus]\[Epsilon]) + \[Epsilon]/K on the right class \
and \[Epsilon]/K on each of the others. The model learns to be less sure; the \
paper reports that this hurts perplexity but improves accuracy and BLEU \
(Section 5.4).\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "atFormula", 
         "[", "\"\<q = (1\[Minus]\[Epsilon]) onehot(y) + \[Epsilon]/K ,     \
loss = \[Minus]\[CapitalSigma] q log p\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"t", " ", "=", " ", 
         RowBox[{"atSmooth", "[", 
          RowBox[{"3", ",", " ", "K"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"smoothed", " ", "=", " ", "t"}], ";", " ", 
        RowBox[{"confident", " ", "=", " ", 
         RowBox[{
          RowBox[{"0.999", " ", 
           RowBox[{"UnitVector", "[", 
            RowBox[{"K", ",", " ", "3"}], "]"}]}], " ", "+", " ", 
          RowBox[{"0.001", "/", "K"}]}]}], ";", "\n", "   ", 
        RowBox[{"sure", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"atCrossEntropy", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", "s"}], ")"}], " ", 
               RowBox[{"UnitVector", "[", 
                RowBox[{"K", ",", " ", "3"}], "]"}]}], " ", "+", " ", 
              RowBox[{"s", "/", "K"}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", 
             RowBox[{"{", 
              RowBox[{
              "0.001", ",", " ", "0.05", ",", " ", "0.1", ",", " ", "0.2", ",",
                " ", "0.5"}], "}"}]}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"atShow", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<probability on the right class\>\"", ",", " ", 
               RowBox[{"Sequence", " ", "@@", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"1", " ", "-", " ", "#", " ", "+", " ", 
                    RowBox[{"#", "/", "K"}]}], ",", " ", "3"}], "]"}], " ", 
                   "&"}], " ", "/@", " ", 
                  RowBox[{"{", 
                   RowBox[{
                   "0.001", ",", " ", "0.05", ",", " ", "0.1", ",", " ", 
                    "0.2", ",", " ", "0.5"}], "}"}]}], ")"}]}]}], "}"}], ",", 
             "\n", "      ", 
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], " ", "/@", 
                " ", "sure"}], ",", " ", "\"\<smoothed loss\>\""}], "]"}]}], 
            "}"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"Background", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "LightGray", "}"}], ",", " ", "None"}], "}"}]}]}], 
          "]"}], "]"}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<the smoothed target sums to 1 and gives 0.91 to the \
right class\>\"", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Total", "[", "t", "]"}], " ", "-", " ", "1"}], "]"}], 
            " ", "<", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
