   RowBox[{
    RowBox[{
     RowBox[{"atPart8", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", "16"}], ",", " ", 
         RowBox[{"h", " ", "=", " ", "4"}], ",", " ", 
         RowBox[{"dff", " ", "=", " ", "32"}], ",", " ", "enc", ",", " ", 
         "dec", ",", " ", "x", ",", " ", "y", ",", " ", "mem"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{
        "atSection", "[", "\"\<8. One encoder layer and one decoder layer\>\"",
          "]"}], ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<An encoder layer is self-attention, then the feed-forward \
network, each wrapped as LayerNorm(x + Sublayer(x)). A decoder layer has \
three sub-layers: causal self-attention over the output so far, attention \
over the encoder's output (queries from the decoder, keys and values from the \
encoder), and the feed-forward network. The base model stacks 6 of each \
(Section 3.1).\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"enc", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"atEncoderLayerNet", "[", 
           RowBox[{"d", ",", " ", "h", ",", " ", "dff"}], "]"}]}]}], ";", 
        "\n", "   ", 
        RowBox[{"dec", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"atDecoderLayerNet", "[", 
           RowBox[{"d", ",", " ", "h", ",", " ", "dff"}], "]"}]}]}], ";", 
        "\n", "   ", 
        RowBox[{"atShow", "[", 
         RowBox[{"Information", "[", 
          RowBox[{"dec", ",", " ", "\"\<SummaryGraphic\>\""}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"RandomReal", "[", 
