            RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], ",", 
            " ", "\"\<sin\>\""}], "}"}], " ", "->", " ", "\"\<add\>\""}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"\"\<Input\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Varying\>\"", ",", " ", "d"}], "}"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
