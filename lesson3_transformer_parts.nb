             RowBox[{"atEncoderLayer", "[", 
              RowBox[{"enc", ",", " ", "h"}], "]"}], "[", "x", "]"}], ",", 
            " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "4"}]}]}], "]"}]}], "]"}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
