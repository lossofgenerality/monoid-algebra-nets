             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"7", ",", " ", "d"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
        
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<the net built from primitive layers equals multi-head \
attention coded from arrays (d = 16, h = 4)\>\"", ",", "\n", "    ", 
          RowBox[{"atClose", "[", 
