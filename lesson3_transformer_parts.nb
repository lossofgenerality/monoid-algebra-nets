          RowBox[{"atPE", "[", 
           RowBox[{"100", ",", " ", "64"}], "]"}]}], ",", " ", "net", ",", 
         " ", "x", ",", " ", "dots"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"atSection", "[", "\"\<5. Positional encoding\>\"", "]"}], ";",
         "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<Attention by itself ignores word order, so a position code \
is added to each embedding (Section 3.5). Each pair of components is a sine \
and a cosine of the position, with wavelengths from 2\[Pi] to 10000\
\[CenterDot]2\[Pi].\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "atFormula", 
         "[", "\"\<PE(pos, 2i) = sin(pos / 10000^(2i/dmodel))      PE(pos, \
2i+1) = cos(pos / 10000^(2i/dmodel))\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"atShow", "[", 
         RowBox[{"ArrayPlot", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "pe", "]"}], ",", " ", 
           RowBox[{"ColorFunction", " ", "->", " ", "\"\<RedBlueTones\>\""}], 
           ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<dimension\>\"", ",", " ", "\"\<position\>\""}], 
             "}"}]}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", " ", 
           RowBox[{"AspectRatio", " ", "->", " ", "0.5"}]}], "]"}], "]"}], ";",
         "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<for every offset k there is one fixed matrix M\:2096 (a \
rotation in each pair of components) with PE(pos + k) = M\:2096 PE(pos) for \
all positions: the reason the paper gives for choosing sinusoids\>\"", ",", 
          "\n", "    ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "5", ",", " ", "17"}], "}"}], ",", " ", 
            RowBox[{"Function", "[", 
             RowBox[{"k", ",", " ", 
              RowBox[{"atClose", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{"atShiftMatrix", "[", 
