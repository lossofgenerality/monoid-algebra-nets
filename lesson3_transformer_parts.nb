   RowBox[{
    RowBox[{
     RowBox[{"atPart9", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", "8"}], ",", " ", 
         RowBox[{"V", " ", "=", " ", "20"}], ",", " ", "net"}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{
        "atSection", 
         "[", "\"\<9. Shared embeddings, multiplied by \[Sqrt]dmodel\>\"", 
         "]"}], ";", "\n", "   ", 
        RowBox[{
        "atText", 
         "[", "\"\<The paper uses one weight matrix for the input embedding, \
the output embedding and the projection before the softmax, and multiplies \
the embeddings by \[Sqrt]dmodel (Section 3.4). In Wolfram the sharing is \
NetSharedArray: EmbeddingLayer stores a V\[Times]d matrix, and LinearLayer[V] \
on d-dimensional inputs stores a V\[Times]d matrix as well, so one array \
serves both.\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{
        "atFormula", 
         "[", "\"\<EmbeddingLayer[d, V, \\\"Weights\\\" -> \
NetSharedArray[\\\"W\\\"]]   \[Ellipsis]   LinearLayer[V, \\\"Weights\\\" -> \
NetSharedArray[\\\"W\\\"]]\>\"", "]"}], ";", "\n", "   ", 
        RowBox[{"net", " ", "=", " ", 
         RowBox[{"NetInitialize", "@", 
          RowBox[{"NetGraph", "[", 
           RowBox[{
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<emb\>\"", " ", "->", " ", 
               RowBox[{"EmbeddingLayer", "[", 
                RowBox[{"d", ",", " ", "V", ",", " ", 
                 RowBox[{"\"\<Weights\>\"", " ", "->", " ", 
                  RowBox[{"NetSharedArray", "[", "\"\<W\>\"", "]"}]}]}], 
                "]"}]}], ",", " ", 
              RowBox[{"\"\<scale\>\"", " ", "->", " ", 
               RowBox[{"ElementwiseLayer", "[", 
                RowBox[{
                 RowBox[{"#", " ", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"N", "@", "d"}], "]"}]}], " ", "&"}], "]"}]}], ",",
               "\n", "       ", 
              RowBox[{"\"\<out\>\"", " ", "->", " ", 
               RowBox[{"NetMapOperator", "[", 
                RowBox[{"LinearLayer", "[", 
                 RowBox[{"V", ",", " ", 
                  RowBox[{"\"\<Weights\>\"", " ", "->", " ", 
                   RowBox[{"NetSharedArray", "[", "\"\<W\>\"", "]"}]}]}], 
                 "]"}], "]"}]}]}], "|>"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<emb\>\"", " ", "->", " ", 
              RowBox[{"\"\<scale\>\"", " ", "->", " ", "\"\<out\>\""}]}], 
             "}"}], ",", "\n", "      ", 
            RowBox[{"\"\<Input\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Varying\>\"", ",", " ", 
               RowBox[{"Restricted", "[", 
                RowBox[{"\"\<Integer\>\"", ",", " ", "V"}], "]"}]}], 
              "}"}]}]}], "]"}]}]}], ";", "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{"\"\<the embedding and the output projection are one and the \
same array\>\"", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"net", ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<emb\>\"", ",", " ", "\"\<Weights\>\""}], "}"}]}], 
             "]"}]}], " ", "==", " ", 
           RowBox[{"Normal", "@", 
            RowBox[{"NetExtract", "[", 
             RowBox[{"net", ",", " ", 
              RowBox[{"{", 
               
               RowBox[{"\"\<out\>\"", ",", " ", "\"\<Net\>\"", ",", 
                " ", "\"\<Weights\>\""}], "}"}]}], "]"}]}]}]}], "]"}], ";", 
        "\n", "   ", 
        RowBox[{"atCheck", "[", 
         RowBox[{
          
          RowBox[{"\"\<the net stores that array once: \>\"", " ", "<>", " ", 
           
           RowBox[{"ToString", "[", 
            RowBox[{"V", " ", "d"}], "]"}], " ", "<>", 
           " ", "\"\< shared weights and \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "V", "]"}], " ", "<>", 
           " ", "\"\< output biases\>\""}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Information", "[", 
            RowBox[{"net", ",", " ", "\"\<ArraysTotalElementCount\>\""}], 
            "]"}], " ", "==", " ", 
           RowBox[{
            RowBox[{"V", " ", "d"}], " ", "+", " ", "V"}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
